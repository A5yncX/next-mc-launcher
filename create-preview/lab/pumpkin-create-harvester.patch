+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn saved_tracker_crosses_the_expected_crop_cell() {
+        let anchor = [-266, 80, -108];
+        let tool = [([3, 0, 0], state("north").unwrap())];
+        let mut first = NbtCompound::new();
+        assert!(sample(&tool, anchor, 9.6, None, &mut first).is_empty());
+        let mut second = NbtCompound::new();
+        assert_eq!(
+            sample(&tool, anchor, 19.2, Some(&first), &mut second),
+            [[-263, 80, -109]]
+        );
+        let mut duplicate = NbtCompound::new();
+        assert!(sample(&tool, anchor, 19.2, Some(&second), &mut duplicate).is_empty());
+    }
+
+    #[test]
+    fn withholds_only_the_first_wheat_seed_drop() {
+        let mut harvest = harvester::plan(
+            HarvesterBlock {
+                plant: Plant::Crop {
+                    age: Age {
+                        value: 7,
+                        mature_value: 7,
+                    },
+                    matches_default_zero_state: false,
+                },
+                collision_empty: true,
+                ..Default::default()
+            },
+            Rules::default(),
+        )
+        .unwrap();
+        let mut wheat = ItemStack::new(1, &Item::WHEAT);
+        let mut first_seed = ItemStack::new(1, &Item::WHEAT_SEEDS);
+        let mut next_seed = ItemStack::new(2, &Item::WHEAT_SEEDS);
+
+        withhold_replant_seed(&mut harvest, &mut wheat);
+        withhold_replant_seed(&mut harvest, &mut first_seed);
+        withhold_replant_seed(&mut harvest, &mut next_seed);
+
+        assert_eq!(wheat.item_count, 1);
+        assert_eq!(first_seed.item_count, 0);
+        assert_eq!(next_seed.item_count, 2);
+    }
+}
