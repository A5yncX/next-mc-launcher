+use std::sync::Arc;
+
+use create_engine::{
+    contraption::{
+        Rotation,
+        actors::{
+            MotionState, MotionTracker, Sample, Tool,
+            harvester::{self, Age, Block as HarvesterBlock, Harvest, Plant, Replacement, Rules},
+        },
+    },
+    kinetics::{Axis, Pos},
+    placement::Direction,
+};
+use pumpkin_data::{
+    Block, BlockStateId,
+    block_properties::WheatLikeProperties,
+    item::Item,
+    item_stack::ItemStack,
+    tag::{self, Taggable},
+};
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_world::world::BlockFlags;
+
+use crate::{
+    block::blocks::{
+        create_pipe::with_property,
+        plant::crop::{MAX_AGE, has_sufficient_light},
+    },
+    world::{World, loot::LootContextParameters},
+};
+
+pub(super) const ID: &str = "create:mechanical_harvester";
+const TRACKERS: &str = "NextMcHarvesters";
+
+pub(super) fn facing(id: BlockStateId) -> Option<Direction> {
+    let block = id.to_block();
+    if block.name != ID {
+        return None;
+    }
+    let props = block.properties(id)?.to_props();
+    if !props
+        .iter()
+        .any(|p| p.key().to_str() == "waterlogged" && p.value_str() == "false")
+    {
+        return None;
+    }
+    let face = props
+        .iter()
+        .find(|p| p.key().to_str() == "facing")?
+        .value_str();
+    Direction::ALL
+        .into_iter()
+        .find(|d| d.axis() != Axis::Y && d.name() == face)
+}
+
+pub(super) fn state(face: &str) -> Option<BlockStateId> {
+    let block = Block::from_registry_key(ID)?;
+    let id = with_property(
+        with_property(block.default_state.id, "waterlogged", "false"),
+        "facing",
+        face,
+    );
+    (facing(id)?.name() == face).then_some(id)
+}
+
+pub(super) fn sample(
+    blocks: &[(Pos, BlockStateId)],
+    anchor: Pos,
+    angle: f32,
+    previous: Option<&NbtCompound>,
+    next: &mut NbtCompound,
+) -> Vec<Pos> {
+    let rotation = Rotation::new(anchor, Axis::Y, angle).expect("validated pose");
+    let inverse = Rotation::new([0; 3], Axis::Y, -angle).expect("validated pose");
+    let mut saved = Vec::new();
+    let mut visits = Vec::new();
+    let entries = previous
+        .and_then(|p| p.get_list(TRACKERS))
+        .unwrap_or_default();
+    for &(local, id) in blocks {
+        let Some(face) = facing(id) else { continue };
+        let state = entries.iter().find_map(|entry| {
+            let NbtTag::Compound(entry) = entry else {
+                return None;
+            };
+            if entry.get_int_array("Pos")? != local {
+                return None;
+            }
+            let xyz = |key| match entry.get_list(key)? {
+                [NbtTag::Double(x), NbtTag::Double(y), NbtTag::Double(z)] => Some([*x, *y, *z]),
+                _ => None,
+            };
+            MotionTracker::restore(MotionState {
+                position: Some(xyz("Position")?),
+                motion: xyz("Motion")?,
+                relative_motion: xyz("RelativeMotion")?,
+                first_movement: entry.get_bool("First")?,
+            })
+        });
+        let mut tracker = state.unwrap_or_default();
+        let result = tracker.sample(
+            Sample {
+                position: rotation.to_world(Tool::Harvester.active_point(local, face)),
+                facing: face,
+                stalled: false,
+                disabled: false,
+                allow_stationary_first_visit: false,
+            },
+            |motion| motion,
+            |motion| inverse.rotate_vector(motion),
+        );
+        visits.extend(result.visit);
+        let state = tracker.state();
+        let mut entry = NbtCompound::new();
+        entry.put("Pos", NbtTag::IntArray(local.into()));
+        for (key, values) in [
+            ("Position", state.position.expect("sampled")),
+            ("Motion", state.motion),
+            ("RelativeMotion", state.relative_motion),
+        ] {
+            entry.put_list(key, values.into_iter().map(NbtTag::Double).collect());
+        }
+        entry.put_bool("First", state.first_movement);
+        saved.push(NbtTag::Compound(entry));
+    }
+    if !saved.is_empty() {
+        next.put_list(TRACKERS, saved);
+    }
+    visits
+}
+
+pub(super) fn preserve_trackers(previous: Option<&NbtCompound>, next: &mut NbtCompound) {
+    if let Some(saved) = previous.and_then(|p| p.get_list(TRACKERS)) {
+        next.put_list(TRACKERS, saved.to_vec());
+    }
+}
+
+pub(super) fn harvest_wheat(world: &Arc<World>, pos: BlockPos) {
+    if !world.is_in_build_limit(pos) || world.spawn_protects_position(&pos) {
+        return;
+    }
+    let Some(original_state) = world.get_block_state_id_if_loaded(&pos) else {
+        return;
+    };
+    if original_state.to_block() != &Block::WHEAT {
+        return;
+    }
+    let properties = WheatLikeProperties::from_state_id(original_state);
+    if properties.age != MAX_AGE {
+        return;
+    }
+
+    let soil_pos = pos.down();
+    if !world.is_in_build_limit(soil_pos) {
+        return;
+    }
+    let Some(soil_state) = world.get_block_state_id_if_loaded(&soil_pos) else {
+        return;
+    };
+    let Some(mut harvest) = harvester::plan(
+        HarvesterBlock {
+            plant: Plant::Crop {
+                age: Age {
+                    value: u32::from(properties.age),
+                    mature_value: u32::from(MAX_AGE),
+                },
+                matches_default_zero_state: original_state == Block::WHEAT.default_state.id,
+            },
+            collision_empty: true,
+            ..Default::default()
+        },
+        Rules::default(),
+    ) else {
+        return;
+    };
+    if harvest.replacement != Replacement::ResetCropAge {
+        return;
+    }
+
+    let mut replanted_properties = properties;
+    replanted_properties.age = 0;
+    let replanted_state = if soil_state
+        .to_block()
+        .has_tag(&tag::Block::MINECRAFT_SUPPORTS_CROPS)
+        && has_sufficient_light(world, &pos)
+    {
+        replanted_properties.to_state_id(&Block::WHEAT)
+    } else {
+        Block::AIR.default_state.id
+    };
+    // This exact CAS gates all loot release so concurrent harvest attempts cannot duplicate drops.
+    if world
+        .set_block_state_if(&pos, replanted_state, BlockFlags::NOTIFY_ALL, |current| {
+            current == original_state
+        })
+        .is_none()
+    {
+        return;
+    }
+
+    release_loot(world, pos, original_state, &mut harvest);
+}
+
+fn withhold_replant_seed(harvest: &mut Harvest, stack: &mut ItemStack) {
+    stack.item_count = harvest.accept_drop(
+        stack.item == &Item::WHEAT_SEEDS,
+        u32::from(stack.item_count),
+    ) as u8;
+}
+
+fn release_loot(
+    world: &Arc<World>,
+    pos: BlockPos,
+    original_state: pumpkin_data::BlockStateId,
+    harvest: &mut Harvest,
+) {
+    let block = original_state.to_block();
+    let Some(loot_table) = block.loot_table.and_then(|key| world.get_loot_table(key)) else {
+        return;
+    };
+    let params = LootContextParameters {
+        world: Some(world),
+        tool: Some(ItemStack::EMPTY.clone()),
+        block_state: Some(original_state.to_state()),
+        position: Some(pos.to_f64()),
+        killed_by_player: Some(false),
+        world_time: u64::try_from(world.get_time_of_day()).unwrap_or_default(),
+        ..Default::default()
+    };
+    let mut items = loot_table.generate_loot_with_context(rand::random(), &params);
+    for stack in &mut items {
+        withhold_replant_seed(harvest, stack);
+    }
+    items.retain(|stack| !stack.is_empty());
+    if items.is_empty() {
+        return;
+    }
+
+    let mut event = crate::plugin::block::block_drop_item::BlockDropItemEvent {
+        block_pos: pos,
+        world: world.clone(),
+        player: None,
+        items,
+        cancelled: false,
+    };
+    if let Some(server) = world.server.upgrade() {
+        server.plugin_manager.fire_blocking(&server, &mut event);
+    }
+    if !event.cancelled {
+        for stack in event.items {
+            world.drop_stack(&pos, stack);
+        }
+    }
+}
