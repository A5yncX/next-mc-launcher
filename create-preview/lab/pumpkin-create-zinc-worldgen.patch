     #[test]
+    fn zinc_only_extends_the_overworld_ore_step() {
+        let step = GenerationStep::UndergroundOres.ordinal();
+        let biomes = [Biome::PLAINS.id, Biome::DEEP_DARK.id];
+        let mut selected = select_features(&biomes, step);
