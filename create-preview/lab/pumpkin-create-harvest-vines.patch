+fn cut_replacement(state: BlockStateId) -> BlockStateId {
+    if state.is_waterlogged() || matches!(state.to_block().name, "kelp" | "kelp_plant") {
+        Block::WATER.default_state.id
+    } else {
+        Block::AIR.default_state.id
+    }
 }
 
