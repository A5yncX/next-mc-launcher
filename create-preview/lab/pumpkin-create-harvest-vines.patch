+    #[test]
+    fn growing_plants_resolve_body_items_and_leave_their_fluid() {
+        for (head, body, seed, wet) in [
+            (&Block::KELP, &Block::KELP_PLANT, &Item::KELP, true),
+            (
+                &Block::WEEPING_VINES,
+                &Block::WEEPING_VINES_PLANT,
+                &Item::WEEPING_VINES,
+                false,
+            ),
+            (
+                &Block::TWISTING_VINES,
+                &Block::TWISTING_VINES_PLANT,
+                &Item::TWISTING_VINES,
+                false,
+            ),
+            (
+                &Block::CAVE_VINES,
+                &Block::CAVE_VINES_PLANT,
+                &Item::GLOW_BERRIES,
+                false,
+            ),
+        ] {
+            for block in [head, body] {
+                let state = block.default_state.id;
+                let (cut, item) = crop(state).unwrap();
+                assert_eq!(item.id, seed.id);
+                assert_eq!(cut.replacement, Replacement::FluidOrAir);
+                assert_eq!(
+                    cut_replacement(state),
+                    if wet { &Block::WATER } else { &Block::AIR }
+                        .default_state
+                        .id
+                );
+            }
+            assert!(
+                crop(with_property(head.default_state.id, "age", "25"))
+                    .unwrap()
+                    .0
+                    .reserve_seed
+            );
+        }
