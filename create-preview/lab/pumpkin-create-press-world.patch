     pub const fn get_item_stack(&self) -> &Mutex<ItemStack> {
         &self.item_stack
+    }
+
+    pub(crate) fn apply_create_press(
+        &self,
+        result: impl FnOnce(&ItemStack) -> Option<&'static pumpkin_data::item::Item>,
+    ) {
+        let mut stack = self
+            .item_stack
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !self.entity.is_alive() || !self.entity.on_ground.load(Relaxed) {
+            return;
+        }
+        let Some(result) = result(&stack) else { return };
+        let output = ItemStack::new(1, result);
+        let split = stack.item_count > 1;
+        if split {
+            stack.item_count -= 1;
+        } else {
+            *stack = output.clone();
+            Self::update_fire_immune(&self.entity, &stack);
+        }
+        drop(stack);
+        self.on_count_changed();
+        if split {
+            let world = self.entity.world.load_full();
+            let entity = Entity::new(world.clone(), self.entity.pos.load(), &EntityType::ITEM);
+            world.spawn_entity(Arc::new(Self::new_with_velocity(
+                entity,
+                output,
+                self.entity.velocity.load(),
+                0,
+            )));
+        }
     }
 
