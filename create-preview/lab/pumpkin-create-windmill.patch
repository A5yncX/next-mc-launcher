+pub(super) fn windmill_rpm(world: &World, controller: BlockPos) -> f32 {
+    let capacity = world
+        .level
+        .read_chunk_sync(&controller.chunk_and_chunk_relative_position().0, |chunk| {
+            let Some(NbtTag::Compound(scene)) = chunk.get_custom_data(NAMESPACE, SCENE) else {
+                return None;
+            };
+            generation(&scene)?;
+            let geo = owned_entry(&scene, GEOMETRY, coords(controller))?;
+            (geo.get_bool("ReturnHome") == Some(true)).then_some(())?;
+            usize::try_from(geo.get_int("WindmillSails")?)
+                .ok()
+                .filter(|&sails| (8..=MAX_WINDMILL_BLOCKS).contains(&sails))
+        })
+        .flatten();
+    capacity.map_or(0.0, |sails| {
+        Config::default().rpm(sails, RotationDirection::Clockwise)
+    })
+}
