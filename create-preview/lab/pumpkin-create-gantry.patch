diff --git a/crates/pumpkin-core/src/block/blocks/create_gantry.rs b/crates/pumpkin-core/src/block/blocks/create_gantry.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/blocks/create_gantry.rs
@@ -0,0 +1,156 @@
+use std::sync::Arc;
+
+use create_engine::{
+    contraption::gantry,
+    kinetics::Axis,
+    placement::{self, Direction},
+};
+use pumpkin_data::BlockStateId;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_world::world::BlockFlags;
+
+use super::{
+    create_pipe::{boolean, property, with_property},
+    redstone::block_receives_redstone_power,
+};
+use crate::world::World;
+
+pub(crate) const SHAFT: &str = "create:gantry_shaft";
+pub(crate) const CARRIAGE: &str = "create:gantry_carriage";
+const MAX_RAILS: usize = 65;
+
+fn offset(pos: BlockPos, direction: Direction) -> BlockPos {
+    let [x, y, z] = direction.vector();
+    BlockPos::new(pos.0.x + x, pos.0.y + y, pos.0.z + z)
+}
+
+pub(crate) fn state_facing(state: BlockStateId) -> Option<Direction> {
+    let name = property(state, "facing")?;
+    Direction::ALL
+        .into_iter()
+        .find(|facing| facing.name() == name)
+}
+
+fn shaft_facing(world: &World, pos: BlockPos) -> Option<Direction> {
+    let state = world.get_block_state_id_if_loaded(&pos)?;
+    (state.to_block().name == SHAFT)
+        .then(|| state_facing(state))
+        .flatten()
+}
+
+pub(crate) fn carriage_placement(
+    world: &World,
+    pos: BlockPos,
+    state: BlockStateId,
+    face: Direction,
+) -> Option<BlockStateId> {
+    let shaft = shaft_facing(world, offset(pos, face.opposite()))?;
+    let axis = gantry::pinion_axis(face, shaft)?;
+    Some(with_property(
+        with_property(state, "facing", face.name()),
+        "axis_along_first",
+        boolean(axis_along_first(face, axis)),
+    ))
+}
+
+fn axis_along_first(facing: Direction, axis: Axis) -> bool {
+    axis == if facing.axis() == Axis::X {
+        Axis::Y
+    } else {
+        Axis::X
+    }
+}
+
+pub(crate) fn shaft_placement(
+    world: &World,
+    pos: BlockPos,
+    state: BlockStateId,
+    face: Direction,
+    look: Direction,
+    sneaking: bool,
+    ports: [bool; 6],
+) -> BlockStateId {
+    let facing = if sneaking {
+        look
+    } else {
+        placement::preferred(ports).unwrap_or(look).opposite()
+    };
+    let aligned = shaft_facing(world, offset(pos, facing.opposite()))
+        .or_else(|| shaft_facing(world, offset(pos, face.opposite())))
+        .filter(|neighbor| neighbor.axis() == facing.axis())
+        .map_or(facing, |neighbor| {
+            if sneaking {
+                neighbor.opposite()
+            } else {
+                neighbor
+            }
+        });
+    with_property(state, "facing", aligned.name())
+}
+
+pub(crate) fn refresh_rail(world: &Arc<World>, pos: BlockPos) {
+    let Some(old) = world.get_block_state_id_if_loaded(&pos) else {
+        return;
+    };
+    if old.to_block().name != SHAFT {
+        return;
+    }
+    let Some(facing) = state_facing(old) else {
+        return;
+    };
+    let mut powered = block_receives_redstone_power(world, &pos);
+    let mut count = 1;
+    let mut connected = [false; 2];
+    for (i, direction) in [facing, facing.opposite()].into_iter().enumerate() {
+        let mut at = offset(pos, direction);
+        while shaft_facing(world, at) == Some(facing) {
+            count += 1;
+            if count > MAX_RAILS {
+                return;
+            }
+            connected[i] = true;
+            powered |= block_receives_redstone_power(world, &at);
+            at = offset(at, direction);
+        }
+    }
+    let part = match connected {
+        [true, true] => "middle",
+        [true, false] => "start",
+        [false, true] => "end",
+        [false, false] => "single",
+    };
+    let next = with_property(
+        with_property(old, "part", part),
+        "powered",
+        boolean(powered),
+    );
+    if next != old {
+        world.set_block_state_if(
+            &pos,
+            next,
+            BlockFlags::NOTIFY_LISTENERS | BlockFlags::UPDATE_KNOWN_SHAPE,
+            |current| current == old,
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn carriage_bit_matches_the_shared_shaft_axis_for_every_mount() {
+        for mount in Direction::ALL {
+            for rail in Direction::ALL {
+                if let Some(axis) = gantry::pinion_axis(mount, rail) {
+                    assert_eq!(
+                        placement::gauge_axis(mount, axis_along_first(mount, axis)),
+                        axis
+                    );
+                } else {
+                    assert_eq!(mount.axis(), rail.axis());
+                }
+            }
+        }
+    }
+}
