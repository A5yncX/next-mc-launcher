+use std::sync::Arc;
+
+use pumpkin_data::{data_component_impl::EquipmentSlot, item::Item, item_stack::ItemStack};
+use pumpkin_inventory::screen_handler::InventoryPlayer;
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::{GameMode, Hand};
+
+use crate::{
+    block::{
+        BlockActionResult, BlockBehaviour, GetComparatorOutputArgs, PlacedArgs, UseWithItemArgs,
+        entities::create_fluid_tank::CreateFluidTank,
+    },
+    entity::EntityBase,
+};
+
+#[pumpkin_block("create:fluid_tank")]
+pub struct FluidTank;
+
+pub(crate) fn handles_container(stack: &ItemStack) -> bool {
+    !stack.is_empty()
+        && [Item::BUCKET.id, Item::WATER_BUCKET.id, Item::LAVA_BUCKET.id]
+            .contains(&stack.get_item().id)
+}
+
+impl BlockBehaviour for FluidTank {
+    fn placed(&self, args: PlacedArgs<'_>) {
+        if args.world.get_block_entity(args.position).is_none() {
+            args.world
+                .add_block_entity(Arc::new(CreateFluidTank::new(*args.position)));
+        }
+    }
+
+    fn get_comparator_output(&self, args: GetComparatorOutputArgs<'_>) -> Option<u8> {
+        Some(
+            args.world
+                .get_block_entity(args.position)
+                .as_ref()
+                .and_then(|entity| entity.as_any().downcast_ref::<CreateFluidTank>())
+                .map_or(0, CreateFluidTank::signal),
+        )
+    }
+
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        let mode = args.player.gamemode.load();
+        if args.player.get_entity().is_sneaking()
+            || !matches!(
+                mode,
+                GameMode::Survival | GameMode::Creative | GameMode::Adventure
+            )
+            || args
+                .world
+                .is_in_spawn_protection(args.player, args.position)
+        {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        if !handles_container(args.item_stack) {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        let item_id = args.item_stack.get_item().id;
+        let Some(entity) = args.world.get_block_entity(args.position) else {
+            return BlockActionResult::SuccessServer;
+        };
+        let Some(tank) = entity.as_any().downcast_ref::<CreateFluidTank>() else {
+            return BlockActionResult::SuccessServer;
+        };
+
+        let output = match item_id {
+            id if id == Item::WATER_BUCKET.id => {
+                tank.pour("minecraft:water", 1000).then_some(&Item::BUCKET)
+            }
+            id if id == Item::LAVA_BUCKET.id => {
+                tank.pour("minecraft:lava", 1000).then_some(&Item::BUCKET)
+            }
+            id if id == Item::BUCKET.id => tank.take_bucket().map(|fluid| {
+                if fluid == "minecraft:water" {
+                    &Item::WATER_BUCKET
+                } else {
+                    &Item::LAVA_BUCKET
+                }
+            }),
+            _ => return BlockActionResult::PassToDefaultBlockAction,
+        };
+        let Some(output) = output else {
+            return BlockActionResult::SuccessServer;
+        };
+
+        if mode != GameMode::Creative {
+            let mut container = ItemStack::new(1, output);
+            if args.item_stack.item_count == 1 {
+                *args.item_stack = container;
+            } else {
+                args.item_stack.decrement(1);
+                args.player
+                    .get_inventory()
+                    .insert_stack_anywhere(&mut container);
+                if !container.is_empty() {
+                    args.world.drop_stack(args.position, container);
+                }
+            }
+            let hand = if *args.equipment_slot == EquipmentSlot::OFF_HAND {
+                Hand::Left
+            } else {
+                Hand::Right
+            };
+            args.player
+                .get_inventory()
+                .set_stack_in_hand(hand, args.item_stack.clone());
+            args.player.sync_inventory_to_client();
+        }
+        args.world.update_block_entity(&entity);
+        args.world
+            .update_neighbour_for_output_signal(args.position, args.block);
+        BlockActionResult::SuccessServer
+    }
+}
