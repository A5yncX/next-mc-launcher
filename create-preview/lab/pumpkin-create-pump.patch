+++ b/crates/pumpkin-core/src/block/blocks/create_pump.rs
@@ -0,0 +1,135 @@
+use std::sync::Arc;
+
+use create_engine::{
+    fluid_transport,
+    placement::{self, Direction},
+};
+use pumpkin_data::BlockStateId;
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_world::world::BlockFlags;
+
+use crate::{
+    block::{
+        BlockActionResult, BlockBehaviour, UseWithItemArgs,
+        entities::create_fluid_tank::{self as tank, CreateFluidTank},
+        registry::BlockRegistry,
+    },
+    world::World,
+};
+
+pub(crate) const ID: &str = "create:mechanical_pump";
+
+fn front(state: BlockStateId) -> Option<Direction> {
+    let props = state.to_block().properties(state)?.to_props();
+    let facing = props.iter().find(|p| p.key_str() == "facing")?.value_str();
+    Direction::ALL.into_iter().find(|d| d.name() == facing)
+}
+
+fn relative(pos: BlockPos, side: Direction) -> BlockPos {
+    let [x, y, z] = side.vector();
+    BlockPos::new(pos.0.x + x, pos.0.y + y, pos.0.z + z)
+}
+
+pub(crate) fn placement_front(
+    world: &World,
+    pos: BlockPos,
+    look: Direction,
+    sneaking: bool,
+    ports: [bool; 6],
+) -> Direction {
+    if sneaking {
+        return look;
+    }
+    let wanted = look.opposite();
+    let joined = Direction::ALL
+        .into_iter()
+        .rev()
+        .filter(|&side| {
+            world
+                .get_block_state_id_if_loaded(&relative(pos, side))
+                .is_some_and(|state| state.to_block().name == tank::ID)
+        })
+        .min_by_key(|&side| {
+            if side == wanted {
+                0
+            } else if side == look {
+                2
+            } else {
+                1
+            }
+        });
+    joined
+        .filter(|side| side.axis() != wanted.axis())
+        .unwrap_or_else(|| placement::preferred(ports).map_or(wanted, Direction::opposite))
+}
+
+pub(crate) fn tick(world: &Arc<World>, pos: BlockPos, state: BlockStateId, rpm: f32) {
+    if !rpm.is_finite() || rpm == 0.0 {
+        return;
+    }
+    let Some(front) = front(state) else { return };
+    // shortcut: only directly attached single-block tanks until the pipe path solver is wired.
+    let [source_pos, target_pos] = [front.opposite(), front].map(|side| relative(pos, side));
+    if ![source_pos, target_pos].iter().all(|pos| {
+        world
+            .get_block_state_id_if_loaded(pos)
+            .is_some_and(|state| state.to_block().name == tank::ID)
+    }) {
+        return;
+    }
+    let (Some(source), Some(target)) = (
+        world.get_block_entity(&source_pos),
+        world.get_block_entity(&target_pos),
+    ) else {
+        return;
+    };
+    let (Some(a), Some(b)) = (
+        source.as_any().downcast_ref::<CreateFluidTank>(),
+        target.as_any().downcast_ref::<CreateFluidTank>(),
+    ) else {
+        return;
+    };
+    // Direction is the arrow on the pump; the magnitude of RPM determines pressure.
+    let signal = [a.signal(), b.signal()];
+    if a.transfer_to(b, fluid_transport::transfer_rate(rpm.abs())) > 0 {
+        world.update_block_entity(&source);
+        world.update_block_entity(&target);
+        for (at, before, after) in [
+            (source_pos, signal[0], a.signal()),
+            (target_pos, signal[1], b.signal()),
+        ] {
+            if before != after {
+                world.update_neighbour_for_output_signal(&at, world.get_block(&at));
+            }
+        }
+    }
+}
+
+#[pumpkin_block("create:mechanical_pump")]
+pub struct MechanicalPump;
+
+impl BlockBehaviour for MechanicalPump {
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        if args.item_stack.get_item().registry_key != "create:wrench"
+            || args
+                .world
+                .is_in_spawn_protection(args.player, args.position)
+        {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        let Some(state) = args.world.get_block_state_id_if_loaded(args.position) else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        let Some(direction) = front(state).filter(|_| state.to_block().name == ID) else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        args.world.set_block_state_if(
+            args.position,
+            BlockRegistry::set_create_facing(state.to_block(), state, direction.opposite()),
+            BlockFlags::NOTIFY_ALL,
+            |current| current == state,
+        );
+        BlockActionResult::SuccessServer
+    }
+}
