+    pub(crate) fn transfer_to(&self, target: &Self, limit: i32) -> i32 {
+        let key = |t: &Self| (t.position.0.x, t.position.0.y, t.position.0.z);
+        let (first, second, forward) = match key(self).cmp(&key(target)) {
+            std::cmp::Ordering::Less => (self, target, true),
+            std::cmp::Ordering::Greater => (target, self, false),
+            std::cmp::Ordering::Equal => return 0,
+        };
+        // Opposing pumps must take the tank locks in the same order.
+        let first = first.nbt.lock().unwrap_or_else(PoisonError::into_inner);
+        let second = second.nbt.lock().unwrap_or_else(PoisonError::into_inner);
+        let (mut from, mut to) = if forward {
+            (first, second)
+        } else {
+            (second, first)
+        };
+        let (Some((fluid, stocked)), Some((existing, filled))) =
+            (tank_contents(&from), tank_contents(&to))
+        else {
+            return 0;
+        };
+        if filled > 0 && fluid != existing {
+            return 0;
+        }
+        let volume = limit.min(stocked).min(CAPACITY - filled);
+        if volume > 0 {
+            let fluid = if fluid == "minecraft:lava" {
+                "minecraft:lava"
+            } else {
+                "minecraft:water"
+            };
+            write_tank(&mut from, fluid, stocked - volume);
+            write_tank(&mut to, fluid, filled + volume);
+            self.dirty.store(true, Ordering::Relaxed);
+            target.dirty.store(true, Ordering::Relaxed);
+        }
+        volume.max(0)
     }
 
