+    fn update_transmission(&self, world: &Arc<World>, tick: i64) {
+        let Some(state) = world.get_block_state_id_if_loaded(&self.position) else {
+            return;
+        };
+        let block = Block::from_state_id(state);
+        if block.name != self.id {
+            return;
+        }
+        let Some(mut props) = block.properties(state).map(|p| p.to_props()) else {
+            return;
+        };
+        let Some(powered) = props.iter_mut().find(|p| p.key_str() == "powered") else {
+            return;
+        };
+        let receives_power = block_receives_redstone_power(world, &self.position);
+        if (powered.value_str() == "true") == receives_power {
+            return;
+        }
+        let value = if receives_power { "true" } else { "false" };
+        let Some(new_powered) = Property::from_str_pair("powered", value) else {
+            return;
+        };
+        *powered = new_powered;
+        let updated = block.from_properties(&props).to_state_id(block);
+        if world
+            .set_block_state_if(
+                &self.position,
+                updated,
+                BlockFlags::NOTIFY_LISTENERS | BlockFlags::UPDATE_KNOWN_SHAPE,
+                |current| current == state,
+            )
+            .is_some()
+            && (self.id == GEARSHIFT || !receives_power)
+        {
+            self.detached_at.store(tick, Ordering::Relaxed);
+        }
+    }
+}
+
+fn tracks_ports(id: &str) -> bool {
+    matches!(id, GEARBOX | CLUTCH | GEARSHIFT)
