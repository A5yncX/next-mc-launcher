new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_drill.rs
@@ -0,0 +1,226 @@
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicI32, Ordering},
+};
+
+use create_engine::{
+    drilling::{Action, DrillCycle},
+    placement::Direction,
+};
+use pumpkin_data::{Block, BlockStateId, tag::Taggable};
+use pumpkin_nbt::compound::NbtCompound;
+use pumpkin_util::math::position::BlockPos;
+
+use crate::world::World;
+
+pub(crate) const ID: &str = "create:mechanical_drill";
+const NON_BREAKABLE_TAG: &str = "create:non_breakable";
+static NEXT_BREAKER_ID: AtomicI32 = AtomicI32::new(-1);
+
+#[derive(Default)]
+struct DrillState {
+    cycle: DrillCycle,
+    lazy_ticks: u8,
+    last_target: Option<(BlockPos, BlockStateId)>,
+    crack_target: Option<(BlockPos, BlockStateId)>,
+}
+
+pub(crate) struct Drill {
+    state: Mutex<DrillState>,
+    breaker_id: i32,
+}
+
+impl Default for Drill {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Drill {
+    pub(crate) fn new() -> Self {
+        Self {
+            state: Mutex::new(DrillState::default()),
+            breaker_id: NEXT_BREAKER_ID.fetch_sub(1, Ordering::Relaxed),
+        }
+    }
+
+    pub(crate) fn from_nbt(nbt: &NbtCompound) -> Self {
+        let mut drill = Self::new();
+        let state = drill
+            .state
+            .get_mut()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.cycle.progress = nbt.get_int("Progress").unwrap_or_default().clamp(0, 9);
+        state.cycle.next_tick = nbt.get_int("NextTick").unwrap_or_default().max(-1);
+        drill
+    }
+
+    pub(crate) fn write_nbt(&self, nbt: &mut NbtCompound) {
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        nbt.put_int("Progress", state.cycle.progress);
+        nbt.put_int("NextTick", state.cycle.next_tick);
+    }
+
+    /// Ticks once using the already validated effective network RPM. Returns whether progress
+    /// changed and the containing block entity should be refreshed.
+    pub(crate) fn tick(&self, world: &Arc<World>, position: BlockPos, rpm: f32) -> bool {
+        if !rpm.is_finite() {
+            return false;
+        }
+        let Some(source_id) = world.get_block_state_id_if_loaded(&position) else {
+            return false;
+        };
+        let source = Block::from_state_id(source_id);
+        if source.name != ID {
+            self.remove(world);
+            return false;
+        }
+        let Some(properties) = source
+            .properties(source_id)
+            .map(|properties| properties.to_props())
+        else {
+            self.remove(world);
+            return false;
+        };
+        let Some(facing) = properties
+            .iter()
+            .find(|property| property.key_str() == "facing")
+            .and_then(|property| {
+                Direction::ALL
+                    .into_iter()
+                    .find(|direction| direction.name() == property.value_str())
+            })
+        else {
+            self.remove(world);
+            return false;
+        };
+        let [dx, dy, dz] = facing.vector();
+        let target = BlockPos::new(position.0.x + dx, position.0.y + dy, position.0.z + dz);
+        let Some(target_id) = world.get_block_state_id_if_loaded(&target) else {
+            self.clear_crack(world);
+            return false;
+        };
+        let target_state = target_id.to_state();
+        let breakable = breakable_target(world, &target, target_id);
+
+        let (action, progress_changed, progress, old_crack) = {
+            let mut state = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            let old_cycle = state.cycle;
+            let old_crack = state
+                .crack_target
+                .filter(|previous| *previous != (target, target_id));
+            if old_crack.is_some() {
+                state.crack_target = None;
+            }
+            if state.lazy_ticks == 0 {
+                state.cycle.lazy_tick();
+                state.lazy_ticks = 10;
+            } else {
+                state.lazy_ticks -= 1;
+            }
+            if state
+                .last_target
+                .is_some_and(|previous| previous != (target, target_id))
+            {
+                state.cycle.wake();
+            }
+            state.last_target = Some((target, target_id));
+            let action = state.cycle.tick(rpm, target_state.hardness, breakable);
+            match action {
+                Action::Hit => state.crack_target = Some((target, target_id)),
+                Action::Clear | Action::Break => state.crack_target = None,
+                Action::None => {}
+            }
+            (
+                action,
+                old_cycle.progress != state.cycle.progress || action == Action::Break,
+                state.cycle.progress,
+                old_crack,
+            )
+        };
+
+        if let Some((old_position, _)) = old_crack {
+            world.set_block_destroy_stage(self.breaker_id, old_position, -1);
+        }
+        match action {
+            Action::Hit
+                if world.get_block_state_id_if_loaded(&position) == Some(source_id)
+                    && target_id_is_current(
+                        target_id,
+                        world.get_block_state_id_if_loaded(&target),
+                    ) =>
+            {
+                world.set_block_destroy_stage(self.breaker_id, target, progress as i8);
+            }
+            Action::Hit => self.clear_crack(world),
+            Action::Clear => world.set_block_destroy_stage(self.breaker_id, target, -1),
+            Action::Break => {
+                if world.get_block_state_id_if_loaded(&position) == Some(source_id)
+                    && breakable_target(world, &target, target_id)
+                {
+                    world.break_machine_target(&target, target_id);
+                }
+                world.set_block_destroy_stage(self.breaker_id, target, -1);
+            }
+            Action::None => {}
+        }
+        progress_changed
+    }
+
+    /// Call separately when this block entity is removed so clients lose its crack overlay.
+    pub(crate) fn remove(&self, world: &World) {
+        self.clear_crack(world);
+    }
+
+    fn clear_crack(&self, world: &World) {
+        let target = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .crack_target
+            .take();
+        if let Some((position, _)) = target {
+            world.set_block_destroy_stage(self.breaker_id, position, -1);
+        }
+    }
+}
+
+fn target_id_is_current(expected: BlockStateId, current: Option<BlockStateId>) -> bool {
+    current == Some(expected)
+}
+
+fn breakable_target(world: &World, position: &BlockPos, state_id: BlockStateId) -> bool {
+    let block = Block::from_state_id(state_id);
+    let hardness = state_id.to_state().hardness;
+    !block.is_air()
+        && block != &Block::WATER
+        && block != &Block::LAVA
+        && hardness.is_finite()
+        && hardness >= 0.0
+        && block.is_tagged_with(NON_BREAKABLE_TAG) != Some(true)
+        // shortcut: exclude block entities until destruction can collect their contents atomically.
+        && state_id.to_state().block_entity_type == u16::MAX
+        && world.get_block_entity(position).is_none()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn replaced_or_unloaded_targets_fail_the_break_guard() {
+        let expected = Block::STONE.default_state.id;
+        assert!(target_id_is_current(expected, Some(expected)));
+        assert!(!target_id_is_current(
+            expected,
+            Some(Block::AIR.default_state.id)
+        ));
+        assert!(!target_id_is_current(expected, None));
+    }
+}
