@@ -0,0 +1,799 @@
+use std::{
+    any::Any,
+    sync::{
+        Arc, PoisonError, RwLock,
+        atomic::{AtomicBool, AtomicI32, Ordering},
+    },
+};
+
+use pumpkin_data::{
+    BlockDirection, BlockStateId, block_properties::Property, data_component_impl::EquipmentSlot,
+    fluid::Fluid, item_stack::ItemStack,
+};
+use pumpkin_inventory::screen_handler::InventoryPlayer;
+use pumpkin_macros::pumpkin_block;
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::{
+    Hand,
+    math::{position::BlockPos, vector3::Vector3},
+};
+use pumpkin_world::world::{BlockAccessor, BlockFlags};
+
+use crate::{
+    block::{
+        BlockActionResult, BlockBehaviour, BlockIsReplacing, CanPlaceAtArgs, NormalUseArgs,
+        OnNeighborUpdateArgs, OnPlaceArgs, PlacedArgs, UseWithItemArgs,
+        blocks::{create_pipe, redstone},
+        entities::{BlockEntity, barrel::BarrelBlockEntity, chest::ChestBlockEntity},
+    },
+    entity::EntityBase,
+    world::World,
+};
+
+pub(crate) const ANDESITE: &str = "create:andesite_funnel";
+pub(crate) const BRASS: &str = "create:brass_funnel";
+const EXTRACTION_COOLDOWN: i32 = 8;
+const MAX_FILTER_AMOUNT: i32 = 99;
+
+#[pumpkin_block("create:andesite_funnel")]
+pub struct AndesiteFunnel;
+
+#[pumpkin_block("create:brass_funnel")]
+pub struct BrassFunnel;
+
+macro_rules! funnel_behaviour {
+    ($type:ty) => {
+        impl BlockBehaviour for $type {
+            fn on_place(&self, args: OnPlaceArgs<'_>) -> BlockStateId {
+                placement_state(args)
+            }
+
+            fn can_place_at(&self, args: CanPlaceAtArgs<'_>) -> bool {
+                can_place_at(args)
+            }
+
+            fn placed(&self, args: PlacedArgs<'_>) {
+                update_powered(args.world, args.position);
+                if args.world.get_block_entity(args.position).is_none() {
+                    args.world
+                        .add_block_entity(Arc::new(CreateFunnelBlockEntity::new(
+                            *args.position,
+                            args.block.name == BRASS,
+                        )));
+                }
+            }
+
+            fn on_neighbor_update(&self, args: OnNeighborUpdateArgs<'_>) {
+                update_powered(args.world, args.position);
+            }
+
+            fn normal_use(&self, args: NormalUseArgs<'_>) -> BlockActionResult {
+                normal_use(args)
+            }
+
+            fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+                use_with_item(args)
+            }
+        }
+    };
+}
+
+funnel_behaviour!(AndesiteFunnel);
+funnel_behaviour!(BrassFunnel);
+
+fn is_funnel(name: &str) -> bool {
+    matches!(name, ANDESITE | BRASS)
+}
+
+fn direction(state: BlockStateId) -> Option<BlockDirection> {
+    match create_pipe::property(state, "facing")? {
+        "up" => Some(BlockDirection::Up),
+        "down" => Some(BlockDirection::Down),
+        "north" => Some(BlockDirection::North),
+        "south" => Some(BlockDirection::South),
+        "west" => Some(BlockDirection::West),
+        "east" => Some(BlockDirection::East),
+        _ => None,
+    }
+}
+
+fn placement_state(args: OnPlaceArgs<'_>) -> BlockStateId {
+    let facing = if matches!(&args.replacing, &BlockIsReplacing::None) {
+        args.direction.opposite()
+    } else {
+        let look = Vector3::rotation_vector(
+            f64::from(args.player.get_entity().pitch.load()),
+            f64::from(args.player.get_entity().yaw.load()),
+        );
+        BlockDirection::get_nearest(look.x, look.y, look.z).opposite()
+    };
+    create_pipe::with_property(
+        create_pipe::with_property(
+            args.block.default_state.id,
+            "facing",
+            match facing {
+                BlockDirection::Up => "up",
+                BlockDirection::Down => "down",
+                BlockDirection::North => "north",
+                BlockDirection::South => "south",
+                BlockDirection::West => "west",
+                BlockDirection::East => "east",
+            },
+        ),
+        "extracting",
+        create_pipe::boolean(!args.player.get_entity().is_sneaking()),
+    )
+}
+
+fn can_place_at(args: CanPlaceAtArgs<'_>) -> bool {
+    let facing = match args.direction {
+        Some(facing @ (BlockDirection::Up | BlockDirection::Down)) => facing.opposite(),
+        Some(_) => return false,
+        None => match direction(args.state.id) {
+            Some(facing @ (BlockDirection::Up | BlockDirection::Down)) => facing,
+            _ => return false,
+        },
+    };
+    can_place_at_facing(args.block_accessor, args.position, facing)
+}
+
+fn can_place_at_facing(
+    accessor: &dyn BlockAccessor,
+    position: &BlockPos,
+    facing: BlockDirection,
+) -> bool {
+    let state = accessor.get_block_state_id(position);
+    if World::get_fluid_from_state_id(state).id != Fluid::EMPTY.id {
+        return false;
+    }
+    let behind = position.offset(facing.opposite().to_offset());
+    !is_funnel(accessor.get_block(&behind).name)
+}
+
+fn update_powered(world: &Arc<World>, position: &BlockPos) -> bool {
+    let powered = redstone::block_receives_redstone_power(world, position);
+    let (block, state) = world.get_block_and_state_id(position);
+    if !is_funnel(block.name) {
+        return powered;
+    }
+    let value = create_pipe::boolean(powered);
+    if create_pipe::property(state, "powered") == Some(value) {
+        return powered;
+    }
+    let Some(mut properties) = block
+        .properties(state)
+        .map(|properties| properties.to_props())
+    else {
+        return powered;
+    };
+    let Some(replacement) = Property::from_str_pair("powered", value) else {
+        return powered;
+    };
+    let Some(current) = properties
+        .iter_mut()
+        .find(|property| property.key_str() == "powered")
+    else {
+        return powered;
+    };
+    *current = replacement;
+    let next = block.from_properties(&properties).to_state_id(block);
+    world.set_block_state_if(position, next, BlockFlags::NOTIFY_ALL, |old| old == state);
+    powered
+}
+
+fn set_property(world: &Arc<World>, position: &BlockPos, key: &str, value: &str) -> bool {
+    let (block, state) = world.get_block_and_state_id(position);
+    if !is_funnel(block.name) || create_pipe::property(state, key) == Some(value) {
+        return false;
+    }
+    let Some(mut properties) = block
+        .properties(state)
+        .map(|properties| properties.to_props())
+    else {
+        return false;
+    };
+    let Some(replacement) = Property::from_str_pair(key, value) else {
+        return false;
+    };
+    let Some(current) = properties
+        .iter_mut()
+        .find(|property| property.key_str() == key)
+    else {
+        return false;
+    };
+    *current = replacement;
+    let next = block.from_properties(&properties).to_state_id(block);
+    world
+        .set_block_state_if(position, next, BlockFlags::NOTIFY_ALL, |old| old == state)
+        .is_some()
+}
+
+fn is_filter_sample(stack: &ItemStack) -> bool {
+    !stack.is_empty()
+        && !matches!(
+            stack.get_item().registry_key,
+            "create:filter" | "create:attribute_filter" | "create:package_filter"
+        )
+}
+
+fn filter_height(facing: BlockDirection) -> f32 {
+    match facing {
+        BlockDirection::Up => 2.0 / 16.0,
+        BlockDirection::Down => 14.0 / 16.0,
+        _ => 0.5,
+    }
+}
+
+fn filter_hit(
+    hit: &crate::block::BlockHitResult<'_>,
+    facing: BlockDirection,
+    may_build: bool,
+    sneaking: bool,
+    clipboard: bool,
+) -> bool {
+    if !may_build
+        || sneaking
+        || clipboard
+        || matches!(*hit.face, BlockDirection::Up | BlockDirection::Down)
+    {
+        return false;
+    }
+    let offset = hit.face.to_offset();
+    let center = [
+        0.5 + offset.x as f32 * 7.5 / 16.0,
+        filter_height(facing),
+        0.5 + offset.z as f32 * 7.5 / 16.0,
+    ];
+    let delta = [
+        hit.cursor_pos.x - center[0],
+        hit.cursor_pos.y - center[1],
+        hit.cursor_pos.z - center[2],
+    ];
+    delta.into_iter().map(|v| v * v).sum::<f32>() < 0.25 * 0.25
+}
+
+fn normal_use(args: NormalUseArgs<'_>) -> BlockActionResult {
+    let Some(state) = args.world.get_block_state_id_if_loaded(args.position) else {
+        return BlockActionResult::Pass;
+    };
+    let facing = direction(state);
+    if args.block.name != BRASS
+        || create_pipe::property(state, "waterlogged") == Some("true")
+        || args
+            .world
+            .is_in_spawn_protection(args.player, args.position)
+        || !facing.is_some_and(|facing| {
+            filter_hit(
+                args.hit,
+                facing,
+                args.player.may_build(),
+                args.player.get_entity().is_sneaking(),
+                false,
+            )
+        })
+    {
+        return BlockActionResult::Pass;
+    }
+    let Some(entity) = args.world.get_block_entity(args.position) else {
+        return BlockActionResult::Pass;
+    };
+    let Some(funnel) = entity.as_any().downcast_ref::<CreateFunnelBlockEntity>() else {
+        return BlockActionResult::Pass;
+    };
+    funnel.set_filter(None);
+    args.world.update_block_entity(&entity);
+    BlockActionResult::SuccessServer
+}
+
+fn use_with_item(args: UseWithItemArgs<'_>) -> BlockActionResult {
+    let Some(state) = args.world.get_block_state_id_if_loaded(args.position) else {
+        return BlockActionResult::PassToDefaultBlockAction;
+    };
+    if !is_funnel(args.block.name) || state.to_block().name != args.block.name {
+        return BlockActionResult::PassToDefaultBlockAction;
+    }
+    let waterlogged = create_pipe::property(state, "waterlogged") == Some("true");
+    let facing = direction(state);
+    let key = args.item_stack.get_item().registry_key;
+
+    if args.block.name == BRASS
+        && !waterlogged
+        && !args
+            .world
+            .is_in_spawn_protection(args.player, args.position)
+        && facing.is_some_and(|facing| {
+            filter_hit(
+                args.hit,
+                facing,
+                args.player.may_build(),
+                args.player.get_entity().is_sneaking(),
+                key == "create:clipboard",
+            )
+        })
+    {
+        if !matches!(
+            key,
+            "create:wrench" | "create:mechanical_arm" | "create:clipboard"
+        ) && (args.item_stack.is_empty() || is_filter_sample(args.item_stack))
+            && let Some(entity) = args.world.get_block_entity(args.position)
+            && let Some(funnel) = entity.as_any().downcast_ref::<CreateFunnelBlockEntity>()
+        {
+            funnel.set_filter(Some(args.item_stack));
+            args.world.update_block_entity(&entity);
+        }
+        return BlockActionResult::SuccessServer;
+    }
+
+    if key == "create:wrench" && args.player.may_build() {
+        if args
+            .world
+            .is_in_spawn_protection(args.player, args.position)
+        {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        let extracting = create_pipe::property(state, "extracting") == Some("true");
+        set_property(
+            args.world,
+            args.position,
+            "extracting",
+            create_pipe::boolean(!extracting),
+        );
+        return BlockActionResult::SuccessServer;
+    }
+
+    if waterlogged
+        || !args.player.may_build()
+        || args
+            .world
+            .is_in_spawn_protection(args.player, args.position)
+        || facing != Some(BlockDirection::Up)
+        || args.hit.face != &BlockDirection::Up
+        || args.player.get_entity().is_sneaking()
+        || args.item_stack.is_empty()
+        || key == "create:mechanical_arm"
+        || create_pipe::property(state, "powered") == Some("true")
+        || create_pipe::property(state, "extracting") == Some("true")
+        || update_powered(args.world, args.position)
+    {
+        return BlockActionResult::PassToDefaultBlockAction;
+    }
+
+    let destination = args.position.down();
+    let Some(block_entity) = loaded_inventory(args.world, &destination) else {
+        return BlockActionResult::PassToDefaultBlockAction;
+    };
+    let accepts = if args.block.name == BRASS {
+        let Some(entity) = args.world.get_block_entity(args.position) else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        let Some(funnel) = entity.as_any().downcast_ref::<CreateFunnelBlockEntity>() else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        funnel.accepts(args.item_stack)
+    } else {
+        true
+    };
+    if !accepts {
+        return BlockActionResult::PassToDefaultBlockAction;
+    }
+
+    let moved = {
+        let Some(target) = inventory_cells(block_entity.as_ref()) else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        let mut cells = target.write().unwrap_or_else(PoisonError::into_inner);
+        insert(
+            &mut *cells,
+            args.item_stack,
+            args.item_stack.item_count,
+            false,
+        )
+    };
+    if moved == 0 {
+        return BlockActionResult::PassToDefaultBlockAction;
+    }
+    args.item_stack.decrement(moved);
+    let hand = if *args.equipment_slot == EquipmentSlot::OFF_HAND {
+        Hand::Left
+    } else {
+        Hand::Right
+    };
+    let inventory = args.player.get_inventory();
+    inventory.set_stack_in_hand(hand, args.item_stack.clone());
+    args.player.sync_inventory_to_client();
+    mark_inventory(args.world, &block_entity);
+    BlockActionResult::SuccessServer
+}
+
+type Container = RwLock<[ItemStack; ChestBlockEntity::INVENTORY_SIZE]>;
+
+fn inventory_cells(entity: &dyn BlockEntity) -> Option<&Container> {
+    let any = entity.as_any();
+    if let Some(chest) = any.downcast_ref::<ChestBlockEntity>() {
+        if !chest.has_loot_table() {
+            return Some(&chest.items);
+        }
+    } else if let Some(barrel) = any.downcast_ref::<BarrelBlockEntity>() {
+        if !barrel.has_loot_table() {
+            return Some(&barrel.items);
+        }
+    }
+    None
+}
+
+fn loaded_inventory(world: &World, position: &BlockPos) -> Option<Arc<dyn BlockEntity>> {
+    let state = world.get_block_state_id_if_loaded(position)?;
+    // shortcut: only single chests and barrels; add atomic routes before enabling sided inventories.
+    if state.to_block().name != "barrel"
+        && !(state.to_block().name == "chest"
+            && create_pipe::property(state, "type") == Some("single"))
+    {
+        return None;
+    }
+    let entity = world.get_block_entity(position)?;
+    inventory_cells(entity.as_ref())?;
+    Some(entity)
+}
+
+fn insert(cells: &mut [ItemStack], stack: &ItemStack, requested: u8, exact: bool) -> u8 {
+    let space = |cell: &ItemStack| {
+        if cell.is_empty() {
+            stack.get_max_stack_size()
+        } else if cell.are_items_and_components_equal(stack) {
+            cell.get_max_stack_size().saturating_sub(cell.item_count)
+        } else {
+            0
+        }
+    };
+    if exact && cells.iter().map(|cell| u32::from(space(cell))).sum::<u32>() < u32::from(requested)
+    {
+        return 0;
+    }
+    let mut remaining = requested;
+    for cell in cells {
+        let count = remaining.min(space(cell));
+        if count == 0 {
+            continue;
+        }
+        if cell.is_empty() {
+            *cell = stack.clone();
+            cell.item_count = count;
+        } else {
+            cell.item_count += count;
+        }
+        remaining -= count;
+        if remaining == 0 {
+            break;
+        }
+    }
+    requested - remaining
+}
+
+#[derive(Clone)]
+struct FilterSettings {
+    sample: Option<ItemStack>,
+    opaque_filter: Option<NbtTag>,
+    amount: i32,
+    up_to: bool,
+}
+
+fn plan_transfer(
+    source: &[ItemStack],
+    target: &mut [ItemStack],
+    amount: u8,
+    exact: bool,
+    accepts: impl Fn(&ItemStack) -> bool,
+) -> Option<(usize, u8)> {
+    for (slot, stack) in source.iter().enumerate() {
+        if stack.is_empty() || !accepts(stack) || (exact && stack.item_count < amount) {
+            continue;
+        }
+        let moved = insert(target, stack, amount.min(stack.item_count), exact);
+        if moved != 0 {
+            return Some((slot, moved));
+        }
+    }
+    None
+}
+
+pub struct CreateFunnelBlockEntity {
+    position: BlockPos,
+    brass: bool,
+    filter: RwLock<FilterSettings>,
+    opaque_fields: NbtCompound,
+    cooldown: AtomicI32,
+    dirty: AtomicBool,
+}
+
+impl CreateFunnelBlockEntity {
+    pub(crate) fn new(position: BlockPos, brass: bool) -> Self {
+        Self::load(&NbtCompound::new(), position, brass)
+    }
+
+    pub(crate) fn load(nbt: &NbtCompound, position: BlockPos, brass: bool) -> Self {
+        let (sample, opaque_filter) = read_filter(nbt);
+        let mut amount = nbt.get_int("FilterAmount").unwrap_or(64);
+        let mut up_to = nbt.get_bool("UpTo").unwrap_or(true);
+        if amount == 0 {
+            amount = sample
+                .as_ref()
+                .map_or(64, |s| i32::from(s.get_max_stack_size()));
+            up_to = true;
+        }
+        let mut opaque_fields = NbtCompound::new();
+        for (key, value) in &nbt.child_tags {
+            if !matches!(
+                key.as_ref(),
+                "id" | "x" | "y" | "z" | "TransferCooldown" | "Filter" | "FilterAmount" | "UpTo"
+            ) {
+                opaque_fields.put(key.as_ref(), value.clone());
+            }
+        }
+        Self {
+            position,
+            brass,
+            filter: RwLock::new(FilterSettings {
+                sample,
+                opaque_filter,
+                amount,
+                up_to,
+            }),
+            opaque_fields,
+            cooldown: AtomicI32::new(
+                nbt.get_int("TransferCooldown")
+                    .unwrap_or(0)
+                    .clamp(0, EXTRACTION_COOLDOWN),
+            ),
+            dirty: AtomicBool::new(false),
+        }
+    }
+
+    fn mark_dirty(&self) {
+        self.dirty.store(true, Ordering::Relaxed);
+    }
+
+    fn sync(&self, world: &Arc<World>) {
+        if let Some(entity) = world.get_block_entity(&self.position)
+            && entity
+                .as_any()
+                .downcast_ref::<CreateFunnelBlockEntity>()
+                .is_some()
+        {
+            world.update_block_entity(&entity);
+        }
+    }
+
+    fn set_cooldown(&self, cooldown: i32) -> bool {
+        let cooldown = cooldown.clamp(0, EXTRACTION_COOLDOWN);
+        let changed = self.cooldown.swap(cooldown, Ordering::Relaxed) != cooldown;
+        if changed {
+            self.mark_dirty();
+        }
+        changed
+    }
+
+    fn accepts(&self, stack: &ItemStack) -> bool {
+        let filter = self.filter.read().unwrap_or_else(PoisonError::into_inner);
+        filter.opaque_filter.is_none()
+            && filter
+                .sample
+                .as_ref()
+                .is_none_or(|sample| sample.get_item() == stack.get_item())
+    }
+
+    fn set_filter(&self, sample: Option<&ItemStack>) {
+        let mut filter = self.filter.write().unwrap_or_else(PoisonError::into_inner);
+        filter.sample = sample
+            .filter(|sample| is_filter_sample(sample))
+            .map(|sample| {
+                let mut sample = sample.clone();
+                sample.item_count = 1;
+                sample
+            });
+        filter.opaque_filter = None;
+        if !filter.up_to
+            && let Some(sample) = &filter.sample
+        {
+            filter.amount = filter.amount.min(i32::from(sample.get_max_stack_size()));
+        }
+        self.mark_dirty();
+    }
+
+    fn transfer(&self, world: &Arc<World>, facing: BlockDirection) -> bool {
+        if !matches!(facing, BlockDirection::Up | BlockDirection::Down) {
+            return false;
+        }
+        let source_pos = self.position.offset(facing.opposite().to_offset());
+        let target_pos = self.position.offset(facing.to_offset());
+        let (Some(source), Some(target)) = (
+            loaded_inventory(world, &source_pos),
+            loaded_inventory(world, &target_pos),
+        ) else {
+            return false;
+        };
+        if Arc::ptr_eq(&source, &target) {
+            return false;
+        }
+        let (Some(src), Some(dst)) = (
+            inventory_cells(source.as_ref()),
+            inventory_cells(target.as_ref()),
+        ) else {
+            return false;
+        };
+        let filter = self
+            .filter
+            .read()
+            .unwrap_or_else(PoisonError::into_inner)
+            .clone();
+        if self.brass
+            && (filter.opaque_filter.is_some() || !(1..=MAX_FILTER_AMOUNT).contains(&filter.amount))
+        {
+            return false;
+        }
+        let moved = {
+            // Both inventories stay locked through insertion and removal. Lock lower Y first.
+            let (lower, upper) = if facing == BlockDirection::Up {
+                (src, dst)
+            } else {
+                (dst, src)
+            };
+            let mut low = lower.write().unwrap_or_else(PoisonError::into_inner);
+            let mut high = upper.write().unwrap_or_else(PoisonError::into_inner);
+            let (from, into) = if facing == BlockDirection::Up {
+                (&mut *low, &mut *high)
+            } else {
+                (&mut *high, &mut *low)
+            };
+            let amount = if self.brass { filter.amount as u8 } else { 1 };
+            if let Some((i, count)) =
+                plan_transfer(from, into, amount, self.brass && !filter.up_to, |stack| {
+                    !self.brass
+                        || filter
+                            .sample
+                            .as_ref()
+                            .is_none_or(|sample| sample.get_item() == stack.get_item())
+                })
+            {
+                from[i].decrement(count);
+                true
+            } else {
+                false
+            }
+        };
+        if moved {
+            mark_inventory(world, &source);
+            mark_inventory(world, &target);
+        }
+        moved
+    }
+}
+
+fn mark_inventory(world: &World, entity: &Arc<dyn BlockEntity>) {
+    if let Some(inventory) = entity.clone().get_inventory() {
+        inventory.mark_dirty();
+    }
+    world.update_block_entity(entity);
+}
+
+impl BlockEntity for CreateFunnelBlockEntity {
+    fn write_nbt(&self, nbt: &mut NbtCompound) {
+        for (key, value) in &self.opaque_fields.child_tags {
+            nbt.put(key.as_ref(), value.clone());
+        }
+        nbt.put_int("TransferCooldown", self.cooldown.load(Ordering::Relaxed));
+        let filter = self.filter.read().unwrap_or_else(PoisonError::into_inner);
+        if let Some(opaque) = &filter.opaque_filter {
+            nbt.put("Filter", opaque.clone());
+        } else if let Some(sample) = &filter.sample {
+            let mut tag = NbtCompound::new();
+            sample.write_item_stack(&mut tag);
+            nbt.put_compound("Filter", tag);
+        } else {
+            nbt.put_compound("Filter", NbtCompound::new());
+        }
+        nbt.put_int("FilterAmount", filter.amount);
+        nbt.put_bool("UpTo", filter.up_to);
+    }
+
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        Self::load(nbt, position, nbt.get_string("id") == Some(BRASS))
+    }
+
+    fn tick(&self, world: &Arc<World>) {
+        let (block, state) = world.get_block_and_state_id(&self.position);
+        if !is_funnel(block.name) {
+            return;
+        }
+        let powered = update_powered(world, &self.position);
+        let state = world
+            .get_block_state_id_if_loaded(&self.position)
+            .unwrap_or(state);
+        if create_pipe::property(state, "waterlogged") == Some("true") {
+            return;
+        }
+        if powered {
+            if self.set_cooldown(0) {
+                self.sync(world);
+            }
+            return;
+        }
+        let cooldown = self.cooldown.load(Ordering::Relaxed);
+        if cooldown > 0 {
+            if self.set_cooldown(cooldown - 1) {
+                self.sync(world);
+            }
+            return;
+        }
+        if create_pipe::property(state, "extracting") == Some("true")
+            && let Some(facing) = direction(state)
+            && self.transfer(world, facing)
+            && self.set_cooldown(EXTRACTION_COOLDOWN)
+        {
+            self.sync(world);
+        }
+    }
+
+    fn resource_location(&self) -> &'static str {
+        if self.brass { BRASS } else { ANDESITE }
+    }
+
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+
+    fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Relaxed)
+    }
+
+    fn clear_dirty(&self) {
+        self.dirty.store(false, Ordering::Relaxed);
+    }
+
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        let mut nbt = NbtCompound::new();
+        self.write_nbt(&mut nbt);
+        Some(nbt)
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+fn read_filter(nbt: &NbtCompound) -> (Option<ItemStack>, Option<NbtTag>) {
+    match nbt.child_tags.get("Filter") {
+        None => (None, None),
+        Some(NbtTag::Compound(compound)) if compound.is_empty() => (None, None),
+        Some(NbtTag::Compound(compound)) => match ItemStack::read_item_stack(compound) {
+            Some(mut stack) if is_filter_sample(&stack) => {
+                stack.item_count = 1;
+                (Some(stack), None)
+            }
+            Some(_) | None => (None, Some(NbtTag::Compound(compound.clone()))),
+        },
+        Some(tag) => (None, Some(tag.clone())),
+    }
+}
