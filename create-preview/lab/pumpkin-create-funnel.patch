+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pumpkin_data::item::Item;
+
+    #[test]
+    fn blocked_exact_transfer_does_not_touch_destination() {
+        let src = [ItemStack::new(7, &Item::WHEAT)];
+        let mut dst = [
+            ItemStack::new(62, &Item::WHEAT),
+            ItemStack::new(64, &Item::STONE),
+        ];
+        assert_eq!(plan_transfer(&src, &mut dst, 3, true, |_| true), None);
+        assert_eq!(dst[0].item_count, 62);
+        assert_eq!(plan_transfer(&src, &mut dst, 3, false, |_| false), None);
+        assert_eq!(
+            plan_transfer(&src, &mut dst, 3, false, |_| true),
+            Some((0, 2))
+        );
+        assert_eq!(dst[0].item_count, 64);
+    }
+}
