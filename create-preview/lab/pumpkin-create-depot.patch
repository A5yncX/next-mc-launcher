+use std::any::Any;
+use std::array::from_fn;
+use std::sync::{
+    Arc, RwLock,
+    atomic::{AtomicBool, AtomicI32, Ordering},
+};
+
+use pumpkin_data::item_stack::ItemStack;
+use pumpkin_inventory::{Clearable, Inventory, sync_write_items_to_nbt};
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::position::BlockPos;
+
+use crate::{block::entities::BlockEntity, world::World};
+
+pub struct CreateDepotBlockEntity {
+    pub position: BlockPos,
+    pub items: RwLock<[ItemStack; Self::INVENTORY_SIZE]>,
+    pub dirty: AtomicBool,
+    held_direction: AtomicI32,
+    opaque_items: Option<NbtTag>,
+    opaque_held_item: Option<NbtCompound>,
+    opaque_output_buffer: Option<NbtCompound>,
+}
+
+impl BlockEntity for CreateDepotBlockEntity {
+    fn resource_location(&self) -> &'static str {
+        Self::ID
+    }
+
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        let mut items = from_fn(|_| ItemStack::EMPTY.clone());
+        let opaque_items = read_items_preserving_unknown(nbt, &mut items);
+        let held_direction = nbt
+            .get_compound("HeldItem")
+            .and_then(|held| held.get_int("InDirection"))
+            .filter(|direction| (0..6).contains(direction))
+            .unwrap_or(3);
+        let mut opaque_output_buffer = nbt
+            .get_compound("OutputBuffer")
+            .filter(|buffer| buffer.get_int("Size").is_some_and(|size| size != 8))
+            .cloned();
+        let mut opaque_held_item = None;
+
+        if let Some(held) = nbt.get_compound("HeldItem") {
+            if let Some(item) = held
+                .get_compound("Item")
+                .and_then(ItemStack::read_item_stack)
+            {
+                items[0] = item;
+            } else if held.has("Item") {
+                opaque_held_item = Some(held.clone());
+            }
+        }
+
+        if let Some(output_buffer) = nbt.get_compound("OutputBuffer")
+            && let Some(output_items) = output_buffer.get_list("Items")
+        {
+            for entry in output_items {
+                let Some(entry) = entry.extract_compound() else {
+                    opaque_output_buffer.get_or_insert_with(|| output_buffer.clone());
+                    break;
+                };
+                let Some(slot) = numeric_slot(entry) else {
+                    opaque_output_buffer.get_or_insert_with(|| output_buffer.clone());
+                    break;
+                };
+                let Some(stack) = ItemStack::read_item_stack(entry) else {
+                    opaque_output_buffer.get_or_insert_with(|| output_buffer.clone());
+                    break;
+                };
+                if !(0..8).contains(&slot) {
+                    opaque_output_buffer.get_or_insert_with(|| output_buffer.clone());
+                    break;
+                }
+                items[slot as usize + 1] = stack;
+            }
+        }
+
+        Self {
+            position,
+            items: RwLock::new(items),
+            dirty: AtomicBool::new(false),
+            held_direction: AtomicI32::new(held_direction),
+            opaque_items,
+            opaque_held_item,
+            opaque_output_buffer,
+        }
+    }
+
+    fn write_nbt(&self, nbt: &mut NbtCompound) {
+        let items = self
+            .items
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        nbt.child_tags.remove("Items");
+        if let Some(opaque_items) = &self.opaque_items {
+            nbt.put("Items", opaque_items.clone());
+        } else {
+            sync_write_items_to_nbt(&*items, nbt);
+        }
+
+        nbt.child_tags.remove("HeldItem");
+        if let Some(opaque_held_item) = &self.opaque_held_item {
+            nbt.put_compound("HeldItem", opaque_held_item.clone());
+        } else if !items[0].is_empty() {
+            let mut held = NbtCompound::new();
+            held.put_float("Pos", 0.25);
+            held.put_float("PrevPos", 0.25);
+            held.put_float("Offset", 0.0);
+            held.put_float("PrevOffset", 0.0);
+            held.put_int("InSegment", 0);
+            held.put_int("Angle", 0);
+            held.put_int("InDirection", self.held_direction.load(Ordering::Relaxed));
+            let mut item = NbtCompound::new();
+            items[0].write_item_stack(&mut item);
+            held.put_compound("Item", item);
+            nbt.put_compound("HeldItem", held);
+        }
+
+        let output_buffer = self
+            .opaque_output_buffer
+            .clone()
+            .unwrap_or_else(|| output_buffer_nbt(&items[1..]));
+        nbt.put_compound("OutputBuffer", output_buffer);
+        nbt.child_tags.remove("DisplayItem");
+        nbt.child_tags.remove("DisplayCount");
+    }
+
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        let mut nbt = NbtCompound::new();
+        self.write_nbt(&mut nbt);
+        Some(nbt)
+    }
+
+    fn get_inventory(self: Arc<Self>) -> Option<Arc<dyn Inventory>> {
+        // Do not expose generic hopper transfers; Create's empty-only adapters are out of scope.
+        None
+    }
+
+    fn on_block_replaced(self: Arc<Self>, world: &Arc<World>, position: &BlockPos) {
+        let inventory: Arc<dyn Inventory> = self;
+        world.scatter_inventory(position, &inventory);
+    }
+
+    fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Relaxed)
+    }
+
+    fn clear_dirty(&self) {
+        self.dirty.store(false, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl CreateDepotBlockEntity {
+    pub const INVENTORY_SIZE: usize = 9;
+    pub const OUTPUT_BUFFER_SIZE: usize = 8;
+    pub const ID: &'static str = "create:depot";
+
+    #[must_use]
+    pub fn new(position: BlockPos) -> Self {
+        Self {
+            position,
+            items: RwLock::new(from_fn(|_| ItemStack::EMPTY.clone())),
+            dirty: AtomicBool::new(false),
+            held_direction: AtomicI32::new(3),
+            opaque_items: None,
+            opaque_held_item: None,
+            opaque_output_buffer: None,
+        }
+    }
+
+    #[must_use]
+    pub fn is_supported(&self) -> bool {
+        self.opaque_items.is_none()
+            && self.opaque_held_item.is_none()
+            && self.opaque_output_buffer.is_none()
+    }
+
+    pub fn swap_contents(&self, incoming: Option<ItemStack>, direction: i32) -> Vec<ItemStack> {
+        let mut items = self
+            .items
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let taken = items
+            .iter_mut()
+            .filter_map(|stack| {
+                if stack.is_empty() {
+                    None
+                } else {
+                    Some(std::mem::replace(stack, ItemStack::EMPTY.clone()))
+                }
+            })
+            .collect();
+        if let Some(stack) = incoming {
+            self.held_direction.store(direction, Ordering::Relaxed);
+            items[0] = stack;
+        }
+        self.mark_dirty();
+        taken
+    }
+}
+
+impl Inventory for CreateDepotBlockEntity {
+    fn size(&self) -> usize {
+        Self::INVENTORY_SIZE
+    }
+
+    fn is_empty(&self) -> bool {
+        self.items
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .iter()
+            .all(ItemStack::is_empty)
+    }
+
+    fn get_stack(&self, slot: usize) -> ItemStack {
+        self.items
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)[slot]
+            .clone()
+    }
+
+    fn remove_stack(&self, slot: usize) -> ItemStack {
+        let mut items = self
+            .items
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let removed = std::mem::replace(&mut items[slot], ItemStack::EMPTY.clone());
+        self.mark_dirty();
+        removed
+    }
+
+    fn remove_stack_specific(&self, slot: usize, amount: u8) -> ItemStack {
+        let mut items = self
+            .items
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let removed = if !items[slot].is_empty() && amount > 0 {
+            items[slot].split(amount)
+        } else {
+            ItemStack::EMPTY.clone()
+        };
+        self.mark_dirty();
+        removed
+    }
+
+    fn set_stack(&self, slot: usize, stack: ItemStack) {
+        self.items
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)[slot] = stack;
+        self.mark_dirty();
+    }
+
+    fn get_max_count_per_stack(&self) -> u8 {
+        64
+    }
+
+    fn mark_dirty(&self) {
+        self.dirty.store(true, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl Clearable for CreateDepotBlockEntity {
+    fn clear(&self) {
+        self.items
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .fill_with(|| ItemStack::EMPTY.clone());
+        self.mark_dirty();
+    }
+}
+
+fn numeric_slot(compound: &NbtCompound) -> Option<i32> {
+    compound
+        .get_int("Slot")
+        .or_else(|| compound.get_byte("Slot").map(i32::from))
+}
+
+fn read_items_preserving_unknown(
+    nbt: &NbtCompound,
+    items: &mut [ItemStack; CreateDepotBlockEntity::INVENTORY_SIZE],
+) -> Option<NbtTag> {
+    let Some(list) = nbt.get_list("Items") else {
+        return nbt.child_tags.get("Items").cloned();
+    };
+    for entry in list {
+        let Some(compound) = entry.extract_compound() else {
+            return Some(NbtTag::List(list.to_vec()));
+        };
+        let Some(slot) = numeric_slot(compound) else {
+            return Some(NbtTag::List(list.to_vec()));
+        };
+        let Some(stack) = ItemStack::read_item_stack(compound) else {
+            return Some(NbtTag::List(list.to_vec()));
+        };
+        if !(0..CreateDepotBlockEntity::INVENTORY_SIZE as i32).contains(&slot) {
+            return Some(NbtTag::List(list.to_vec()));
+        }
+        items[slot as usize] = stack;
+    }
+    None
+}
+
+fn canonical_empty_output_buffer() -> NbtCompound {
+    let mut output_buffer = NbtCompound::new();
+    output_buffer.put_int("Size", CreateDepotBlockEntity::OUTPUT_BUFFER_SIZE as i32);
+    output_buffer.put_list("Items", Vec::new());
+    output_buffer
+}
+
+fn output_buffer_nbt(items: &[ItemStack]) -> NbtCompound {
+    let mut output_buffer = canonical_empty_output_buffer();
+    let output_items = items
+        .iter()
+        .enumerate()
+        .filter(|(_, stack)| !stack.is_empty())
+        .map(|(slot, stack)| {
+            let mut item = NbtCompound::new();
+            item.put_int("Slot", slot as i32);
+            stack.write_item_stack(&mut item);
+            NbtTag::Compound(item)
+        })
+        .collect();
+    output_buffer.put_list("Items", output_items);
+    output_buffer
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pumpkin_data::item::Item;
+
+    #[test]
+    fn writes_and_restores_depot_display_and_output_slots() {
+        let position = BlockPos::new(1, 2, 3);
+        let depot = CreateDepotBlockEntity::new(position);
+        assert!(
+            depot
+                .swap_contents(Some(ItemStack::new(3, &Item::DIAMOND)), 4)
+                .is_empty()
+        );
+        depot.set_stack(1, ItemStack::new(12, &Item::STONE));
+
+        let mut nbt = NbtCompound::new();
+        depot.write_nbt(&mut nbt);
+        let held = nbt.get_compound("HeldItem").unwrap();
+        assert_eq!(held.get_float("Pos"), Some(0.25));
+        assert_eq!(held.get_float("PrevPos"), Some(0.25));
+        assert_eq!(held.get_int("InDirection"), Some(4));
+        assert_eq!(held.get_compound("Item").unwrap().get_int("count"), Some(3));
+        let output = nbt.get_compound("OutputBuffer").unwrap();
+        assert_eq!(output.get_int("Size"), Some(8));
+        let entry = output.get_list("Items").unwrap()[0]
+            .extract_compound()
+            .unwrap();
+        assert_eq!(entry.get_int("Slot"), Some(0));
+        assert_eq!(entry.get_int("count"), Some(12));
+        assert!(!nbt.has("DisplayItem"));
+        assert!(!nbt.has("DisplayCount"));
+
+        let restored = CreateDepotBlockEntity::from_nbt(&nbt, position);
+        assert_eq!(restored.size(), 9);
+        assert_eq!(restored.get_stack(0).item_count, 3);
+        assert_eq!(restored.get_stack(1).item_count, 12);
+    }
+
+    #[test]
+    fn leaves_noncanonical_output_buffer_opaque() {
+        let position = BlockPos::new(0, 0, 0);
+        let mut nbt = NbtCompound::new();
+        let mut output = NbtCompound::new();
+        output.put_int("Size", 7);
+        output.put_string("FutureField", "preserve".into());
+        nbt.put_compound("OutputBuffer", output);
+        nbt.put_int("Items", 123);
+
+        let depot = CreateDepotBlockEntity::from_nbt(&nbt, position);
+        assert!(!depot.is_supported());
+        let mut written = NbtCompound::new();
+        depot.write_nbt(&mut written);
+        let output = written.get_compound("OutputBuffer").unwrap();
+        assert_eq!(output.get_int("Size"), Some(7));
+        assert_eq!(output.get_string("FutureField"), Some("preserve"));
+        assert_eq!(written.get_int("Items"), Some(123));
+    }
+}
