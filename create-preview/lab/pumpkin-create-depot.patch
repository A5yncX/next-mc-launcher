+use std::sync::Arc;
+
+use pumpkin_data::data_component_impl::EquipmentSlot;
+use pumpkin_data::{BlockDirection, entity::EntityType, item_stack::ItemStack};
+use pumpkin_inventory::screen_handler::InventoryPlayer;
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::{Hand, math::vector3::Vector3};
+
+use crate::{
+    block::{
+        BlockBehaviour, NormalUseArgs, PlacedArgs, UseWithItemArgs,
+        entities::create_depot::CreateDepotBlockEntity, registry::BlockActionResult,
+    },
+    entity::{Entity, EntityBase, item::ItemEntity, player::Player},
+    world::World,
+};
+
+#[pumpkin_block("create:depot")]
+pub struct CreateDepotBlock;
+
+impl BlockBehaviour for CreateDepotBlock {
+    fn normal_use(&self, args: NormalUseArgs<'_>) -> BlockActionResult {
+        if args.hit.face != &BlockDirection::Up || shift_has_item(args.player) {
+            return BlockActionResult::Pass;
+        }
+        if interact(args.world, args.player, args.position, None, 3) {
+            BlockActionResult::SuccessServer
+        } else {
+            BlockActionResult::Pass
+        }
+    }
+
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        if args.hit.face != &BlockDirection::Up {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        if shift_has_item(args.player) {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+
+        let item_key = args.item_stack.get_item().registry_key;
+        let put = !args.item_stack.is_empty()
+            && !matches!(item_key, "create:mechanical_arm" | "mechanical_arm");
+        let hand = if *args.equipment_slot == EquipmentSlot::OFF_HAND {
+            Hand::Left
+        } else {
+            Hand::Right
+        };
+        let incoming = put.then(|| (hand, args.item_stack.clone()));
+        let yaw = args.player.get_entity().yaw.load();
+        if interact(
+            args.world,
+            args.player,
+            args.position,
+            incoming,
+            horizontal_direction(yaw),
+        ) {
+            if put {
+                *args.item_stack = args.player.get_inventory().get_stack_in_hand(hand);
+            }
+            BlockActionResult::SuccessServer
+        } else {
+            BlockActionResult::PassToDefaultBlockAction
+        }
+    }
+
+    fn placed(&self, args: PlacedArgs<'_>) {
+        if args.world.get_block_entity(args.position).is_none() {
+            args.world
+                .add_block_entity(Arc::new(CreateDepotBlockEntity::new(*args.position)));
+        }
+    }
+}
+
+fn shift_has_item(player: &Player) -> bool {
+    player.get_entity().is_sneaking()
+        && [Hand::Right, Hand::Left]
+            .into_iter()
+            .any(|hand| !player.get_inventory().get_stack_in_hand(hand).is_empty())
+}
+
+fn interact(
+    world: &Arc<World>,
+    player: &Arc<Player>,
+    position: &pumpkin_util::math::position::BlockPos,
+    incoming: Option<(Hand, ItemStack)>,
+    direction: i32,
+) -> bool {
+    let Some(block_entity) = world.get_block_entity(position) else {
+        return false;
+    };
+    let Some(depot) = block_entity
+        .as_any()
+        .downcast_ref::<CreateDepotBlockEntity>()
+    else {
+        return false;
+    };
+    if !depot.is_supported() {
+        return false;
+    }
+
+    let inventory = player.get_inventory();
+    let incoming = incoming.map(|(hand, stack)| {
+        // Free the selected slot before returning items, so the final packet cannot overwrite them.
+        inventory.set_stack_in_hand(hand, ItemStack::EMPTY.clone());
+        stack
+    });
+    for mut stack in depot.swap_contents(incoming, direction) {
+        inventory.insert_stack_anywhere(&mut stack);
+        if !stack.is_empty() {
+            drop_overflow(world, player, stack);
+        }
+    }
+    player.sync_inventory_to_client();
+    world.update_block_entity(&block_entity);
+    true
+}
+
+fn drop_overflow(world: &Arc<World>, player: &Player, stack: ItemStack) {
+    let player_pos = player.get_entity().pos.load();
+    let entity = Entity::new(
+        world.clone(),
+        Vector3::new(player_pos.x, player_pos.y + 1.0, player_pos.z),
+        &EntityType::ITEM,
+    );
+    world.spawn_entity(Arc::new(ItemEntity::new_with_velocity(
+        entity,
+        stack,
+        Vector3::new(0.0, 0.2, 0.0),
+        10,
+    )));
+}
+
+fn horizontal_direction(yaw: f32) -> i32 {
+    match ((f64::from(yaw) / 90.0 + 0.5).floor() as i64 & 3) as u8 {
+        0 => 3, // south
+        1 => 4, // west
+        2 => 2, // north
+        _ => 5, // east
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::horizontal_direction;
+
+    #[test]
+    fn maps_yaw_to_create_direction_indices() {
+        assert_eq!(horizontal_direction(0.0), 3);
+        assert_eq!(horizontal_direction(90.0), 4);
+        assert_eq!(horizontal_direction(180.0), 2);
+        assert_eq!(horizontal_direction(270.0), 5);
+    }
+}
