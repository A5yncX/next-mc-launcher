 use std::sync::Arc;
 
+use create_engine::contraption::actors::throw_boost;
 use pumpkin_data::{Block, item::Item, item_stack::ItemStack};
-use pumpkin_util::math::position::BlockPos;
+use pumpkin_util::math::{boundingbox::BoundingBox, position::BlockPos, vector3::Vector3};
 
 use crate::world::World;
 
 pub(super) const ID: &str = "create:mechanical_plough";
+
+pub(super) fn push(world: &World, pos: BlockPos, motion: [f64; 3]) {
+    if world.spawn_protects_position(&pos)
+        || world
+            .get_block_state_if_loaded(&pos)
+            .is_none_or(|s| s.is_solid_block())
+    {
+        return;
+    }
+    let [x, y, z] = throw_boost(motion);
+    let mut mobs = Vec::new();
+    // shortcut: limit a visit to 64 mobs; revisit if large pen stress tests need more.
+    world.extend_entities_in_box_where(&mut mobs, 64, BoundingBox::from_block(&pos), |e| {
+        e.get_mob().is_some()
+            && e.get_living_entity()
+                .is_some_and(|living| living.is_alive())
+    });
+    for mob in mobs.into_iter().take(64) {
+        mob.get_entity().add_velocity(Vector3::new(x, y, z));
+    }
+}
 
