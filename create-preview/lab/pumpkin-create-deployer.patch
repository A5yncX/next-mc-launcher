+pub(crate) fn interact(
+    world: &Arc<World>,
+    player: &Player,
+    pos: &BlockPos,
+    cursor: &Vector3<f32>,
+    item: &mut ItemStack,
+) -> bool {
+    use create_engine::placement::Direction;
+    let Some(state) = world.get_block_state_id_if_loaded(pos) else {
+        return false;
+    };
+    if state.to_block().name != ID
+        || player.get_entity().is_sneaking()
+        || !matches!(
+            player.gamemode.load(),
+            GameMode::Creative | GameMode::Survival
+        )
+        || world.is_in_spawn_protection(player, pos)
+        || matches!(item.get_item().registry_key, ID | "create:wrench")
+    {
+        return false;
+    }
+    let Some(facing) = Direction::ALL
+        .into_iter()
+        .find(|d| property(state, "facing") == Some(d.name()))
+    else {
+        return false;
+    };
+    let axis = facing.axis().index();
+    let forward = [cursor.x, cursor.y, cursor.z][axis];
+    let depth = if facing.vector()[axis] > 0 {
+        forward
+    } else {
+        1.0 - forward
+    };
+    if depth < 0.75 {
+        return false;
+    }
+    let Some(entity) = world.get_block_entity(pos) else {
+        return false;
+    };
+    let Some(deployer) = entity.as_any().downcast_ref::<CreateDeployerBlockEntity>() else {
+        return false;
+    };
+    if let Ok(old) = deployer.swap_hand((!item.is_empty()).then(|| item.clone())) {
+        *item = old.unwrap_or_else(|| ItemStack::EMPTY.clone());
+        world.update_block_entity(&entity);
+        true
+    } else {
+        false
+    }
+}
+
+fn read_stationary(nbt: &NbtCompound) -> Option<Stationary> {
+    let mode = match nbt.get_string("Mode")? {
+        "USE" => Mode::Use,
+        "PUNCH" => Mode::Punch,
+        _ => return None,
+    };
+    let phase = match nbt.get("State") {
+        None => Phase::Waiting,
+        Some(NbtTag::String(phase)) => match phase.as_ref() {
+            "WAITING" => Phase::Waiting,
+            "EXPANDING" => Phase::Expanding,
+            "RETRACTING" => Phase::Retracting,
+            _ => return None,
+        },
+        _ => return None,
+    };
+    let timer = match nbt.get("Timer") {
+        None => 0,
+        Some(NbtTag::Int(timer)) if (-511..=5120).contains(timer) => *timer,
+        _ => return None,
+    };
+    let reach = match nbt.get("Reach") {
+        None => 0.0,
+        Some(NbtTag::Float(reach)) if reach.is_finite() => *reach,
+        _ => return None,
+    };
+    Some(Stationary {
+        mode,
+        phase,
+        timer,
+        reach,
+        ..Stationary::default()
+    })
+}
+
+fn read_inventory(nbt: &NbtCompound) -> Option<ItemStack> {
+    let hand = match nbt.get("Inventory") {
+        None => ItemStack::EMPTY.clone(),
+        Some(NbtTag::List(items)) if items.is_empty() => ItemStack::EMPTY.clone(),
+        Some(NbtTag::List(items)) if items.len() == 1 => {
+            let entry = items[0].extract_compound()?;
+            if entry.get_byte("Slot") != Some(0) {
+                return None;
+            }
+            let stack = ItemStack::read_item_stack(entry)?;
+            if stack.is_empty() || stack.item_count > 99 {
+                return None;
+            }
+            let mut encoded = stack_nbt(&stack);
+            encoded.put_byte("Slot", 0);
+            if &encoded != entry {
+                return None;
+            }
+            stack
+        }
+        _ => return None,
+    };
+    Some(hand)
+}
+
+fn read_hand(nbt: &NbtCompound) -> Option<ItemStack> {
+    let hand = read_inventory(nbt)?;
+    match nbt.get("HeldItem") {
+        None => Some(hand),
+        Some(NbtTag::Compound(display)) if hand.is_empty() && display.child_tags.is_empty() => {
+            Some(hand)
+        }
+        Some(NbtTag::Compound(display)) if !hand.is_empty() => {
+            (&stack_nbt(&hand) == display).then_some(hand)
+        }
+        _ => None,
+    }
+}
+
+fn stack_nbt(stack: &ItemStack) -> NbtCompound {
+    let mut nbt = NbtCompound::new();
+    stack.write_item_stack(&mut nbt);
+    if nbt
+        .get_compound("components")
+        .is_some_and(|components| components.child_tags.is_empty())
+    {
+        nbt.child_tags.remove("components");
+    }
+    nbt
+}
+
+fn inventory_nbt(stack: &ItemStack) -> Vec<NbtTag> {
+    if stack.is_empty() {
+        return Vec::new();
+    }
+    let mut entry = stack_nbt(stack);
+    entry.put_byte("Slot", 0);
+    vec![NbtTag::Compound(entry)]
+}
+
+fn recipe_result(input: &ItemStack, hand: &ItemStack) -> Option<&'static Item> {
+    if input.is_empty()
+        || hand.is_empty()
+        || hand.get_item().is_tagged_with("#minecraft:planks") != Some(true)
+    {
+        return None;
+    }
+    match input.get_item().registry_key {
+        "create:shaft" => Some(&Item::CREATE_COGWHEEL),
+        "create:cogwheel" => Some(&Item::CREATE_LARGE_COGWHEEL),
+        _ => None,
+    }
+}
