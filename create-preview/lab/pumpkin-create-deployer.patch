+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn belt_start_holds_then_apply_consumes_one_of_each_stack() {
+        let deployer = CreateDeployerBlockEntity::new(BlockPos::new(0, 0, 0));
+        assert!(
+            deployer
+                .swap_hand(Some(ItemStack::new(2, &Item::OAK_PLANKS)))
+                .is_ok()
+        );
+        let mut input = ItemStack::new(2, &Item::CREATE_SHAFT);
+
+        assert!(matches!(
+            deployer.transport(&mut input, false, false, 1.0, 10),
+            TransportAction::Hold
+        ));
+        assert_eq!(input.item_count, 2);
+        assert_eq!(deployer.stationary().phase, Phase::Expanding);
+
+        {
+            let mut state = deployer.state.lock().unwrap();
+            state.phase = Phase::Retracting;
+            state.timer = 1000;
+        }
+        let TransportAction::Apply(output) = deployer.transport(&mut input, true, false, 1.0, 11)
+        else {
+            panic!("expected a cogwheel application");
+        };
+        assert_eq!(output.get_item().registry_key, "create:cogwheel");
+        assert_eq!(input.item_count, 1);
+        assert_eq!(deployer.hand().unwrap().item_count, 1);
+    }
+
+    #[test]
+    fn tagged_planks_make_the_large_cogwheel_recipe() {
+        let input = ItemStack::new(1, &Item::CREATE_COGWHEEL);
+        let hand = ItemStack::new(1, &Item::OAK_PLANKS);
+        assert_eq!(
+            recipe_result(&input, &hand).map(|item| item.registry_key),
+            Some("create:large_cogwheel")
+        );
+    }
+
+    #[test]
+    fn nbt_round_trip_uses_the_pinned_client_fields() {
+        let deployer = CreateDeployerBlockEntity::new(BlockPos::new(0, 0, 0));
+        let mut nbt = NbtCompound::new();
+        deployer.write_nbt(&mut nbt);
+
+        assert_eq!(nbt.get_string("Mode"), Some("USE"));
+        assert_eq!(nbt.get_string("State"), Some("WAITING"));
+        assert_eq!(nbt.get_byte("Powered"), Some(0));
+        assert_eq!(nbt.get_int("Timer"), Some(0));
+        assert_eq!(nbt.get_float("Reach"), Some(0.0));
+        assert_eq!(nbt.get_int(TICK_KEY), Some(0));
+        assert!(nbt.get_list("Inventory").unwrap().is_empty());
+        assert!(
+            nbt.get_compound("HeldItem")
+                .is_some_and(|held| held.child_tags.is_empty())
+        );
+        assert!(
+            <CreateDeployerBlockEntity as BlockEntity>::from_nbt(&nbt, BlockPos::new(0, 0, 0))
+                .is_supported()
+        );
+    }
+
+    #[test]
+    fn mismatched_belt_item_passes_without_consumption() {
+        let deployer = CreateDeployerBlockEntity::new(BlockPos::new(0, 0, 0));
+        assert!(
+            deployer
+                .swap_hand(Some(ItemStack::new(1, &Item::OAK_PLANKS)))
+                .is_ok()
+        );
+        let mut input = ItemStack::new(2, &Item::STONE);
+
+        assert!(matches!(
+            deployer.transport(&mut input, false, false, 1.0, 10),
+            TransportAction::Pass
+        ));
+        assert_eq!(input.item_count, 2);
+        assert_eq!(deployer.hand().unwrap().item_count, 1);
+    }
+}
