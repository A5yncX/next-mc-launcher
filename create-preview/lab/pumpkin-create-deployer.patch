+use std::{
+    any::Any,
+    sync::{
+        Arc, Mutex, PoisonError, RwLock,
+        atomic::{AtomicBool, AtomicI32, Ordering},
+    },
+};
+
+use create_engine::deployer::{
+    BeltAction, Mode, Phase, Stationary, TickAction, Waiting, belt_action,
+};
+use pumpkin_data::{item::Item, item_stack::ItemStack, tag::Taggable};
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_util::{GameMode, math::vector3::Vector3};
+
+use super::{BlockEntity, create_kinetic::CreateKinetic};
+use crate::{
+    block::blocks::{create_pipe::property, redstone::block_receives_redstone_power},
+    entity::{EntityBase, player::Player},
+    world::World,
+};
+
+pub(crate) const ID: &str = "create:deployer";
+const TICK_KEY: &str = "create_horizon:DeployerTick";
+const HAND_SIZE: usize = 1;
+
+pub(crate) enum TransportAction {
+    Hold,
+    Apply(ItemStack),
+    Pass,
+}
+
+pub(crate) struct CreateDeployerBlockEntity {
+    position: BlockPos,
+    kinetic: CreateKinetic,
+    used_stroke: AtomicBool,
+    hand: RwLock<[ItemStack; HAND_SIZE]>,
+    state: Mutex<Stationary>,
+    powered: AtomicBool,
+    sample_tick: AtomicI32,
+    dirty: AtomicBool,
+    other_nbt: NbtCompound,
+    opaque_nbt: Option<NbtCompound>,
+}
+
+impl BlockEntity for CreateDeployerBlockEntity {
+    fn resource_location(&self) -> &'static str {
+        ID
+    }
+
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        let state = read_stationary(nbt);
+        let powered = match nbt.get("Powered") {
+            None => Some(false),
+            Some(NbtTag::Byte(value)) => Some(*value != 0),
+            _ => None,
+        };
+        let hand = read_inventory(nbt);
+        let valid_hand = read_hand(nbt).is_some();
+        let sample_tick = match nbt.get(TICK_KEY) {
+            None => Some(0),
+            Some(NbtTag::Int(value)) => Some(*value),
+            _ => None,
+        };
+        let supported = state.is_some()
+            && powered.is_some()
+            && valid_hand
+            && hand.is_some()
+            && sample_tick.is_some();
+        let mut other_nbt = nbt.clone();
+        for key in [
+            "Mode",
+            "State",
+            "Powered",
+            "Timer",
+            "HeldItem",
+            "Inventory",
+            "Reach",
+            TICK_KEY,
+        ] {
+            other_nbt.child_tags.remove(key);
+        }
+
+        Self {
+            position,
+            kinetic: CreateKinetic::from_nbt(nbt, position),
+            used_stroke: AtomicBool::new(nbt.get_bool("NextMcUsedStroke").unwrap_or(false)),
+            hand: RwLock::new([hand.unwrap_or_else(|| ItemStack::EMPTY.clone())]),
+            state: Mutex::new(state.unwrap_or_default()),
+            powered: AtomicBool::new(powered.unwrap_or(false)),
+            sample_tick: AtomicI32::new(sample_tick.unwrap_or_default()),
+            dirty: AtomicBool::new(false),
+            other_nbt,
+            opaque_nbt: (!supported).then(|| nbt.clone()),
+        }
+    }
+
+    fn write_nbt(&self, nbt: &mut NbtCompound) {
+        if let Some(opaque_nbt) = &self.opaque_nbt {
+            nbt.merge(opaque_nbt);
+            return;
+        }
+
+        nbt.merge(&self.other_nbt);
+        self.kinetic.write_nbt(nbt);
+        let state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        let hand = self.hand.read().unwrap_or_else(PoisonError::into_inner);
+        nbt.put_string("Mode", state.mode.saved_name().to_owned());
+        nbt.put_string("State", state.phase.saved_name().to_owned());
+        nbt.put_bool("Powered", self.powered.load(Ordering::Relaxed));
+        nbt.put_int("Timer", state.timer);
+        nbt.put_compound(
+            "HeldItem",
+            if hand[0].is_empty() {
+                NbtCompound::new()
+            } else {
+                stack_nbt(&hand[0])
+            },
+        );
+        nbt.put_list("Inventory", inventory_nbt(&hand[0]));
+        nbt.put_float("Reach", state.reach);
+        nbt.put_int(TICK_KEY, self.sample_tick.load(Ordering::Relaxed));
+        nbt.put_bool("NextMcUsedStroke", self.used_stroke.load(Ordering::Relaxed));
+    }
+
+    fn tick(&self, world: &Arc<World>) {
+        let prev_speed = self.kinetic.rpm();
+        self.kinetic.tick(world);
+        let speed = self.kinetic.rpm();
+        let powered = block_receives_redstone_power(world, &self.position);
+        let power_changed = self.powered.swap(powered, Ordering::Relaxed) != powered;
+        // Belt hooks own new strokes. The stationary tick only advances the current stroke.
+        let tick = world.get_world_age();
+        let phase_changed = self.tick_cycle(speed, tick, |_| Waiting::Locked) != TickAction::None;
+        if (power_changed || phase_changed || prev_speed != speed)
+            && let Some(entity) = world.get_block_entity(&self.position)
+            && entity
+                .as_any()
+                .downcast_ref::<Self>()
+                .is_some_and(|live| std::ptr::eq(live, self))
+        {
+            world.update_block_entity(&entity);
+        }
+    }
+
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        let mut nbt = NbtCompound::new();
+        self.write_nbt(&mut nbt);
+        Some(nbt)
+    }
+
+    fn on_block_replaced(self: Arc<Self>, world: &Arc<World>, position: &BlockPos) {
+        let stack = {
+            let mut hand = self.hand.write().unwrap_or_else(PoisonError::into_inner);
+            std::mem::replace(&mut hand[0], ItemStack::EMPTY.clone())
+        };
+        if !stack.is_empty() {
+            world.drop_stack(position, stack);
+        }
+    }
+
+    fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Relaxed)
+    }
+
+    fn clear_dirty(&self) {
+        self.dirty.store(false, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl CreateDeployerBlockEntity {
+    #[must_use]
+    pub fn new(position: BlockPos) -> Self {
+        Self {
+            position,
+            kinetic: CreateKinetic::new(ID, position),
+            used_stroke: AtomicBool::new(false),
+            hand: RwLock::new([ItemStack::EMPTY.clone()]),
+            state: Mutex::new(Stationary::default()),
+            powered: AtomicBool::new(false),
+            sample_tick: AtomicI32::new(0),
+            dirty: AtomicBool::new(false),
+            other_nbt: NbtCompound::new(),
+            opaque_nbt: None,
+        }
+    }
+
+    #[must_use]
+    pub(crate) fn is_supported(&self) -> bool {
+        self.opaque_nbt.is_none()
+    }
+
+    #[cfg(test)]
+    fn stationary(&self) -> Stationary {
+        *self.state.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    #[cfg(test)]
+    fn hand(&self) -> Option<ItemStack> {
+        if !self.is_supported() {
+            return None;
+        }
+        let hand = self.hand.read().unwrap_or_else(PoisonError::into_inner);
+        (!hand[0].is_empty()).then(|| hand[0].clone())
+    }
+
+    pub(crate) fn rpm(&self) -> f32 {
+        self.kinetic.rpm()
+    }
+
+    /// Exchanges slot 0. Rejected stacks are returned untouched to the caller.
+    pub(crate) fn swap_hand(
+        &self,
+        incoming: Option<ItemStack>,
+    ) -> Result<Option<ItemStack>, Option<ItemStack>> {
+        if !self.is_supported()
+            || incoming
+                .as_ref()
+                .is_some_and(|stack| stack.is_empty() || stack.item_count > 99)
+        {
+            return Err(incoming);
+        }
+        let mut hand = self.hand.write().unwrap_or_else(PoisonError::into_inner);
+        let previous = std::mem::replace(
+            &mut hand[0],
+            incoming.unwrap_or_else(|| ItemStack::EMPTY.clone()),
+        );
+        self.mark_dirty();
+        Ok((!previous.is_empty()).then_some(previous))
+    }
+
+    /// Advances the pinned stationary engine state; the host supplies speed and target checks.
+    pub(crate) fn tick_cycle(
+        &self,
+        rpm: f32,
+        world_tick: i64,
+        waiting: impl FnOnce(Mode) -> Waiting,
+    ) -> TickAction {
+        if !self.is_supported() {
+            return TickAction::None;
+        }
+        let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        let before = *state;
+        let action = state.tick(rpm, waiting);
+        let changed = before != *state;
+        let tick_changed = action == TickAction::Started
+            && self.sample_tick.swap(world_tick as i32, Ordering::Relaxed) != world_tick as i32;
+        if changed || tick_changed {
+            self.mark_dirty();
+        }
+        action
+    }
+
+    /// Processes one belt item. Only Apply consumes one input and one hand item.
+    pub(crate) fn transport(
+        &self,
+        input: &mut ItemStack,
+        held: bool,
+        powered: bool,
+        reach: f32,
+        world_tick: i64,
+    ) -> TransportAction {
+        if !self.is_supported() {
+            return TransportAction::Pass;
+        }
+
+        let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        let mut hand = self.hand.write().unwrap_or_else(PoisonError::into_inner);
+        let powered_changed = self.powered.swap(powered, Ordering::Relaxed) != powered;
+        let result = recipe_result(input, &hand[0]);
+        let action = belt_action(*state, held, powered, !hand[0].is_empty(), result.is_some());
+        match action {
+            BeltAction::Pass => {
+                if powered_changed {
+                    self.mark_dirty();
+                }
+                TransportAction::Pass
+            }
+            BeltAction::Hold => {
+                if powered_changed {
+                    self.mark_dirty();
+                }
+                TransportAction::Hold
+            }
+            BeltAction::Start => {
+                self.used_stroke.store(false, Ordering::Relaxed);
+                state.start(reach);
+                self.sample_tick.store(world_tick as i32, Ordering::Relaxed);
+                self.mark_dirty();
+                TransportAction::Hold
+            }
+            BeltAction::Apply if self.used_stroke.load(Ordering::Relaxed) => TransportAction::Hold,
+            BeltAction::Apply => {
+                let Some(result) = result else {
+                    return TransportAction::Pass;
+                };
+                self.used_stroke.store(true, Ordering::Relaxed);
+                input.decrement(1);
+                hand[0].decrement(1);
+                if hand[0].is_empty() {
+                    hand[0] = ItemStack::EMPTY.clone();
+                }
+                self.mark_dirty();
+                TransportAction::Apply(ItemStack::new(1, result))
+            }
+        }
+    }
+
+    fn mark_dirty(&self) {
+        self.dirty.store(true, Ordering::Relaxed);
+    }
+}
