diff --git a/crates/pumpkin-core/src/block/entities/create_drain.rs b/crates/pumpkin-core/src/block/entities/create_drain.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_drain.rs
@@ -0,0 +1,168 @@
+use std::{
+    any::Any,
+    sync::{
+        Mutex, PoisonError,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::position::BlockPos;
+
+use super::BlockEntity;
+
+pub(crate) const ID: &str = "create:item_drain";
+const CAPACITY: i32 = 1500;
+
+pub(crate) struct CreateDrain {
+    position: BlockPos,
+    nbt: Mutex<NbtCompound>,
+    dirty: AtomicBool,
+}
+
+impl CreateDrain {
+    pub fn new(position: BlockPos) -> Self {
+        let mut nbt = NbtCompound::new();
+        nbt.put_int("ProcessingTicks", 0);
+        write_tank(&mut nbt, "minecraft:water", 0);
+        Self::from_nbt(&nbt, position)
+    }
+
+    pub fn pour(&self, id: &str, amount: i32) -> bool {
+        let mut nbt = self.nbt.lock().unwrap_or_else(PoisonError::into_inner);
+        let Some((old_fluid, old_amount)) = tank(&nbt) else {
+            return false;
+        };
+        if !matches!(id, "minecraft:water" | "minecraft:lava" | "create:honey")
+            || amount <= 0
+            || amount > CAPACITY - old_amount
+            || (old_amount > 0 && old_fluid != id)
+        {
+            return false;
+        }
+        write_tank(&mut nbt, id, old_amount + amount);
+        self.dirty.store(true, Ordering::Relaxed);
+        true
+    }
+
+    pub fn signal(&self) -> u8 {
+        let nbt = self.nbt.lock().unwrap_or_else(PoisonError::into_inner);
+        tank(&nbt).map_or(0, |(_, amount)| {
+            (14 * amount / CAPACITY + i32::from(amount > 0)) as u8
+        })
+    }
+}
+
+fn tank(nbt: &NbtCompound) -> Option<(&str, i32)> {
+    let [NbtTag::Compound(segment)] = nbt.get_list("Tanks")? else {
+        return None;
+    };
+    let content = segment.get_compound("TankContent")?;
+    if content.child_tags.is_empty() {
+        return Some(("minecraft:water", 0));
+    }
+    let fluid = content.get_compound("Fluid")?;
+    let id = fluid.get_string("id")?;
+    let amount = fluid.get_int("amount")?;
+    (matches!(id, "minecraft:water" | "minecraft:lava" | "create:honey")
+        && (1..=CAPACITY).contains(&amount)
+        && content.child_tags.len() == 1
+        && fluid.child_tags.len() == 2)
+        .then_some((id, amount))
+}
+
+fn write_tank(nbt: &mut NbtCompound, id: &str, amount: i32) {
+    let mut segment = nbt
+        .get_list("Tanks")
+        .and_then(|list| list.first())
+        .and_then(NbtTag::extract_compound)
+        .cloned()
+        .unwrap_or_else(NbtCompound::new);
+    let mut content = NbtCompound::new();
+    if amount > 0 {
+        let mut fluid = NbtCompound::new();
+        fluid.put_string("id", id.into());
+        fluid.put_int("amount", amount);
+        content.put_compound("Fluid", fluid);
+    }
+    // shortcut: write the final level for remote rendering; add animation with automated transfer.
+    let fill = amount as f32 / CAPACITY as f32;
+    let mut level = segment
+        .get_compound("Level")
+        .cloned()
+        .unwrap_or_else(NbtCompound::new);
+    level.put_float("Value", fill);
+    level.put_float("Target", fill);
+    level.put_float("Speed", 0.25);
+    segment.put_compound("Level", level);
+    segment.put_compound("TankContent", content);
+    nbt.put_list("Tanks", vec![NbtTag::Compound(segment)]);
+}
+
+impl BlockEntity for CreateDrain {
+    fn resource_location(&self) -> &'static str {
+        ID
+    }
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        let mut nbt = nbt.clone();
+        for key in ["id", "x", "y", "z"] {
+            nbt.child_tags.remove(key);
+        }
+        Self {
+            position,
+            nbt: Mutex::new(nbt),
+            dirty: AtomicBool::new(false),
+        }
+    }
+    fn write_nbt(&self, nbt: &mut NbtCompound) {
+        let current = self.nbt.lock().unwrap_or_else(PoisonError::into_inner);
+        nbt.child_tags.extend(current.child_tags.clone());
+    }
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        Some(
+            self.nbt
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+                .clone(),
+        )
+    }
+    fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Relaxed)
+    }
+    fn clear_dirty(&self) {
+        self.dirty.store(false, Ordering::Relaxed);
+    }
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn admits_one_fluid_within_capacity_and_reloads() {
+        let pos = BlockPos::new(0, 0, 0);
+        let drain = CreateDrain::new(pos);
+        assert_eq!(drain.signal(), 0);
+        assert!(drain.pour("minecraft:water", 1000));
+        assert!(!drain.pour("minecraft:lava", 1000));
+        assert!(!drain.pour("minecraft:water", 1000));
+        assert_eq!(drain.signal(), 10);
+        assert!(drain.pour("minecraft:water", 250));
+        let mut saved = drain.chunk_data_nbt().unwrap();
+        saved.put_string("FutureField", "keep".into());
+        let drain = CreateDrain::from_nbt(&saved, pos);
+        assert_eq!(drain.signal(), 12);
+        assert!(drain.pour("minecraft:water", 250));
+        assert!(!drain.pour("minecraft:water", 1));
+        let saved = drain.chunk_data_nbt().unwrap();
+        assert_eq!(saved.get_string("FutureField"), Some("keep"));
+        assert_eq!(tank(&saved), Some(("minecraft:water", 1500)));
+        assert_eq!(drain.signal(), 15);
+    }
+}
