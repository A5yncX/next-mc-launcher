@@ -0,0 +1,118 @@
+use std::sync::Arc;
+
+use pumpkin_data::{
+    data_component_impl::{EquipmentSlot, PotionContentsImpl},
+    item::Item,
+    item_stack::ItemStack,
+    potion::Potion,
+};
+use pumpkin_inventory::screen_handler::InventoryPlayer;
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::{GameMode, Hand};
+
+use crate::{
+    block::{
+        BlockActionResult, BlockBehaviour, GetComparatorOutputArgs, PlacedArgs, UseWithItemArgs,
+        entities::create_drain::CreateDrain,
+    },
+    entity::EntityBase,
+};
+
+#[pumpkin_block("create:item_drain")]
+pub struct ItemDrain;
+
+fn emptying(stack: &ItemStack) -> Option<(&'static str, i32, &'static Item)> {
+    if stack.is_empty() {
+        return None;
+    }
+    match stack.get_item().id {
+        id if id == Item::WATER_BUCKET.id => Some(("minecraft:water", 1000, &Item::BUCKET)),
+        id if id == Item::LAVA_BUCKET.id => Some(("minecraft:lava", 1000, &Item::BUCKET)),
+        // shortcut: stock honey recipe only; use the processing recipe loader once supported.
+        id if id == Item::HONEY_BOTTLE.id => Some(("create:honey", 250, &Item::GLASS_BOTTLE)),
+        id if id == Item::POTION.id
+            && stack
+                .get_data_component::<PotionContentsImpl>()
+                .is_some_and(|p| {
+                    p.potion_id == Some(Potion::WATER.id as i32) && p.custom_effects.is_empty()
+                }) =>
+        {
+            Some(("minecraft:water", 250, &Item::GLASS_BOTTLE))
+        }
+        _ => None,
+    }
+}
+
+impl BlockBehaviour for ItemDrain {
+    fn placed(&self, args: PlacedArgs<'_>) {
+        if args.world.get_block_entity(args.position).is_none() {
+            args.world
+                .add_block_entity(Arc::new(CreateDrain::new(*args.position)));
+        }
+    }
+
+    fn get_comparator_output(&self, args: GetComparatorOutputArgs<'_>) -> Option<u8> {
+        Some(
+            args.world
+                .get_block_entity(args.position)
+                .as_ref()
+                .and_then(|entity| entity.as_any().downcast_ref::<CreateDrain>())
+                .map_or(0, CreateDrain::signal),
+        )
+    }
+
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        let mode = args.player.gamemode.load();
+        if args.player.get_entity().is_sneaking()
+            || !matches!(
+                mode,
+                GameMode::Survival | GameMode::Creative | GameMode::Adventure
+            )
+            || args
+                .world
+                .is_in_spawn_protection(args.player, args.position)
+        {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        let Some((fluid, amount, empty)) = emptying(args.item_stack) else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        let Some(entity) = args.world.get_block_entity(args.position) else {
+            return BlockActionResult::SuccessServer;
+        };
+        if entity
+            .as_any()
+            .downcast_ref::<CreateDrain>()
+            .is_some_and(|drain| drain.pour(fluid, amount))
+        {
+            if mode != GameMode::Creative {
+                let mut container = ItemStack::new(1, empty);
+                if args.item_stack.item_count == 1 {
+                    *args.item_stack = container;
+                } else {
+                    args.item_stack.decrement(1);
+                    args.player
+                        .get_inventory()
+                        .insert_stack_anywhere(&mut container);
+                    if !container.is_empty() {
+                        args.world.drop_stack(args.position, container);
+                    }
+                }
+                // A consuming block action bypasses the packet handler's hand update.
+                let hand = if *args.equipment_slot == EquipmentSlot::OFF_HAND {
+                    Hand::Left
+                } else {
+                    Hand::Right
+                };
+                args.player
+                    .get_inventory()
+                    .set_stack_in_hand(hand, args.item_stack.clone());
+                args.player.sync_inventory_to_client();
+            }
+            args.world.update_block_entity(&entity);
+            args.world
+                .update_neighbour_for_output_signal(args.position, args.block);
+        }
+        BlockActionResult::SuccessServer
+    }
+}
