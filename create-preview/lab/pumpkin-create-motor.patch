 pub(super) const MOTOR: &str = "create:creative_motor";
 pub(super) const SHAFT: &str = "create:shaft";
 pub(super) const COG: &str = "create:cogwheel";
+const DEFAULT_MOTOR_SETTING: i32 = 32;
+pub(crate) const MOD_NET_CHANNEL: &str = "horizon:mod_net";
+
+// Both lengths fit in one VarInt: the inner channel has 24 bytes and its body has five i32s.
+const MOTOR_SETTINGS_HEADER: &[u8] = b"\x18create:motor_settings_v2\x14";
+
+fn motor_setting(payload: &[u8]) -> Option<(BlockPos, i32)> {
+    let ([x, y, z, row, raw], []) = payload
+        .strip_prefix(MOTOR_SETTINGS_HEADER)?
+        .as_chunks::<4>()
+    else {
+        return None;
+    };
+    let [x, y, z, row, raw] = [*x, *y, *z, *row, *raw].map(i32::from_be_bytes);
+    let value = match (row, raw) {
+        (0, 0..=256) => -raw.max(1),
+        (1, 0..=256) => raw.max(1),
+        _ => return None,
+    };
+    Some((BlockPos::new(x, y, z), value))
+}
+
+pub(crate) fn apply_motor_setting(player: &Player, payload: &[u8]) {
+    let Some((pos, value)) = motor_setting(payload) else {
+        return;
+    };
+    if !matches!(
+        player.gamemode.load(),
+        GameMode::Survival | GameMode::Creative
+    ) || !player.living_entity.is_alive()
+        || !player.can_interact_with_block_at(&pos, 1.0)
+    {
+        return;
+    }
+    let world = player.get_entity().world.load_full();
+    if world.is_in_spawn_protection(player, &pos)
+        || !world
+            .get_block_state_id_if_loaded(&pos)
+            .is_some_and(|id| Block::from_state_id(id).name == MOTOR)
+    {
+        return;
+    }
+    if let Some(entity) = world.get_block_entity(&pos)
+        && let Some(motor) = entity.as_any().downcast_ref::<CreateKinetic>()
+        && motor.id == MOTOR
+        && motor.setting.swap(value, Ordering::Relaxed) != value
+    {
+        world.update_block_entity(&entity);
+    }
+}
 
