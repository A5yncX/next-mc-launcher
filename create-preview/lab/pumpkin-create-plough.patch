diff --git a/crates/pumpkin-core/src/block/entities/create_plough.rs b/crates/pumpkin-core/src/block/entities/create_plough.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_plough.rs
@@ -0,0 +1,31 @@
+use std::sync::Arc;
+
+use pumpkin_data::{Block, item::Item, item_stack::ItemStack};
+use pumpkin_util::math::position::BlockPos;
+
+use crate::world::World;
+
+pub(super) const ID: &str = "create:mechanical_plough";
+
+pub(super) fn till(world: &Arc<World>, top: BlockPos) {
+    let (Some(air), Some(soil)) = (
+        world.get_block_state_id_if_loaded(&top),
+        world.get_block_state_id_if_loaded(&top.down()),
+    ) else {
+        return;
+    };
+    if !air.to_state().is_air() {
+        return;
+    }
+    let kind = soil.to_block();
+    let result = match kind.name {
+        "grass_block" | "dirt" | "dirt_path" => &Block::FARMLAND,
+        "coarse_dirt" | "rooted_dirt" => &Block::DIRT,
+        _ => return,
+    };
+    if world.compare_create_field(top, [(air, air), (soil, result.default_state.id)])
+        && kind == &Block::ROOTED_DIRT
+    {
+        world.drop_stack(&top, ItemStack::new(1, &Item::HANGING_ROOTS));
+    }
+}
