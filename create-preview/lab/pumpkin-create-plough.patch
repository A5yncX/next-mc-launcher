+    pub(crate) fn compare_create_field(
+        self: &Arc<Self>,
+        top: BlockPos,
+        edits: [(BlockStateId, BlockStateId); 2],
+    ) -> bool {
+        let positions = [top, top.down()];
+        if positions
+            .iter()
+            .any(|p| !self.is_in_build_limit(*p) || self.spawn_protects_position(p))
+        {
+            return false;
+        }
+        let key = top.chunk_and_chunk_relative_position().0;
+        let changes = std::array::from_fn::<_, 2, _>(|i| {
+            let (_, relative) = positions[i].chunk_and_chunk_relative_position();
+            (relative.x as usize, relative.y, relative.z as usize, edits[i].0, edits[i].1)
+        });
+        if self
+            .level
+            .read_chunk_sync(&key, |chunk| chunk.compare_set_blocks(&changes, None))
+            .flatten()
+            .is_none()
+        {
+            return false;
+        }
+        for (pos, (before, after)) in positions.into_iter().zip(edits) {
+            if before != after {
+                self.on_block_state_set(&pos, before, after, BlockFlags::NOTIFY_ALL);
+            }
+        }
+        true
+    }
