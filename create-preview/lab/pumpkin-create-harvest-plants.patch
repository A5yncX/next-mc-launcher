+fn plant_cut(state: BlockStateId) -> Option<(Harvest, &'static Item)> {
+    let block = state.to_block();
+    let leaves = block.has_tag(&tag::Block::MINECRAFT_LEAVES);
+    let mut input = HarvesterBlock {
+        leaves,
+        ..Default::default()
+    };
+    if block == &Block::SUGAR_CANE {
+        let props = block.properties(state)?.to_props();
+        let value = props
+            .iter()
+            .find(|p| p.key().to_str() == "age")?
+            .value_str()
+            .parse()
+            .ok()?;
+        input.generic_age = Some(Age {
+            value,
+            mature_value: 15,
+        });
+        input.plant = Plant::SugarCane;
+        input.sugar_cane_variant = true;
+        input.collision_empty = true;
+    } else if matches!(
+        block.name,
+        "dandelion" | "poppy" | "oak_sapling" | "birch_sapling"
+    ) {
+        input.plant = Plant::BushOrSpecialPlantable;
+        input.collision_empty = true;
+    } else if !leaves {
+        return None;
+    }
+    Some((
+        harvester::plan(input, Rules::default())?,
+        Item::from_registry_key(block.name)?,
+    ))
+}
