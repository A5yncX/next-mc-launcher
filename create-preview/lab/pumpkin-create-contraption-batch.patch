     #[test]
+    fn guarded_batch_changes_every_block_or_none() {
+        let chunk = super::ChunkData::empty(0, 0);
+        let air = Block::AIR.default_state.id;
+        let stone = Block::STONE.default_state.id;
+        let dirt = Block::DIRT.default_state.id;
+        chunk.set_block_absolute_y(1, 0, 1, stone);
+        let edits = [(1, 0, 1, stone, air), (1, 16, 1, air, stone)];
+        assert!(
+            chunk
+                .compare_set_blocks(&[edits[0], (1, 16, 1, dirt, stone)])
+                .is_none()
+        );
+        assert!(
+            chunk
+                .compare_set_blocks(&[edits[0], (16, 16, 1, air, stone)])
+                .is_none()
+        );
+        assert!(
+            chunk
+                .compare_set_blocks(&[edits[0], (1, i32::MIN, 1, air, stone)])
+                .is_none()
+        );
+        assert!(chunk.compare_set_blocks(&[edits[0], edits[0]]).is_none());
+        assert_eq!(
+            chunk.compare_set_blocks(&edits).unwrap(),
+            [(1, 0, 1, stone), (1, 16, 1, air)]
+        );
+        assert!(chunk.compare_set_blocks(&edits).is_none());
+        assert_eq!(chunk.section.get_block_absolute_y(1, 0, 1), Some(air));
+        assert_eq!(chunk.section.get_block_absolute_y(1, 16, 1), Some(stone));
+    }
