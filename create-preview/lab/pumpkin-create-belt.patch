diff --git a/crates/pumpkin-core/src/block/blocks/create_belt.rs b/crates/pumpkin-core/src/block/blocks/create_belt.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/blocks/create_belt.rs
@@ -0,0 +1,367 @@
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
+};
+
+use create_engine::{
+    kinetics::{Axis, Kind, Node, Pos},
+    placement::Direction,
+    transport::{self, Part, Pulley, Slope, Space},
+};
+use pumpkin_data::{
+    Block, BlockStateId, data_component::DataComponent, data_component_impl::CustomDataImpl,
+    item_stack::ItemStack,
+};
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::{GameMode, math::position::BlockPos};
+use pumpkin_world::world::BlockFlags;
+
+use super::create_pipe::{boolean, property, with_property};
+use crate::{
+    block::entities::create_kinetic,
+    entity::{EntityBase, player::Player},
+    world::World,
+};
+
+pub(crate) const ID: &str = "create:belt";
+const SHAFT: &str = "create:shaft";
+const CONNECTOR: &str = "create:belt_connector";
+const FIRST: &str = "create:belt_first_shaft";
+// Formation and cleanup must not inspect each other's partial block writes.
+static TOPOLOGY: Mutex<()> = Mutex::new(());
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct Segment {
+    pub controller: Pos,
+    pub length: i32,
+    pub index: i32,
+}
+
+impl Segment {
+    pub(crate) fn read(tag: &NbtCompound) -> Option<Self> {
+        let NbtTag::IntArray(controller) = tag.get("Controller")? else {
+            return None;
+        };
+        let length = tag.get_int("Length")?;
+        let index = tag.get_int("Index")?;
+        ((2..=20).contains(&length) && (0..length).contains(&index)).then_some(Self {
+            controller: controller.as_slice().try_into().ok()?,
+            length,
+            index,
+        })
+    }
+
+    pub(crate) fn write(self, tag: &mut NbtCompound) {
+        tag.put("Controller", NbtTag::IntArray(self.controller.to_vec()));
+        tag.put_bool("IsController", self.index == 0);
+        tag.put_int("Length", self.length);
+        tag.put_int("Index", self.index);
+        tag.put_string("Casing", "NONE".into());
+        tag.put_bool("Covered", false);
+        tag.put_byte("Dye", 0);
+    }
+
+    pub(crate) fn node(self, pos: Pos, state: BlockStateId) -> Option<Node> {
+        let facing = facing(state)?;
+        let slope = property(state, "slope")?;
+        Some(Node {
+            pos,
+            axis: axis(facing, slope),
+            kind: Kind::Belt {
+                controller: self.controller,
+                index: self.index,
+                pulley: property(state, "part")? != "middle",
+                diagonal: matches!(slope, "upward" | "downward"),
+            },
+        })
+    }
+}
+
+fn pos([x, y, z]: Pos) -> BlockPos {
+    BlockPos::new(x, y, z)
+}
+fn xyz(p: BlockPos) -> Pos {
+    [p.0.x, p.0.y, p.0.z]
+}
+
+fn facing(state: BlockStateId) -> Option<Direction> {
+    let name = property(state, "facing")?;
+    Direction::ALL.into_iter().find(|dir| dir.name() == name)
+}
+
+fn axis(facing: Direction, slope: &str) -> Axis {
+    if slope == "sideways" {
+        Axis::Y
+    } else if facing.axis() == Axis::X {
+        Axis::Z
+    } else {
+        Axis::X
+    }
+}
+
+fn shaft_axis(state: BlockStateId) -> Option<Axis> {
+    if state.to_block().name != SHAFT {
+        return None;
+    }
+    match property(state, "axis")? {
+        "x" => Some(Axis::X),
+        "y" => Some(Axis::Y),
+        "z" => Some(Axis::Z),
+        _ => None,
+    }
+}
+
+fn pulley(world: &World, p: BlockPos) -> Option<(Pulley, BlockStateId)> {
+    let state = world.get_block_state_id_if_loaded(&p)?;
+    Some((
+        Pulley {
+            pos: xyz(p),
+            axis: shaft_axis(state)?,
+            rpm: create_kinetic::rpm_at(world, &p)?,
+            loaded: true,
+            shaft: true,
+        },
+        state,
+    ))
+}
+
+fn wet(state: BlockStateId) -> bool {
+    state.to_block() == &Block::WATER || property(state, "waterlogged") == Some("true")
+}
+
+fn same_chunk(a: Pos, b: Pos) -> bool {
+    a[0] >> 4 == b[0] >> 4 && a[2] >> 4 == b[2] >> 4
+}
+
+fn form(
+    world: &Arc<World>,
+    player: &Player,
+    first: Pulley,
+    first_state: BlockStateId,
+    second: Pulley,
+    second_state: BlockStateId,
+) -> Option<()> {
+    // shortcut: one fully loaded chunk until deferred cross-chunk cleanup is supported.
+    if !same_chunk(first.pos, second.pos) {
+        return None;
+    }
+    let _guard = TOPOLOGY
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut states = HashMap::from([(first.pos, first_state), (second.pos, second_state)]);
+    let chain = transport::connect(first, second, transport::DEFAULT_MAX_LENGTH, |p| {
+        let Some(state) = world.get_block_state_id_if_loaded(&pos(p)) else {
+            return Space::Blocked;
+        };
+        states.insert(p, state);
+        if let Some(axis) = shaft_axis(state) {
+            Space::Shaft(axis)
+        } else if state.to_state().replaceable() && world.get_block_entity(&pos(p)).is_none() {
+            Space::Replaceable
+        } else {
+            Space::Blocked
+        }
+    })
+    .ok()?;
+    let belt = Block::from_registry_key(ID)?;
+    let slope = match chain.slope {
+        Slope::Horizontal => "horizontal",
+        Slope::Upward => "upward",
+        Slope::Downward => "downward",
+        Slope::Vertical => "vertical",
+        Slope::Sideways => "sideways",
+    };
+    let steps = chain
+        .segments
+        .into_iter()
+        .map(|s| {
+            let old = states[&s.pos];
+            let part = match s.part {
+                Part::Start => "start",
+                Part::Middle => "middle",
+                Part::End => "end",
+                Part::Pulley => "pulley",
+            };
+            let state = [
+                ("facing", chain.facing.name()),
+                ("slope", slope),
+                ("part", part),
+                ("casing", "false"),
+                ("waterlogged", boolean(wet(old))),
+            ]
+            .into_iter()
+            .fold(belt.default_state.id, |state, (key, value)| {
+                with_property(state, key, value)
+            });
+            (pos(s.pos), old, state)
+        })
+        .collect::<Vec<_>>();
+    if steps.iter().any(|(p, old, _)| {
+        world.is_in_spawn_protection(player, p)
+            || world.get_block_state_id_if_loaded(p) != Some(*old)
+    }) {
+        return None;
+    }
+    let flags = BlockFlags::NOTIFY_LISTENERS | BlockFlags::UPDATE_KNOWN_SHAPE;
+    let length = steps.len() as i32;
+    for (index, (p, old, state)) in steps.iter().enumerate() {
+        let changed = world
+            .set_block_state_if(p, *state, flags, |current| current == *old)
+            .is_some();
+        if !changed
+            || !create_kinetic::attach_belt(
+                world,
+                p,
+                Segment {
+                    controller: first.pos,
+                    length,
+                    index: index as i32,
+                },
+            )
+        {
+            for (p, old, state) in steps[..index + usize::from(changed)].iter().rev() {
+                world.set_block_state_if(p, *old, flags, |current| current == *state);
+            }
+            return None;
+        }
+    }
+    Some(())
+}
+
+pub(crate) fn interact(
+    world: &Arc<World>,
+    player: &Player,
+    target: BlockPos,
+    held: &mut ItemStack,
+) -> bool {
+    let mode = player.gamemode.load();
+    if held.get_item().registry_key != CONNECTOR
+        || held.is_empty()
+        || !matches!(mode, GameMode::Survival | GameMode::Creative)
+    {
+        return false;
+    }
+    if world.is_in_spawn_protection(player, &target) {
+        return true;
+    }
+    let mut data = held.custom_data_compound().cloned().unwrap_or_default();
+    if player.get_entity().is_sneaking() {
+        data.child_tags.remove(FIRST);
+    } else if let Some((target, target_state)) = pulley(world, target) {
+        let start = match data.get(FIRST) {
+            Some(NbtTag::IntArray(p)) => <Pos>::try_from(p.as_slice())
+                .ok()
+                .and_then(|p| pulley(world, pos(p))),
+            _ => None,
+        };
+        if let Some((start, start_state)) = start {
+            if form(world, player, start, start_state, target, target_state).is_none() {
+                return true;
+            }
+            data.child_tags.remove(FIRST);
+            if mode == GameMode::Survival {
+                held.decrement(1);
+            }
+        } else {
+            data.put(FIRST, NbtTag::IntArray(target.pos.to_vec()));
+        }
+    } else {
+        return true;
+    }
+    if data.is_empty() {
+        held.remove_data_component(DataComponent::CustomData);
+    } else {
+        held.set_data_component(CustomDataImpl::new(data));
+    }
+    true
+}
+
+pub(crate) fn maintain(
+    world: &Arc<World>,
+    position: &BlockPos,
+    state: BlockStateId,
+    segment: Segment,
+) {
+    let Some(facing) = facing(state) else { return };
+    let Some(slope) = property(state, "slope") else {
+        return;
+    };
+    let mut step = facing.vector();
+    step[1] = match slope {
+        "upward" => 1,
+        "downward" => -1,
+        _ => 0,
+    };
+    if slope == "vertical" {
+        step = [0, if step.contains(&-1) { -1 } else { 1 }, 0];
+    }
+    let at = |index| {
+        let p = std::array::from_fn(|i| segment.controller[i].saturating_add(step[i] * index));
+        same_chunk(p, segment.controller).then(|| pos(p))
+    };
+    if at(segment.index).as_ref() != Some(position) {
+        return;
+    }
+    let Ok(_guard) = TOPOLOGY.try_lock() else {
+        return;
+    };
+    let Some(found) = (0..segment.length)
+        .map(|index| {
+            let p = at(index)?;
+            let state = world.get_block_state_id_if_loaded(&p)?;
+            let owned = state.to_block().name == ID
+                && create_kinetic::belt_at(world, &p)
+                    .is_some_and(|other| other == (Segment { index, ..segment }));
+            Some((p, state, owned))
+        })
+        .collect::<Option<Vec<_>>>()
+    else {
+        return;
+    };
+    if found.iter().all(|(_, _, owned)| *owned) {
+        return;
+    }
+    let Some(shaft) = Block::from_registry_key(SHAFT) else {
+        return;
+    };
+    let axis_name = match axis(facing, slope) {
+        Axis::X => "x",
+        Axis::Y => "y",
+        Axis::Z => "z",
+    };
+    for (p, old, owned) in found {
+        if !owned {
+            continue;
+        }
+        let next = if property(old, "part") == Some("middle") {
+            if wet(old) {
+                Block::WATER.default_state.id
+            } else {
+                Block::AIR.default_state.id
+            }
+        } else {
+            let state = with_property(shaft.default_state.id, "axis", axis_name);
+            with_property(state, "waterlogged", boolean(wet(old)))
+        };
+        world.set_block_state_if(&p, next, BlockFlags::NOTIFY_ALL, |current| current == old);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn belt_nbt_rejects_bad_indices_and_preserves_controller() {
+        let segment = Segment {
+            controller: [-271, 78, -110],
+            length: 4,
+            index: 3,
+        };
+        let mut tag = NbtCompound::new();
+        segment.write(&mut tag);
+        assert_eq!(Segment::read(&tag), Some(segment));
+        tag.put_int("Index", 4);
+        assert_eq!(Segment::read(&tag), None);
+    }
+}
