+pub(crate) fn rpm_at(world: &World, pos: &BlockPos) -> Option<f32> {
+    Some(
+        world
+            .get_block_entity(pos)?
+            .as_any()
+            .downcast_ref::<CreateKinetic>()?
+            .rpm(),
+    )
+}
+
+pub(crate) fn belt_at(world: &World, pos: &BlockPos) -> Option<belt::Segment> {
+    let e = world.get_block_entity(pos)?;
+    let kinetic = e.as_any().downcast_ref::<CreateKinetic>()?;
+    *kinetic
+        .belt
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+pub(crate) fn attach_belt(world: &World, pos: &BlockPos, segment: belt::Segment) -> bool {
+    let Some(entity) = world.get_block_entity(pos) else {
+        return false;
+    };
+    let Some(kinetic) = entity
+        .as_any()
+        .downcast_ref::<CreateKinetic>()
+        .filter(|k| k.id == belt::ID)
+    else {
+        return false;
+    };
+    *kinetic
+        .belt
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(segment);
+    world.update_block_entity(&entity);
+    true
 }
 
