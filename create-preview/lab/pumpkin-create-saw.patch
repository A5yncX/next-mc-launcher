diff --git a/crates/pumpkin-core/src/block/entities/create_saw_tree.rs b/crates/pumpkin-core/src/block/entities/create_saw_tree.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_saw_tree.rs
@@ -0,0 +1,177 @@
+use std::{collections::HashMap, sync::Arc};
+
+use create_engine::contraption::actors::saw::{Material, Target, TreeBlock, TreeStem, find_tree};
+use pumpkin_data::{Block, BlockStateId, tag::Taggable};
+use pumpkin_util::math::position::BlockPos;
+
+use crate::world::World;
+
+pub(super) const ID: &str = "create:mechanical_saw";
+const TREE_SEARCH_LIMIT: usize = 16_384;
+
+pub(super) fn is_sawable(id: BlockStateId) -> bool {
+    let block = Block::from_state_id(id);
+    if block.name.contains(':') && !block.name.starts_with("minecraft:") {
+        return false;
+    }
+    let material = if block == &Block::PUMPKIN || block == &Block::MELON {
+        Material::PumpkinOrMelon
+    } else if block == &Block::CHORUS_PLANT {
+        Material::ChorusPlant
+    } else if block.is_tagged_with("minecraft:leaves") == Some(true) {
+        Material::Leaves
+    } else {
+        match tree_block(id).stem {
+            TreeStem::Log | TreeStem::Root => Material::LogOrRoot,
+            TreeStem::VerticalPlant => Material::VerticalPlant,
+            _ => Material::Other,
+        }
+    };
+    Target {
+        material,
+        hardness: id.to_state().hardness,
+        excluded: block.is_tagged_with("minecraft:saplings") == Some(true)
+            || block.is_tagged_with("create:non_breakable") == Some(true),
+    }
+    .is_sawable()
+}
+
+/// Fell the Create tree plan after the caller has successfully broken its root.
+/// `broken_state` must be the root's state from immediately before that break.
+pub(crate) fn fell_tree_after_stationary_saw_break(
+    world: &Arc<World>,
+    root: BlockPos,
+    broken_state: BlockStateId,
+) {
+    let origin = [root.0.x, root.0.y, root.0.z];
+    let mut snapshots = HashMap::new();
+    let Ok(tree) = find_tree(
+        origin,
+        tree_block(broken_state),
+        u32::try_from(world.dimension.height).unwrap_or_default(),
+        TREE_SEARCH_LIMIT,
+        |cell| {
+            if !world.is_in_height_limit(cell[1]) {
+                return Some(TreeBlock::default());
+            }
+            let position = block_pos(cell);
+            let state = world.get_block_state_id_if_loaded(&position)?;
+            snapshots.insert(cell, state);
+            Some(tree_block(state))
+        },
+    ) else {
+        return;
+    };
+
+    // Keep only the exact states the planner assigned to this tree; guarded breaks
+    // then prevent a later replacement from being mistaken for a tree member.
+    let planned: Vec<_> = tree
+        .actions()
+        .filter_map(|(_, cell)| {
+            let expected = snapshots.get(&cell).copied()?;
+            let position = block_pos(cell);
+            if world.get_block_state_id_if_loaded(&position) != Some(expected)
+                || expected.to_state().block_entity_type != u16::MAX
+                || world.get_block_entity(&position).is_some()
+            {
+                return None;
+            }
+            Some((position, expected))
+        })
+        .collect();
+
+    for (position, expected) in planned {
+        world.break_machine_target(&position, expected);
+    }
+}
+
+fn tree_block(state: BlockStateId) -> TreeBlock {
+    let block = Block::from_state_id(state);
+    let name = match block.name.strip_prefix("minecraft:") {
+        Some(name) => name,
+        None if !block.name.contains(':') => block.name,
+        None => return TreeBlock::default(),
+    };
+
+    let stem = match name {
+        "mangrove_roots" => TreeStem::Root,
+        "mushroom_stem" => TreeStem::Log,
+        "bamboo" | "cactus" | "sugar_cane" | "kelp" | "kelp_plant" => TreeStem::VerticalPlant,
+        "chorus_plant" | "chorus_flower" => TreeStem::Chorus,
+        _ if block.is_tagged_with("minecraft:logs") == Some(true) => TreeStem::Log,
+        _ => TreeStem::None,
+    };
+    let attachment = matches!(
+        name,
+        "bee_nest" | "cocoa" | "mangrove_propagule" | "moss_carpet" | "shroomlight" | "vine"
+    ) || block.is_tagged_with("create:tree_attachments") == Some(true);
+    let nondecaying_leaf_radius = match name {
+        "red_mushroom_block" => Some(2),
+        "brown_mushroom_block" | "weeping_vines" | "weeping_vines_plant" => Some(3),
+        _ if block.is_tagged_with("minecraft:wart_blocks") == Some(true) => Some(3),
+        _ => None,
+    };
+    let leaf_distance = if name == "scaffolding" {
+        None
+    } else {
+        block.properties(state).and_then(|properties| {
+            properties.to_props().into_iter().find_map(|property| {
+                (property.key_str() == "distance")
+                    .then(|| property.value_str().parse().ok())
+                    .flatten()
+            })
+        })
+    };
+
+    TreeBlock {
+        stem,
+        leaf_distance,
+        nondecaying_leaf_radius,
+        attachment,
+    }
+}
+
+fn block_pos([x, y, z]: [i32; 3]) -> BlockPos {
+    BlockPos::new(x, y, z)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn maps_vanilla_tree_stems_attachments_and_special_leaves() {
+        assert_eq!(
+            tree_block(Block::OAK_LOG.default_state.id).stem,
+            TreeStem::Log
+        );
+        assert_eq!(
+            tree_block(Block::MUSHROOM_STEM.default_state.id).stem,
+            TreeStem::Log
+        );
+        assert_eq!(
+            tree_block(Block::BAMBOO.default_state.id).stem,
+            TreeStem::VerticalPlant
+        );
+        assert_eq!(
+            tree_block(Block::CHORUS_FLOWER.default_state.id).stem,
+            TreeStem::Chorus
+        );
+        assert!(tree_block(Block::COCOA.default_state.id).attachment);
+        assert!(is_sawable(Block::OAK_LOG.default_state.id));
+        assert!(!is_sawable(Block::STONE.default_state.id));
+        assert!(!is_sawable(Block::OAK_SAPLING.default_state.id));
+        assert_eq!(
+            tree_block(Block::RED_MUSHROOM_BLOCK.default_state.id).nondecaying_leaf_radius,
+            Some(2)
+        );
+        assert_eq!(
+            tree_block(Block::BROWN_MUSHROOM_BLOCK.default_state.id).nondecaying_leaf_radius,
+            Some(3)
+        );
+        assert_eq!(
+            tree_block(Block::SCAFFOLDING.default_state.id).leaf_distance,
+            None
+        );
+    }
+}
