+++ b/crates/pumpkin-core/src/block/blocks/create_actuator.rs
@@ -0,0 +1,119 @@
+use std::sync::Arc;
+
+use create_engine::{kinetics::Axis, placement::Direction};
+use pumpkin_data::{Block, BlockDirection, BlockStateId, item::Item, item_stack::ItemStack};
+use pumpkin_util::{GameMode, math::position::BlockPos};
+use pumpkin_world::world::BlockFlags;
+
+use super::{
+    create_pipe::{property, with_property},
+    create_pump::front,
+};
+use crate::{
+    block::registry::BlockRegistry,
+    entity::{EntityBase, player::Player},
+    world::World,
+};
+
+pub(crate) const PISTON: &str = "create:mechanical_piston";
+pub(crate) const STICKY: &str = "create:sticky_mechanical_piston";
+pub(crate) const POLE: &str = "create:piston_extension_pole";
+pub(crate) const PULLEY: &str = "create:rope_pulley";
+
+fn sticky(state: BlockStateId) -> Option<BlockStateId> {
+    let target = Block::from_registry_key(STICKY)?;
+    let mut next = target.default_state.id;
+    for key in ["facing", "axis_along_first", "state"] {
+        next = with_property(next, key, property(state, key)?);
+    }
+    Some(next)
+}
+
+fn rotate(state: BlockStateId, facing: Direction, face: Direction) -> BlockStateId {
+    let axis = face.axis();
+    let mut updated = state;
+    if facing.axis() != axis {
+        updated = with_property(updated, "facing", facing.clockwise(axis).name());
+    }
+    if facing.axis() == axis || axis == Axis::Y {
+        let first = property(state, "axis_along_first") == Some("true");
+        updated = with_property(
+            updated,
+            "axis_along_first",
+            if first { "false" } else { "true" },
+        );
+    }
+    updated
+}
+
+pub(crate) fn interact(
+    world: &Arc<World>,
+    player: &Player,
+    pos: BlockPos,
+    face: BlockDirection,
+    item: &mut ItemStack,
+) -> bool {
+    let mode = player.gamemode.load();
+    if !matches!(mode, GameMode::Survival | GameMode::Creative)
+        || player.get_entity().is_sneaking()
+        || world.is_in_spawn_protection(player, &pos)
+    {
+        return false;
+    }
+    let Some(state) = world.get_block_state_id_if_loaded(&pos) else {
+        return false;
+    };
+    if !matches!(state.to_block().name, PISTON | STICKY)
+        || property(state, "state") != Some("retracted")
+    {
+        return false;
+    }
+    let Some(facing) = front(state) else {
+        return false;
+    };
+    let face = BlockRegistry::create_direction(face);
+    let next = if item.item.registry_key == "create:wrench" {
+        rotate(state, facing, face)
+    } else if state.to_block().name == PISTON && item.item == &Item::SLIME_BALL && face == facing {
+        let Some(next) = sticky(state) else {
+            return false;
+        };
+        next
+    } else {
+        return false;
+    };
+    if world
+        .set_block_state_if(&pos, next, BlockFlags::NOTIFY_ALL, |old| old == state)
+        .is_some()
+        && next.to_block().name != state.to_block().name
+        && mode == GameMode::Survival
+    {
+        item.decrement(1);
+    }
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sticky_and_wrench_keep_the_pinned_directional_state() {
+        let base = Block::from_registry_key(PISTON).unwrap().default_state.id;
+        let base = with_property(
+            with_property(base, "facing", "north"),
+            "axis_along_first",
+            "true",
+        );
+        let converted = sticky(base).unwrap();
+        assert_eq!(converted.to_block().name, STICKY);
+        assert_eq!(property(converted, "facing"), Some("north"));
+        assert_eq!(property(converted, "axis_along_first"), Some("true"));
+        let axial = rotate(converted, Direction::North, Direction::North);
+        assert_eq!(property(axial, "facing"), Some("north"));
+        assert_eq!(property(axial, "axis_along_first"), Some("false"));
+        let top = rotate(converted, Direction::North, Direction::Up);
+        assert_eq!(property(top, "facing"), Some("east"));
+        assert_eq!(property(top, "axis_along_first"), Some("false"));
+    }
+}
