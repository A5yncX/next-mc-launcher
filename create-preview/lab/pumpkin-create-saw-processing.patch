+#[cfg(test)]
+mod tests {
+    use super::{SawOutput, SawProcessing, SawRecipe};
+    use pumpkin_data::{item::Item, item_stack::ItemStack};
+    use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+
+    fn stack(item: &str, count: u8) -> ItemStack {
+        ItemStack::new(
+            count,
+            Item::from_registry_key(item).expect("test item is registered"),
+        )
+    }
+
+    fn recipe(output: ItemStack, duration: u32) -> SawRecipe {
+        SawRecipe {
+            duration,
+            outputs: vec![SawOutput {
+                stack: output,
+                chance: 1.0,
+            }],
+            remainder: None,
+        }
+    }
+
+    #[test]
+    fn dropped_intake_requires_power_and_upward_facing_and_takes_one() {
+        let recipes = [recipe(stack("minecraft:oak_planks", 1), 50)];
+        let mut saw = SawProcessing::default();
+        let mut dropped = stack("minecraft:oak_log", 2);
+
+        assert_eq!(
+            saw.insert_dropped_item(&mut dropped, 0.0, true, false, &recipes),
+            0
+        );
+        assert_eq!(
+            saw.insert_dropped_item(&mut dropped, 64.0, false, false, &recipes),
+            0
+        );
+        assert_eq!(
+            saw.insert_dropped_item(&mut dropped, 64.0, true, true, &recipes),
+            0
+        );
+        assert_eq!(
+            saw.insert_dropped_item(&mut dropped, 64.0, true, false, &recipes),
+            1
+        );
+        assert_eq!(dropped.item_count, 1);
+        assert_eq!(saw.items[0].item_count, 1);
+        assert_eq!(saw.cycle.remaining, 50.0);
+    }
+
+    #[test]
+    fn filter_selects_first_output_and_invalid_filter_disables_intake() {
+        let mut nbt = NbtCompound::new();
+        let mut filter = NbtCompound::new();
+        stack("minecraft:oak_planks", 1).write_item_stack(&mut filter);
+        nbt.put_compound("Filter", filter);
+        let mut saw = SawProcessing::from_nbt(&nbt);
+        let recipes = [
+            recipe(stack("minecraft:diamond", 1), 1),
+            recipe(stack("minecraft:oak_planks", 1), 50),
+        ];
+        let mut dropped = stack("minecraft:oak_log", 1);
+        assert_eq!(
+            saw.insert_dropped_item(&mut dropped, 64.0, true, false, &recipes),
+            1
+        );
+        assert_eq!(saw.cycle.duration, 50.0);
+
+        let mut invalid_nbt = NbtCompound::new();
+        invalid_nbt.put_int("Filter", 1);
+        let mut disabled = SawProcessing::from_nbt(&invalid_nbt);
+        let mut dropped = stack("minecraft:stone", 1);
+        assert_eq!(
+            disabled.insert_dropped_item(&mut dropped, 64.0, true, false, &recipes),
+            0
+        );
+    }
+
+    #[test]
+    fn powered_cycle_pauses_without_rpm_then_cuts_and_exports() {
+        let recipes = [recipe(stack("minecraft:oak_planks", 1), 1)];
+        let mut saw = SawProcessing::default();
+        let mut dropped = stack("minecraft:oak_log", 1);
+        assert_eq!(
+            saw.insert_dropped_item(&mut dropped, 64.0, true, false, &recipes),
+            1
+        );
+        let before = saw.cycle;
+
+        assert!(!saw.tick(
+            true,
+            0.0,
+            &recipes,
+            || panic!("unpowered saw rolled"),
+            |_| 0
+        ));
+        assert_eq!(saw.cycle, before);
+        assert!(saw.tick(true, 128.0, &recipes, || 0.5, |_| 0));
+        assert!(saw.items[0].is_empty());
+        assert_eq!(
+            saw.items[1].get_item(),
+            Item::from_registry_key("minecraft:oak_planks").unwrap()
+        );
+        assert!(saw.cycle.applied);
+
+        for _ in 0..3 {
+            assert!(saw.tick(true, 128.0, &recipes, || 0.5, |_| 0));
+        }
+        let mut exported = 0;
+        assert!(saw.tick(
+            true,
+            128.0,
+            &recipes,
+            || 0.5,
+            |item| {
+                exported += u32::from(item.item_count);
+                item.item_count
+            }
+        ));
+        assert_eq!(exported, 1);
+        assert!(saw.items.iter().all(ItemStack::is_empty));
+        assert_eq!(saw.cycle.remaining, -1.0);
+    }
+
+    #[test]
+    fn outputs_larger_than_one_stack_are_split_without_loss() {
+        let recipes = [recipe(stack("minecraft:diamond", u8::MAX), 1)];
+        let mut saw = SawProcessing::default();
+        let mut dropped = stack("minecraft:stone", 1);
+        saw.insert_dropped_item(&mut dropped, 64.0, true, false, &recipes);
+
+        assert!(saw.tick(true, 128.0, &recipes, || 0.5, |_| 0));
+        let outputs = &saw.items[1..];
+        assert_eq!(
+            outputs
+                .iter()
+                .map(|item| u32::from(item.item_count))
+                .sum::<u32>(),
+            255
+        );
+        assert!(
+            outputs
+                .iter()
+                .filter(|item| !item.is_empty())
+                .all(|item| { item.item_count <= item.get_max_stack_size() })
+        );
+        assert_eq!(outputs.iter().filter(|item| !item.is_empty()).count(), 4);
+    }
+
+    #[test]
+    fn full_incompatible_outputs_keep_the_input_for_a_later_retry() {
+        let recipes = [recipe(stack("minecraft:diamond", 1), 1)];
+        let mut saw = SawProcessing::default();
+        let mut dropped = stack("minecraft:stone", 1);
+        saw.insert_dropped_item(&mut dropped, 64.0, true, false, &recipes);
+        saw.items[1..].fill(stack("minecraft:stone", 64));
+
+        assert!(!saw.tick(
+            true,
+            128.0,
+            &recipes,
+            || panic!("blocked output rolled"),
+            |_| 0
+        ));
+        assert_eq!(saw.cycle.remaining, 1.0);
+        assert_eq!(saw.items[0].item_count, 1);
+        assert!(!saw.cycle.applied);
+        assert!(saw.items[1..].iter().all(|item| item.item_count == 64));
+    }
+
+    #[test]
+    fn nbt_round_trip_keeps_create_keys_and_unowned_fields() {
+        let recipes = [recipe(stack("minecraft:oak_planks", 1), 50)];
+        let mut saw = SawProcessing::default();
+        let mut dropped = stack("minecraft:oak_log", 1);
+        saw.insert_dropped_item(&mut dropped, 64.0, true, false, &recipes);
+
+        let mut nbt = NbtCompound::new();
+        nbt.put("Filter", NbtTag::Compound(NbtCompound::new()));
+        nbt.put_int("FilterAmount", 64);
+        nbt.put_byte("UpTo", 1);
+        nbt.put_string("ForeignKey", "keep-me".to_owned());
+        saw.write_nbt(&mut nbt);
+
+        let restored = SawProcessing::from_nbt(&nbt);
+        let mut rewritten = nbt.clone();
+        restored.write_nbt(&mut rewritten);
+        assert_eq!(rewritten.get_int("RecipeIndex"), Some(0));
+        assert_eq!(rewritten.get_int("FilterAmount"), Some(64));
+        assert_eq!(rewritten.get_byte("UpTo"), Some(1));
+        assert_eq!(rewritten.get_string("ForeignKey"), Some("keep-me"));
+        assert_eq!(rewritten.get("Filter"), nbt.get("Filter"));
+        assert_eq!(restored.filter_nbt(), nbt.get("Filter"));
+        let mut serialized = NbtCompound::new();
+        restored.write_nbt(&mut serialized);
+        assert_eq!(serialized.get("Filter"), nbt.get("Filter"));
+        assert_eq!(serialized.get_int("FilterAmount"), Some(64));
+        assert_eq!(serialized.get_byte("UpTo"), Some(1));
+        let inventory = serialized.get_compound("Inventory").unwrap();
+        assert_eq!(inventory.get_int("Size"), Some(32));
+        assert_eq!(inventory.get_float("ProcessingTime"), Some(50.0));
+        assert_eq!(inventory.get_float("RecipeTime"), Some(50.0));
+        assert_eq!(inventory.get_byte("AppliedRecipe"), Some(0));
+        let NbtTag::List(items) = inventory.get("Items").unwrap() else {
+            panic!("saw inventory items must be a list");
+        };
+        assert_eq!(items.len(), 1);
+        assert_eq!(
+            items[0].extract_compound().unwrap().get_int("Slot"),
+            Some(0)
+        );
+    }
+
+    #[test]
+    fn malformed_inventory_is_preserved_and_disabled() {
+        let mut malformed = NbtCompound::new();
+        let mut inventory = NbtCompound::new();
+        inventory.put_int("Size", 31);
+        malformed.put_compound("Inventory", inventory);
+        let saw = SawProcessing::from_nbt(&malformed);
+        assert!(!saw.is_supported());
+
+        let mut rewritten = NbtCompound::new();
+        saw.write_nbt(&mut rewritten);
+        assert_eq!(rewritten.get("Inventory"), malformed.get("Inventory"));
+    }
