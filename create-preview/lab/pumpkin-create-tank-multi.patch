+pub(crate) fn toggle_window(tank: &CreateFluidTank) {
+    let mut nbt = tank.nbt.lock().unwrap_or_else(PoisonError::into_inner);
+    if let Some(value @ (0 | 1)) = nbt.get_byte("Window") {
+        nbt.put_byte("Window", 1 - value);
+        tank.dirty.store(true, Ordering::Relaxed);
+    }
+}
+
+pub(crate) fn sync(world: &Arc<World>, be: &Arc<dyn BlockEntity>, comparator: bool) {
+    let guard = topology();
+    let mut signals = Vec::new();
+    if !entity(world, be.get_position()).is_some_and(|live| Arc::ptr_eq(be, &live)) {
+        return;
+    }
+    if let Some(record) = be
+        .as_any()
+        .downcast_ref::<CreateFluidTank>()
+        .and_then(CreateFluidTank::contents)
+    {
+        for point in record.tank.parts() {
+            let at = pos(point);
+            let Some(part) = entity(world, at) else {
+                continue;
+            };
+            let Some(tank) = part.as_any().downcast_ref::<CreateFluidTank>() else {
+                continue;
+            };
+            if tank.root() != Some(be.get_position()) {
+                continue;
+            }
+            let changed = {
+                let mut nbt = tank.nbt.lock().unwrap_or_else(PoisonError::into_inner);
+                let luminosity = record.luminosity(point);
+                let changed = nbt.get_int("Luminosity") != Some(luminosity);
+                if changed {
+                    nbt.put_int("Luminosity", luminosity);
+                }
+                changed
+            };
+            if changed || comparator {
+                part_layout(world, at, record);
+            }
+            if changed || at == be.get_position() {
+                world.update_block_entity(&part);
+            }
+            if comparator {
+                signals.push(at);
+            }
+        }
+    } else {
+        world.update_block_entity(be);
+    }
+    drop(guard);
+    for at in signals {
+        let block = world.get_block(&at);
+        if block.name == ID {
+            world.update_neighbour_for_output_signal(&at, block);
+        }
+    }
+}
