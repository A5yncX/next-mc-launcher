+impl Contents {
+    fn luminosity(self, at: [i32; 3]) -> i32 {
+        if self.amount == 0 || self.fluid != "minecraft:lava" {
+            return 0;
+        }
+        let layers =
+            self.amount as f32 / self.tank.capacity() as f32 * self.tank.height() as f32 + 1.0;
