+fn merge(world: &Arc<World>, at: BlockPos) -> Vec<Arc<dyn BlockEntity>> {
+    let _guard = topology();
+    let Some(base) = controller(world, at).filter(|entity| entity.get_position() == at) else {
+        return Vec::new();
+    };
+    let Some(record) = base
+        .as_any()
+        .downcast_ref::<CreateFluidTank>()
+        .and_then(CreateFluidTank::contents)
+    else {
+        return Vec::new();
+    };
+    let mut seen = std::collections::HashMap::new();
+    let Some(geometry) = largest(record.tank.root, DEFAULT_MAX_HEIGHT, |p| {
+        let point = pos(p);
+        // shortcut: keep every member in one chunk until cross-chunk teardown is durable.
+        if point.chunk_position() != at.chunk_position() {
+            return None;
+        }
+        let root = controller(world, point)?;
+        let root_pos = root.get_position();
+        let contents = *seen.entry(root_pos).or_insert(
+            root.as_any()
+                .downcast_ref::<CreateFluidTank>()?
+                .contents()?,
+        );
+        Some((
+            contents.tank,
+            (contents.amount > 0).then_some(contents.fluid),
+        ))
+    })
+    .filter(|geometry| *geometry != record.tank) else {
+        return Vec::new();
+    };
+    let Some(parts) = geometry
+        .parts()
+        .map(|p| entity(world, pos(p)))
+        .collect::<Option<Vec<_>>>()
+    else {
+        return Vec::new();
+    };
+    let mut assembled = Contents {
+        tank: geometry,
+        amount: 0,
+        ..record
+    };
+    for source in seen
+        .values()
+        .filter(|source| geometry.contains(source.tank.root))
+    {
+        if source.amount > 0 {
+            if assembled.amount > 0 && source.fluid != assembled.fluid {
+                return Vec::new();
+            }
+            assembled.fluid = source.fluid;
+            assembled.amount += source.amount;
+        }
+    }
+    if assembled.amount > assembled.tank.capacity() as i32 {
+        return Vec::new();
+    }
+    for part in &parts {
+        if let Some(tank) = part.as_any().downcast_ref::<CreateFluidTank>() {
+            tank.write_part(assembled);
+        }
+        part_layout(world, part.get_position(), assembled);
+    }
+    parts
+}
