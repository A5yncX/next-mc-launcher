+fn split(world: &Arc<World>, removed: &CreateFluidTank) -> Vec<Arc<dyn BlockEntity>> {
+    let _guard = topology();
+    let Some(at) = removed.root() else {
+        return Vec::new();
+    };
+    let root_entity = if at == removed.position {
+        None
+    } else {
+        entity(world, at)
+    };
+    let root = if at == removed.position {
+        removed
+    } else if let Some(root) = root_entity
+        .as_ref()
+        .and_then(|be| be.as_any().downcast_ref::<CreateFluidTank>())
+    {
+        root
+    } else {
+        return Vec::new();
+    };
+    let Some(record) = root.contents().filter(|record| {
+        record.tank.volume() > 1 && record.tank.contains(coords(removed.position))
+    }) else {
+        return Vec::new();
+    };
+    let mut parts = std::collections::HashMap::new();
+    let amounts = record
+        .tank
+        .split(record.amount as u32, CAPACITY as u32, |p| {
+            let point = pos(p);
+            if point == removed.position {
+                return false;
+            }
+            let Some(part) = entity(world, point) else {
+                return false;
+            };
+            if part
+                .as_any()
+                .downcast_ref::<CreateFluidTank>()
+                .and_then(CreateFluidTank::root)
+                != Some(at)
+            {
+                return false;
+            }
+            parts.insert(point, part);
+            true
+        });
+    let mut changed = Vec::with_capacity(parts.len());
+    for (p, amount) in amounts {
+        let Some(part) = parts.remove(&pos(p)) else {
+            continue;
+        };
+        let single = Contents {
+            tank: Tank::single(p),
+            amount: amount as i32,
+            ..record
+        };
+        if let Some(tank) = part.as_any().downcast_ref::<CreateFluidTank>() {
+            tank.write_part(single);
+        }
+        part_layout(world, pos(p), single);
+        changed.push(part);
+    }
+    changed
+}
