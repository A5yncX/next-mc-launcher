+fn part_layout(world: &Arc<World>, at: BlockPos, record: Contents) {
+    let Some(state) = world.get_block_state_id_if_loaded(&at) else {
+        return;
+    };
+    let block = state.to_block();
+    if block.name != ID {
+        return;
+    }
+    let Some(props) = block.properties(state) else {
+        return;
+    };
+    let mut props = props.to_props();
+    let p = coords(at);
+    let mask = record.tank.horizontal_mask(p).to_string();
+    for prop in &mut props {
+        let value = match prop.key_str() {
+            "bottom" => {
+                if record.tank.bottom(p) {
+                    "true"
+                } else {
+                    "false"
+                }
+            }
+            "top" => {
+                if record.tank.top(p) {
+                    "true"
+                } else {
+                    "false"
+                }
+            }
+            "shape" => record.tank.shape(p, record.window),
+            "create_connections" => &mask,
+            "create_light" => match (record.window, record.luminosity(p)) {
+                (true, 12) => "12",
+                (true, 1) => "1",
+                _ => "0",
+            },
+            _ => continue,
+        };
+        if let Some(new) = Property::from_str_pair(prop.key_str(), value) {
+            *prop = new;
+        }
+    }
+    if let Some(next) = block
+        .state_from_properties(&props)
+        .filter(|next| next.id != state)
+    {
+        world.set_block_state_if(
+            &at,
+            next.id,
+            BlockFlags::NOTIFY_LISTENERS | BlockFlags::UPDATE_KNOWN_SHAPE,
+            |current| current == state,
+        );
+    }
+}
