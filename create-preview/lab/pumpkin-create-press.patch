diff --git a/crates/pumpkin-core/src/block/entities/create_press.rs b/crates/pumpkin-core/src/block/entities/create_press.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_press.rs
@@ -0,0 +1,106 @@
+use std::sync::{Arc, PoisonError};
+
+use create_engine::pressing::{Action, PressCycle};
+use pumpkin_data::{item::Item, item_stack::ItemStack};
+use pumpkin_inventory::Inventory;
+use pumpkin_util::math::position::BlockPos;
+
+use super::create_depot::CreateDepotBlockEntity;
+use crate::world::World;
+
+pub(crate) const ID: &str = "create:mechanical_press";
+
+// shortcut: pinned recipes have singleton input tags, load recipe packs when custom processing is supported.
+fn result(stack: &ItemStack) -> Option<&'static Item> {
+    if stack.is_empty() {
+        return None;
+    }
+    Some(match stack.get_item().registry_key {
+        "iron_ingot" => &Item::CREATE_IRON_SHEET,
+        "gold_ingot" => &Item::CREATE_GOLDEN_SHEET,
+        "copper_ingot" => &Item::CREATE_COPPER_SHEET,
+        "create:brass_ingot" => &Item::CREATE_BRASS_SHEET,
+        _ => return None,
+    })
+}
+
+// shortcut: process the depot path first; loose entities, belts and basins need their own ownership hooks.
+pub(super) fn tick(cycle: &mut PressCycle, world: &Arc<World>, pos: BlockPos, rpm: f32) -> Action {
+    let gap = BlockPos::new(pos.0.x, pos.0.y - 1, pos.0.z);
+    let target = BlockPos::new(pos.0.x, pos.0.y - 2, pos.0.z);
+    let entity = world.get_block_entity(&target).filter(|_| {
+        world.get_block_state_id_if_loaded(&gap).is_some_and(|id| {
+            id.to_state()
+                .get_block_collision_shapes_at(&gap)
+                .next()
+                .is_none()
+        })
+    });
+    let depot = entity.as_ref().and_then(|entity| {
+        entity
+            .as_any()
+            .downcast_ref::<CreateDepotBlockEntity>()
+            .filter(|depot| depot.is_supported())
+    });
+    let action = cycle.tick(
+        rpm,
+        !cycle.running && depot.is_some_and(|d| result(&d.get_stack(0)).is_some()),
+    );
+    if action == Action::Press
+        && let (Some(depot), Some(entity)) = (depot, entity.as_ref())
+        && process(depot)
+    {
+        world.update_block_entity(entity);
+    }
+    action
+}
+
+fn process(depot: &CreateDepotBlockEntity) -> bool {
+    let mut items = depot.items.write().unwrap_or_else(PoisonError::into_inner);
+    let Some(result) = result(&items[0]) else {
+        return false;
+    };
+    let output = ItemStack::new(1, result);
+    if items[0].item_count == 1 {
+        items[0] = output;
+    } else {
+        let Some(slot) = items[1..].iter_mut().find(|slot| {
+            slot.is_empty()
+                || (slot.item_count < 64 && slot.are_items_and_components_equal(&output))
+        }) else {
+            return false;
+        };
+        if slot.is_empty() {
+            *slot = output;
+        } else {
+            slot.item_count += 1;
+        }
+        items[0].item_count -= 1;
+    }
+    depot.mark_dirty();
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_strike_converts_one_ingot_without_losing_items() {
+        let depot = CreateDepotBlockEntity::new(BlockPos::new(0, 0, 0));
+        depot.set_stack(0, ItemStack::new(2, &Item::IRON_INGOT));
+        for slot in 1..CreateDepotBlockEntity::INVENTORY_SIZE {
+            depot.set_stack(slot, ItemStack::new(64, &Item::STONE));
+        }
+        assert!(!process(&depot));
+        assert_eq!(depot.get_stack(0).item_count, 2);
+        depot.set_stack(1, ItemStack::EMPTY.clone());
+        assert!(process(&depot));
+        assert_eq!(depot.get_stack(0).get_item().id, Item::IRON_INGOT.id);
+        assert_eq!(depot.get_stack(0).item_count, 1);
+        assert_eq!(depot.get_stack(1).get_item().id, Item::CREATE_IRON_SHEET.id);
+        assert!(process(&depot));
+        assert_eq!(depot.get_stack(0).get_item().id, Item::CREATE_IRON_SHEET.id);
+        assert!(!process(&depot));
+    }
+}
