+    #[test]
+    fn restarted_belt_press_strikes_at_most_once() {
+        let pos = BlockPos::new(0, 80, 0);
+        let press = CreateKinetic::new(press::ID, pos);
+        press.readings.lock().unwrap().rpm = 32.0;
+        let input = ItemStack::new(2, &Item::IRON_INGOT);
+        assert_eq!(press.press_belt(&input, false).0, BeltDecision::Hold);
+        assert_eq!(press.press_belt(&input, true).0, BeltDecision::Hold);
+        assert!(press.press_belt(&input, true).1.is_none());
+        press.readings.lock().unwrap().press.applied = true;
+        let reload = |press: &CreateKinetic| {
+            let mut nbt = press.chunk_data_nbt().unwrap();
+            nbt.put_string("id", press::ID.to_owned());
+            CreateKinetic::from_nbt(&nbt, pos)
+        };
+        let resumed = reload(&press);
+        assert_eq!(
+            resumed.press_belt(&input, true).1.unwrap().id,
+            Item::CREATE_IRON_SHEET.id
+        );
+        let struck = reload(&resumed);
+        assert!(struck.press_belt(&input, true).1.is_none());
+    }
 
