+    fn press_belt(
+        &self,
+        input: &ItemStack,
+        held: bool,
+    ) -> (BeltDecision, Option<&'static Item>, bool) {
+        let mut r = self
+            .readings
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let rpm = r.rpm;
+        if self.id != press::ID || rpm == 0.0 {
+            return (BeltDecision::Pass, None, false);
+        }
+        if !held {
+            let entry =
+                pressing::belt_received(&mut r.press, rpm, || press::result(input).is_some());
+            if entry.started {
+                r.press_mode = PressMode::Belt;
+                r.press_belt = Some(false);
+            }
+            return (entry.decision, None, entry.started);
+        }
+        if !r.press.running {
+            return (BeltDecision::Pass, None, false);
+        }
+        // Either block entity may tick first; claim the strike only once after midpoint.
+        if r.press_belt == Some(false) && r.press.applied {
+            let result = press::result(input);
+            r.press_belt = Some(true);
+            return (
+                if result.is_some() {
+                    BeltDecision::Hold
+                } else {
+                    BeltDecision::Pass
+                },
+                result,
+                true,
+            );
+        }
+        (BeltDecision::Hold, None, false)
     }
 
