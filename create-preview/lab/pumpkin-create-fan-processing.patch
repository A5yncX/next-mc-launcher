+
+    pub(crate) fn apply_create_fan<F>(
+        &self,
+        kind: create_engine::fan::ProcessingType,
+        plan: impl FnOnce(&ItemStack) -> Option<F>,
+    ) where
+        F: FnOnce(u8) -> Option<Vec<ItemStack>>,
+    {
+        let mut input = self
+            .item_stack
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if input.is_empty() || !self.entity.is_alive() {
+            return;
+        }
+        let convert = plan(&input);
+        let mut processing = self
+            .fan_processing
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let count = input.item_count;
+        if !processing.dropped(
+            kind,
+            count.into(),
+            convert.is_some(),
+            create_engine::fan::Config::DEFAULT.processing_time,
+        ) {
+            return;
+        }
+        let Some(output) = convert.and_then(|convert| convert(count)) else {
+            return;
+        };
+        let mut output = output.into_iter();
+        *input = output.next().unwrap_or_else(|| ItemStack::EMPTY.clone());
+        let empty = input.is_empty();
+        if !empty {
+            Self::update_fire_immune(&self.entity, &input);
+        }
+        drop(processing);
+        drop(input);
+        if empty {
+            self.entity.remove();
+        } else {
+            self.on_count_changed();
+        }
+        let world = self.entity.world.load_full();
+        let position = self.entity.pos.load();
+        let velocity = self.entity.velocity.load();
+        for stack in output {
+            let entity = Entity::new(world.clone(), position, &EntityType::ITEM);
+            world.spawn_entity(Arc::new(Self::new_with_velocity(
+                entity,
+                stack,
+                velocity,
+                Self::DEFAULT_PICKUP_DELAY,
+            )));
+        }
     }
 
