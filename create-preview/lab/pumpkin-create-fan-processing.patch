+use super as airflow;
+use pumpkin_data::{Block, BlockStateId, Property};
+use pumpkin_util::math::position::BlockPos;
+
+fn state(name: &str, facing: Option<&str>) -> BlockStateId {
+    let block = Block::from_name(name).expect("pinned block registry entry");
+    let mut properties = block
+        .properties(block.default_state.id)
+        .map_or_else(Vec::new, |properties| properties.to_props());
+    if let Some(facing) = facing {
+        let property = properties
+            .iter_mut()
+            .find(|property| property.key_str() == "facing")
+            .expect("facing property");
+        *property = Property::from_str_pair("facing", facing).expect("valid facing");
+    }
+    block
+        .state_from_properties(&properties)
+        .expect("valid block state")
+        .id
+}
+
+#[test]
+fn engine_range_tracks_fan_direction_and_rpm_sign() {
+    let fan = state("create:encased_fan", Some("east"));
+    let air = state("minecraft:air", None);
+    let position = BlockPos::new(0, 80, 0);
+    let current = airflow::current(position, fan, 32.0, |_| Some(air)).expect("running fan");
+    assert_eq!(current.nominal_distance(), 5.125);
+    assert_eq!(current.reach(), 5.125);
+    assert!(current.pushing());
+    assert_eq!(current.flow(), [1, 0, 0]);
+    assert_eq!(current.bounds(), [[1.0, 80.0, 0.0], [6.125, 81.0, 1.0]]);
+
+    let reverse = airflow::current(position, fan, -32.0, |_| Some(air)).expect("reversed fan");
+    assert!(!reverse.pushing());
+    assert_eq!(reverse.flow(), [-1, 0, 0]);
+    assert_eq!(reverse.bounds(), current.bounds());
+
+    let west_facing = state("create:encased_fan", Some("west"));
+    let reversed_axis =
+        airflow::current(position, west_facing, 32.0, |_| Some(air)).expect("west-facing fan");
+    assert!(!reversed_axis.pushing());
+    assert_eq!(reversed_axis.flow(), [1, 0, 0]);
+}
+
+#[test]
+fn collision_shape_truncates_current_and_blocks_entities_beyond_it() {
+    let fan = state("create:encased_fan", Some("east"));
+    let air = state("minecraft:air", None);
+    let stone = state("minecraft:stone", None);
+    let position = BlockPos::new(0, 80, 0);
+    let current = airflow::current(position, fan, 32.0, |cell| {
+        Some(if cell.0.x == 3 { stone } else { air })
+    })
+    .expect("air path before the obstacle");
+
+    assert_eq!(current.reach(), 2.0);
+    let unloaded = airflow::current(position, fan, 32.0, |cell| (cell.0.x < 3).then_some(air))
+        .expect("known cells before an unloaded boundary");
+    assert_eq!(unloaded.reach(), 2.0);
+    assert!(current.affects([[2.0, 80.1, 0.1], [2.5, 80.9, 0.9]]));
+    assert!(!current.affects([[3.1, 80.1, 0.1], [3.5, 80.9, 0.9]]));
+
+    let moved = current
+        .velocity(
+            [[2.0, 80.1, 0.1], [2.5, 80.9, 0.9]],
+            [2.25, 80.0, 0.5],
+            [0.0; 3],
+            false,
+        )
+        .expect("entity inside the unobstructed current");
+    assert!(moved[0] > 0.0);
+    assert_eq!(&moved[1..], &[0.0, 0.0]);
+    assert!(
+        current
+            .velocity(
+                [[3.1, 80.1, 0.1], [3.5, 80.9, 0.9]],
+                [3.25, 80.0, 0.5],
+                [0.0; 3],
+                false,
+            )
+            .is_none()
+    );
+}
+
+#[test]
+fn medium_channels_match_pinned_recipes_and_keep_non_outputs() {
+    use airflow::{Item, ItemStack, ProcessingType::*, conversion, medium};
+    assert_eq!(medium(state("minecraft:water", None)), Some(Splashing));
+    assert_eq!(medium(state("minecraft:soul_fire", None)), Some(Haunting));
+    assert_eq!(medium(state("minecraft:fire", None)), Some(Smoking));
+    assert_eq!(medium(state("minecraft:lava", None)), Some(Blasting));
+    assert_eq!(medium(state("minecraft:stone", None)), None);
+    for (kind, input, expected) in [
+        (Splashing, &Item::ICE, &Item::PACKED_ICE),
+        (Haunting, &Item::COBBLESTONE, &Item::BLACKSTONE),
+        (Smoking, &Item::BEEF, &Item::COOKED_BEEF),
+        (Blasting, &Item::RAW_IRON, &Item::IRON_INGOT),
+    ] {
+        let output = conversion(&ItemStack::new(3, input), kind)
+            .unwrap()
+            .roll(3)
+            .unwrap();
+        assert_eq!(output.len(), 1);
+        assert_eq!(output[0].get_item(), expected);
+        assert_eq!(output[0].item_count, 3);
+    }
+    assert!(conversion(&ItemStack::new(1, &Item::BEEF), Blasting).is_none());
+    assert!(conversion(&ItemStack::new(1, &Item::ICE), Haunting).is_none());
+}
