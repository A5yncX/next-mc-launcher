+fn medium(state: BlockStateId) -> Option<ProcessingType> {
+    use crate::block::blocks::create_pipe::property;
+    use create_engine::burner::Heat;
+    let block = state.to_block();
+    let lit = property(state, "lit").map(|value| value == "true");
+    Medium {
+        fluid: [
+            block == &Block::LAVA,
+            false,
+            false,
+            block == &Block::WATER
+                || block == &Block::BUBBLE_COLUMN
+                || state.to_state().is_waterlogged(),
+        ],
+        block: [
+            block.has_tag(&BlockTags::CREATE_FAN_PROCESSING_CATALYSTS_BLASTING),
+            block.has_tag(&BlockTags::CREATE_FAN_PROCESSING_CATALYSTS_HAUNTING),
+            block.has_tag(&BlockTags::CREATE_FAN_PROCESSING_CATALYSTS_SMOKING),
+            false,
+        ],
+        campfire: block.has_tag(&BlockTags::MINECRAFT_CAMPFIRES),
+        lit,
+        flame_soul: property(state, "flame_type").map(|value| value == "soul"),
+        heat: property(state, "blaze").and_then(|state| {
+            Some(match state {
+                "none" => Heat::None,
+                "smouldering" => Heat::Smouldering,
+                "fading" => Heat::Fading,
