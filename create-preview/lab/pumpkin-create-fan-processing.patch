+#[derive(serde::Deserialize)]
+struct FanRecipes {
+    haunting: Vec<MillingRecipe>,
+    splashing: Vec<MillingRecipe>,
+}
+
+enum Conversion {
+    Recipe(&'static MillingRecipe),
+    Cooked(ItemStack),
+}
+
+impl Conversion {
+    fn roll(self, count: u8) -> Option<Vec<ItemStack>> {
+        match self {
+            Self::Recipe(recipe) => recipe.batch_outputs(count, rand::random::<f32>),
+            Self::Cooked(output) => Some(vec![output]),
+        }
+    }
+}
+
+fn conversion(input: &ItemStack, kind: ProcessingType) -> Option<Conversion> {
+    use ProcessingType::{Haunting, Smoking, Splashing};
+    if matches!(kind, Haunting | Splashing) {
+        static RECIPES: OnceLock<Option<FanRecipes>> = OnceLock::new();
+        let recipes = RECIPES
+            .get_or_init(|| {
+                serde_json::from_str(include_str!(concat!(
+                    env!("CARGO_MANIFEST_DIR"),
+                    "/../../assets/nextmc-create-fan.json"
+                )))
+                .map_err(
+                    |error| tracing::error!(%error, "Could not read embedded Create fan recipes"),
+                )
+                .ok()
+            })
+            .as_ref()?;
+        let recipes = if kind == Haunting {
+            &recipes.haunting
+        } else {
+            &recipes.splashing
+        };
+        return recipes
+            .iter()
+            .find(|recipe| recipe.matches(input))
+            .map(Conversion::Recipe);
+    }
+    let cook = |kind| {
+        get_cooking_recipe_with_ingredient(input.get_item(), kind)
+            .filter(|recipe| !recipe.recipe_id.ends_with("_manual_only"))
+    };
+    let smoking = cook(CookingRecipeKind::Smoking);
+    let recipe = if kind == Smoking {
+        smoking?
+    } else {
+        let cooking =
+            cook(CookingRecipeKind::Smelting).or_else(|| cook(CookingRecipeKind::Blasting))?;
+        // shortcut: preserve inputs without a blasting output until fire-resistance and item destruction are wired.
+        if smoking.is_some_and(|recipe| recipe.result.id == cooking.result.id) {
+            return None;
+        }
+        cooking
+    };
+    let item = Item::from_registry_key(recipe.result.id)?;
+    let count =
+        u8::try_from(i32::from(input.item_count).checked_mul(i32::from(recipe.result.count))?)
+            .ok()?;
+    let output = ItemStack::new(count, item);
+    (count != 0 && count <= output.get_max_stack_size()).then_some(Conversion::Cooked(output))
+}
