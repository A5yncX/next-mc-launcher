+    #[test]
+    fn assembly_ownership_and_blocks_round_trip_together() {
+        use pumpkin_nbt::tag::NbtTag;
+        use pumpkin_util::math::vector2::Vector2;
+        let chunk = super::ChunkData::empty(0, 0);
+        let stone = Block::STONE.default_state.id;
+        let air = Block::AIR.default_state.id;
+        let record = NbtTag::IntArray(vec![1, 0, 1].into());
+        let edit = |expected, replacement| super::ChunkDataEdit {
+            namespace: "create",
+            key: "assembly",
+            expected,
+            replacement,
+        };
+        chunk.set_block_absolute_y(1, 0, 1, stone);
+        chunk.set_custom_data("create", "other", NbtTag::Int(5));
+        assert!(
+            chunk
+                .compare_set_blocks(
+                    &[(1, 0, 1, air, stone)],
+                    Some(edit(None, Some(record.clone())))
+                )
+                .is_none()
+        );
+        assert!(
+            chunk
+                .compare_set_blocks(&[(1, 0, 1, stone, air)], Some(edit(Some(&record), None)))
+                .is_none()
+        );
+        assert_eq!(chunk.get_custom_data("create", "assembly"), None);
+        assert_eq!(chunk.section.get_block_absolute_y(1, 0, 1), Some(stone));
+        assert!(
+            chunk
+                .compare_set_blocks(
+                    &[(1, 0, 1, stone, air)],
+                    Some(edit(None, Some(record.clone())))
+                )
+                .is_some()
+        );
+        for bytes in [chunk.internal_to_bytes(), chunk.internal_to_pump_bytes()] {
+            let loaded = super::ChunkData::internal_from_bytes(&bytes, Vector2::new(0, 0)).unwrap();
+            assert_eq!(loaded.section.get_block_absolute_y(1, 0, 1), Some(air));
+            assert_eq!(
+                loaded.get_custom_data("create", "assembly").as_ref(),
+                Some(&record)
+            );
+            assert!(
+                loaded
+                    .compare_set_blocks(&[(1, 0, 1, air, stone)], Some(edit(Some(&record), None)))
+                    .is_some()
+            );
+            assert_eq!(loaded.section.get_block_absolute_y(1, 0, 1), Some(stone));
+            assert_eq!(loaded.get_custom_data("create", "assembly"), None);
+            assert_eq!(
+                loaded.get_custom_data("create", "other"),
+                Some(NbtTag::Int(5))
+            );
+        }
     }
 
