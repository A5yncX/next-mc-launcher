 mod test {
     use pumpkin_data::BlockStateId;
 
+    #[test]
+    fn create_full_registry_round_trips() {
+        use pumpkin_data::{Block, BlockId, item::Item, item_stack::ItemStack};
+
+        let mut states = 0;
+        let mut placeable = 0;
+        for id in 1286..=1391 {
+            let block = Block::from_id(BlockId::new(id).unwrap());
+            assert!(block.name.starts_with("create:"));
+            assert_eq!(Block::from_name(block.name).unwrap().id, block.id);
+            if block.item_id != 0 {
+                placeable += 1;
+                assert_eq!(Block::from_item_id(block.item_id).unwrap().id, block.id);
+                assert_eq!(Item::from_id(block.item_id).unwrap().registry_key, block.name);
+            }
+            for state in block.states {
+                states += 1;
+                assert_eq!(Block::from_state_id(state.id).id, block.id);
+                let nbt = super::BlockStateCodec::state_to_nbt(state.id);
+                assert_eq!(nbt.get_string("Name"), Some(block.name));
+                assert_eq!(super::BlockStateCodec::state_from_nbt(&nbt), Some(state.id));
+            }
+        }
+        assert_eq!((states, placeable), (2145, 84));
+        for id in 1658..=1780 {
+            let item = Item::from_id(id).unwrap();
+            assert!(item.registry_key.starts_with("create:"));
+            let mut nbt = super::NbtCompound::new();
+            ItemStack::new(1, item).write_item_stack(&mut nbt);
+            assert_eq!(nbt.get_string("id"), Some(item.registry_key));
+            assert_eq!(ItemStack::read_item_stack(&nbt).unwrap().item.id, id);
+        }
+    }
