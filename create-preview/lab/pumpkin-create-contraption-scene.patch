+use pumpkin_nbt::{compound::NbtCompound, serializer::NbtWriteHelperJava, tag::NbtTag};
+use pumpkin_protocol::{codec::var_int::VarInt, ser::NetworkWriteExt};
+use pumpkin_world::chunk::ChunkData;
+
+pub(crate) const CHANNEL: &str = "horizon:attachment_sync";
+const NAMESPACE: &str = "create";
+const SCENE: &str = "contraption_scene";
+const GEOMETRY: &str = "moving_structures";
+const POSES: &str = "moving_structure_poses";
+const MAX_PAYLOAD: usize = 1_048_576;
+
+pub(crate) fn snapshot(chunk: &ChunkData) -> Option<Vec<u8>> {
+    let NbtTag::Compound(scene) = chunk.get_custom_data(NAMESPACE, SCENE)? else {
+        return None;
+    };
+    encode(chunk.x, chunk.z, &scene)
+}
+
+fn encode(x: i32, z: i32, scene: &NbtCompound) -> Option<Vec<u8>> {
+    let geometry = scene.get_compound(GEOMETRY)?;
+    let poses = scene.get_compound(POSES)?;
+    let generation = geometry.get_long("Generation").filter(|&n| n > 0)?;
+    if geometry.get_int("Version") != Some(2)
+        || poses.get_int("Version") != Some(1)
+        || poses.get_long("Generation") != Some(generation)
+    {
+        return None;
+    }
+    // Chunk holder (3), signed big-endian chunk coordinates, then a replacement snapshot.
+    let mut bytes = vec![3];
+    bytes.extend_from_slice(&x.to_be_bytes());
+    bytes.extend_from_slice(&z.to_be_bytes());
+    bytes.push(1);
+    bytes.write_var_int(&VarInt(2)).ok()?;
+    for (key, value) in [(GEOMETRY, geometry), (POSES, poses)] {
+        bytes.write_string(NAMESPACE).ok()?;
+        bytes.write_string(key).ok()?;
+        bytes.push(10); // Unnamed root compound.
+        value
+            .clone()
+            .serialize_content(&mut NbtWriteHelperJava::new(&mut bytes))
+            .ok()?;
+        if bytes.len() > MAX_PAYLOAD {
+            return None;
+        }
+    }
+    Some(bytes)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn scene(geometry_generation: i64, pose_generation: i64, padding: usize) -> NbtCompound {
+        let mut geometry = NbtCompound::new();
+        geometry.put_int("Version", 2);
+        geometry.put_long("Generation", geometry_generation);
+        if padding != 0 {
+            geometry.put(
+                "Padding",
+                NbtTag::ByteArray(vec![0; padding].into_boxed_slice()),
+            );
+        }
+        let mut poses = NbtCompound::new();
+        poses.put_int("Version", 1);
+        poses.put_long("Generation", pose_generation);
+        let mut out = NbtCompound::new();
+        out.put_compound(GEOMETRY, geometry);
+        out.put_compound(POSES, poses);
+        out
+    }
+
+    #[test]
+    fn matches_chunk_attachment_wire_format_and_only_sends_scene_keys() {
+        use pumpkin_nbt::Nbt;
+        let mut tags = scene(17, 17, 0);
+        tags.put_string("server_only", "do not send".into());
+        let packet = encode(-17, 42, &tags).unwrap();
+        let mut expected = b"\x03\xff\xff\xff\xef\x00\x00\x00\x2a\x01\x02".to_vec();
+        expected.extend_from_slice(b"\x06create\x11moving_structures");
+        expected.extend_from_slice(
+            &Nbt::from(tags.get_compound(GEOMETRY).unwrap().clone()).write_unnamed(),
+        );
+        expected.extend_from_slice(b"\x06create\x16moving_structure_poses");
+        expected.extend_from_slice(
+            &Nbt::from(tags.get_compound(POSES).unwrap().clone()).write_unnamed(),
+        );
+        assert_eq!(packet, expected);
+    }
+
+    #[test]
+    fn rejects_mixed_generations_wrong_format_and_oversize_snapshots() {
+        assert!(encode(0, 0, &scene(17, 18, 0)).is_none());
+        assert!(encode(0, 0, &scene(0, 0, 0)).is_none());
+        assert!(encode(0, 0, &NbtCompound::new()).is_none());
+        assert!(encode(0, 0, &scene(17, 17, MAX_PAYLOAD)).is_none());
+    }
+}
