diff --git a/crates/pumpkin-core/src/block/blocks/create_chain.rs b/crates/pumpkin-core/src/block/blocks/create_chain.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/blocks/create_chain.rs
@@ -0,0 +1,188 @@
+use create_engine::{
+    chain_drive::{Part, State},
+    kinetics::Axis,
+    placement::Direction,
+};
+use pumpkin_data::{Block, BlockDirection, BlockStateId, block_properties::Property};
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_world::world::BlockFlags;
+
+use crate::{
+    block::{
+        BlockActionResult, BlockBehaviour, GetStateForNeighborUpdateArgs, UseWithItemArgs,
+        blocks::redstone,
+    },
+    world::World,
+};
+
+pub(crate) const DRIVE: &str = "create:encased_chain_drive";
+pub(crate) const ADJUSTABLE: &str = "create:adjustable_chain_gearshift";
+
+pub(crate) fn read(id: BlockStateId) -> Option<State> {
+    let block = id.to_block();
+    if !matches!(block.name, DRIVE | ADJUSTABLE) {
+        return None;
+    }
+    let props = block.properties(id)?.to_props();
+    let get = |k| {
+        props
+            .iter()
+            .find(|p| p.key_str() == k)
+            .map(|p| p.value_str())
+    };
+    Some(State {
+        axis: match get("axis")? {
+            "x" => Axis::X,
+            "y" => Axis::Y,
+            "z" => Axis::Z,
+            _ => return None,
+        },
+        first: get("axis_along_first")? == "true",
+        part: match get("part")? {
+            "start" => Part::Start,
+            "middle" => Part::Middle,
+            "end" => Part::End,
+            "none" => Part::None,
+            _ => return None,
+        },
+    })
+}
+
+pub(crate) fn write(
+    block: &Block,
+    id: BlockStateId,
+    chain: State,
+    power: Option<u8>,
+) -> BlockStateId {
+    let Some(mut props) = block.properties(id).map(|p| p.to_props()) else {
+        return id;
+    };
+    for prop in &mut props {
+        let value = match prop.key_str() {
+            "axis" => match chain.axis {
+                Axis::X => "x",
+                Axis::Y => "y",
+                Axis::Z => "z",
+            },
+            "axis_along_first" => {
+                if chain.first {
+                    "true"
+                } else {
+                    "false"
+                }
+            }
+            "part" => match chain.part {
+                Part::Start => "start",
+                Part::Middle => "middle",
+                Part::End => "end",
+                Part::None => "none",
+            },
+            "powered" if power.is_some() => {
+                if power.unwrap_or_default() > 0 {
+                    "true"
+                } else {
+                    "false"
+                }
+            }
+            _ => continue,
+        };
+        if let Some(new) = Property::from_str_pair(prop.key_str(), value) {
+            *prop = new;
+        }
+    }
+    block.from_properties(&props).to_state_id(block)
+}
+
+pub(crate) fn neighbors(world: &World, pos: BlockPos) -> [Option<State>; 6] {
+    Direction::ALL.map(|d| {
+        let [x, y, z] = d.vector();
+        world
+            .get_block_state_id_if_loaded(&BlockPos::new(pos.0.x + x, pos.0.y + y, pos.0.z + z))
+            .and_then(read)
+    })
+}
+
+pub(crate) fn signal(world: &World, pos: &BlockPos) -> u8 {
+    BlockDirection::all()
+        .into_iter()
+        .map(|side| {
+            let pos = pos.offset(side.to_offset());
+            world.get_block_state_id_if_loaded(&pos).map_or(0, |id| {
+                redstone::get_redstone_power(id.to_block(), id.to_state(), world, &pos, side)
+            })
+        })
+        .max()
+        .unwrap_or(0)
+        .min(15)
+}
+
+fn reshape(args: GetStateForNeighborUpdateArgs<'_>) -> BlockStateId {
+    let Some(current) = read(args.state_id) else {
+        return args.state_id;
+    };
+    let face = crate::block::registry::BlockRegistry::create_direction(args.direction);
+    write(
+        args.block,
+        args.state_id,
+        current.update(face, read(args.neighbor_state_id)),
+        None,
+    )
+}
+
+fn wrench(args: UseWithItemArgs<'_>) -> BlockActionResult {
+    if args.item_stack.get_item().registry_key != "create:wrench"
+        || args
+            .world
+            .is_in_spawn_protection(args.player, args.position)
+    {
+        return BlockActionResult::PassToDefaultBlockAction;
+    }
+    let Some(old) = args.world.get_block_state_id_if_loaded(args.position) else {
+        return BlockActionResult::PassToDefaultBlockAction;
+    };
+    let Some(chain) = read(old) else {
+        return BlockActionResult::PassToDefaultBlockAction;
+    };
+    let face = crate::block::registry::BlockRegistry::create_direction(*args.hit.face);
+    args.world.set_block_state_if(
+        args.position,
+        write(
+            old.to_block(),
+            old,
+            chain.wrenched(face, neighbors(args.world, *args.position)),
+            None,
+        ),
+        BlockFlags::NOTIFY_ALL,
+        |current| current == old,
+    );
+    BlockActionResult::SuccessServer
+}
+
+#[pumpkin_block("create:encased_chain_drive")]
+pub struct EncasedChainDrive;
+#[pumpkin_block("create:adjustable_chain_gearshift")]
+pub struct AdjustableChainGearshift;
+
+impl BlockBehaviour for EncasedChainDrive {
+    fn get_state_for_neighbor_update(
+        &self,
+        args: GetStateForNeighborUpdateArgs<'_>,
+    ) -> BlockStateId {
+        reshape(args)
+    }
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        wrench(args)
+    }
+}
+impl BlockBehaviour for AdjustableChainGearshift {
+    fn get_state_for_neighbor_update(
+        &self,
+        args: GetStateForNeighborUpdateArgs<'_>,
+    ) -> BlockStateId {
+        reshape(args)
+    }
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        wrench(args)
+    }
+}
