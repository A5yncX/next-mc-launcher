@@ -0,0 +1,27 @@
+use pumpkin_macros::pumpkin_block;
+
+use crate::block::{
+    BlockActionResult, BlockBehaviour, NormalUseArgs, UseWithItemArgs,
+    entities::create_kinetic::turn_crank,
+};
+
+#[pumpkin_block("create:hand_crank")]
+pub struct CreateHandCrank;
+
+impl BlockBehaviour for CreateHandCrank {
+    fn normal_use(&self, args: NormalUseArgs<'_>) -> BlockActionResult {
+        if turn_crank(args.world, args.position, args.player) {
+            BlockActionResult::SuccessServer
+        } else {
+            BlockActionResult::Pass
+        }
+    }
+
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        if turn_crank(args.world, args.position, args.player) {
+            BlockActionResult::SuccessServer
+        } else {
+            BlockActionResult::PassToDefaultBlockAction
+        }
+    }
+}
