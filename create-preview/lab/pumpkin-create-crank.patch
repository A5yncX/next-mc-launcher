+pub(crate) fn crank_support(world: &World, pos: BlockPos, state: BlockStateId) -> Option<bool> {
+    if state.to_block().name != CRANK {
+        return None;
+    }
+    let Kind::Motor { facing, .. } = node(state, [pos.0.x, pos.0.y, pos.0.z])?.kind else {
+        return None;
+    };
+    let support = BlockPos::new(
+        pos.0.x + facing[0],
+        pos.0.y + facing[1],
+        pos.0.z + facing[2],
+    );
+    Some(
+        world
+            .get_block_state_id_if_loaded(&support)?
+            .to_state()
+            .get_block_collision_shapes_at(&support)
+            .into_iter()
+            .next()
+            .is_some(),
+    )
+}
+
+pub(crate) fn turn_crank(world: &World, pos: &BlockPos, player: &Player) -> bool {
+    if world
+        .get_block_state_id_if_loaded(pos)
+        .and_then(|state| crank_support(world, *pos, state))
+        != Some(true)
+    {
+        return false;
+    }
+    let Some(entity) = world.get_block_entity(pos) else {
+        return false;
+    };
+    let Some(crank) = entity
+        .as_any()
+        .downcast_ref::<CreateKinetic>()
+        .filter(|c| c.id == CRANK)
+    else {
+        return false;
+    };
+    // Pack the expiry and direction together so the solver reads a single use.
+    crank.crank_until.store(
+        (world.get_world_age() + 10) * 2 + i64::from(player.get_entity().is_sneaking()),
+        Ordering::Relaxed,
+    );
+    player.add_exhaustion(0.32);
+    true
+}
