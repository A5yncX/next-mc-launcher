@@ -0,0 +1,23 @@
+use pumpkin_macros::pumpkin_block;
+
+use crate::block::{
+    BlockBehaviour, GetComparatorOutputArgs, entities::create_kinetic::gauge_signal,
+};
+
+#[pumpkin_block("create:speedometer")]
+pub struct CreateSpeedometer;
+
+impl BlockBehaviour for CreateSpeedometer {
+    fn get_comparator_output(&self, args: GetComparatorOutputArgs<'_>) -> Option<u8> {
+        Some(gauge_signal(args.world, args.position))
+    }
+}
+
+#[pumpkin_block("create:stressometer")]
+pub struct CreateStressometer;
+
+impl BlockBehaviour for CreateStressometer {
+    fn get_comparator_output(&self, args: GetComparatorOutputArgs<'_>) -> Option<u8> {
+        CreateSpeedometer.get_comparator_output(args)
+    }
+}
