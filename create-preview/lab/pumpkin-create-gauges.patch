+    #[test]
+    fn gauge_matches_create_network_load_and_overload() {
+        let pos = [0, 80, 0];
+        let station = Node {
+            pos,
+            axis: Axis::X,
+            kind: Kind::Shaft,
+        };
+        for (supply, want, overloaded) in [(16.0, 7, false), (4.0, 15, true)] {
+            let network = solve_half(station, 0, |pos| match pos[0] {
+                -1 if pos[1..] == [80, 0] => Some(Node {
+                    pos,
+                    axis: Axis::X,
+                    kind: Kind::Motor {
+                        facing: [1, 0, 0],
+                        rpm: 32.0,
+                        capacity: supply,
+                    },
+                }),
+                1 if pos[1..] == [80, 0] => Some(Node {
+                    pos,
+                    axis: Axis::X,
+                    kind: Kind::Press,
+                }),
+                _ => None,
+            });
+            let rpm = network.speed(pos);
+            let data = Gauge::from_network(STRESSOMETER, rpm, &network, 0);
+            assert_eq!(data.status == Some(Status::Overstressed), overloaded);
+            assert_eq!(visual::comparator(data.dial), want);
+            let speed = Gauge::from_network(SPEEDOMETER, rpm, &network, 0);
+            assert_eq!(
+                visual::comparator(speed.dial),
+                if overloaded { 0 } else { 7 }
             );
         }
     }
