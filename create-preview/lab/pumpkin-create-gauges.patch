+#[derive(Default, PartialEq)]
+struct Gauge {
+    dial: f32,
+    color: i32,
+    capacity: f32,
+    stress: f32,
+    status: Option<Status>,
+}
+
+impl Gauge {
+    fn from_network(id: &str, rpm: f32, net: &Network, previous_color: i32) -> Self {
+        let mix = |from: i32, to: i32, amount: f32| {
+            [0, 8, 16]
+                .into_iter()
+                .map(|shift| {
+                    let a = (from >> shift) & 255;
+                    let b = (to >> shift) & 255;
+                    ((a as f32 + (b - a) as f32 * amount) as i32) << shift
+                })
+                .sum::<i32>()
+        };
+        let (dial, color) = if id == SPEEDOMETER {
+            let base = match rpm.abs() {
+                0.0 => 0,
+                r if r < 30.0 => 0x22FF22,
+                r if r < 100.0 => 0x0084FF,
+                _ => 0xFF55FF,
+            };
+            (visual::speed_dial(rpm), mix(base, 0xFFFFFF, 0.25))
+        } else {
+            let dial =
+                visual::stress_dial(net.capacity, net.stress, net.status == Status::Overstressed);
+            let color = if dial <= 0.0 {
+                previous_color
+            } else if dial < 0.5 {
+                mix(0x00FF00, 0xFFFF00, dial * 2.0)
+            } else if dial < 1.0 {
+                mix(0xFFFF00, 0xFF0000, dial * 2.0 - 1.0)
+            } else {
+                0xFF0000
+            };
+            (dial, color)
+        };
+        Self {
+            dial,
+            color,
+            capacity: net.capacity,
+            stress: net.stress,
+            status: Some(net.status),
+        }
+    }
+}
