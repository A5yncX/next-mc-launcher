+// shortcut: manual activation only; process power-edge requests after their permissions are defined.
+fn interact_clockwork(
+    world: &Arc<World>,
+    controller: BlockPos,
+    state: BlockStateId,
+    facing: Direction,
+    previous: Option<NbtTag>,
+    old: NbtCompound,
+    in_scope: impl Fn(BlockPos) -> bool,
+) -> Option<()> {
+    let owner = coords(controller);
+    let mut hands = clock_hands(&old, owner, facing)?;
+    let current = generation(&old).unwrap_or(0);
+    if previous.is_some() && current == 0 {
+        return None;
+    }
+    let next = current.checked_add(1)?;
+    let air = Block::AIR.default_state.id;
+    let axis = facing.axis();
+    let mut edits = Vec::new();
+    if hands.is_empty() {
+        let captured = clockwork::capture(
+            &View(world, controller, false),
+            owner,
+            facing,
+            MAX_WINDMILL_BLOCKS,
+        )
+        .ok()??;
+        for (hand, assembly) in [Some(captured.hour), captured.minute]
+            .into_iter()
+            .enumerate()
+        {
+            let Some(assembly) = assembly else { continue };
+            let anchor = assembly.anchor();
+            let blocks = assembly.blocks().to_vec();
+            // Unlike a single bearing, the clock hands share a controller but keep separate pivots.
+            for angle in [0.0, 90.0, 180.0, 270.0] {
+                let turn = Rotation::new(anchor, axis, angle)?.snapped();
+                for &(local, id) in &blocks {
+                    if local.iter().any(|v| v.unsigned_abs() > 15) {
+                        return None;
+                    }
+                    let p = pos(turn.place(anchor, local)?);
+                    if !in_scope(p) {
+                        return None;
+                    }
+                    if angle == 0.0 {
+                        edits.push((p, id, air));
+                    }
+                }
+            }
+            hands.push(Motion {
+                controller: owner,
+                anchor,
+                axis: axis.index(),
+                blocks,
+                angle: 0.0,
+                stalled: false,
+                windmill: false,
+                hand: Some(hand as i8),
+            });
+        }
+        let records = hands.iter().map(|hand| hand.entries(0.0, 0.0));
+        let captured = scene(&old, owner, next, records)?;
+        commit(
+            world,
+            controller,
+            state,
+            previous.map(|_| old),
+            captured,
+            &edits,
+        );
+    } else {
+        for hand in &hands {
+            let plan = plan_landing(
+                &hand.blocks,
+                hand.anchor,
+                Rotation::new(hand.anchor, axis, clockwork::RESTORE_ANGLE)?.snapped(),
+                |id, turn| transformed(*id, turn),
+                |p, id| {
+                    let p = pos(p);
+                    in_scope(p)
+                        && world.get_block_state_id_if_loaded(&p) == Some(air)
+                        && id
+                            .to_state()
+                            .get_block_collision_shapes_at(&p)
+                            .all(|shape| {
+                                !BlockRegistry::has_blocking_entity_in_box(world, &shape.at_pos(p))
+                            })
+                },
+            );
+            if let Ok(plan) = plan {
+                edits.extend(plan.into_iter().map(|(p, id)| (pos(p), air, id)));
+            } else {
+                edits.clear();
+                break;
+            }
+        }
+        if !edits.is_empty()
+            && let Some(cleared) = scene(&old, owner, next, [])
+            && commit(world, controller, state, Some(old.clone()), cleared, &edits)
+        {
+            return Some(());
+        }
+        // Both hands remain owned even when only one destination is blocked.
+        for hand in &mut hands {
+            hand.stalled = true;
+        }
+        if let Some(stalled) = scene(
+            &old,
+            owner,
+            current,
+            hands.iter().map(|hand| hand.entries(hand.angle, 0.0)),
+        ) {
+            commit(world, controller, state, Some(old), stalled, &[]);
+        }
+    }
+    Some(())
+}
