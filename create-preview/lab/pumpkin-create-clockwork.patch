+fn clock_hands(scene: &NbtCompound, controller: Pos, facing: Direction) -> Option<Vec<Motion>> {
+    let mut hands = Vec::new();
+    for hand in [0, 1] {
+        if let Some(motion) = Motion::read_hand(scene, controller, Some(hand)) {
+            let axis = facing.axis().index();
+            let valid = (if hand == 0 { 1..=1 } else { 2..=16 }).any(|n| {
+                motion.matches(
+                    controller,
+                    plus(controller, facing.vector().map(|v| v * n)),
+                    axis,
+                )
+            });
+            if !valid || usize::from(hand as u8) != hands.len() {
+                return None;
+            }
+            hands.push(motion);
+        }
+    }
+    for key in [GEOMETRY, POSES] {
+        let count = entry(scene, key)
+            .unwrap_or_default()
+            .iter()
+            .filter(|tag| owner(tag) == Some(controller))
+            .count();
+        if count != hands.len() {
+            return None;
+        }
+    }
+    Some(hands)
+}
+
+fn tick_clockwork(
+    world: &Arc<World>,
+    controller: BlockPos,
+    state: BlockStateId,
+    rpm: f32,
+    setting: i32,
+) -> bool {
+    let Some((_, old, _)) = read(world, controller, state) else {
+        return false;
+    };
+    let Some(facing) = facing(state) else {
+        return false;
+    };
+    let Some(mut hands) =
+        clock_hands(&old, coords(controller), facing).filter(|hands| !hands.is_empty())
+    else {
+        return false;
+    };
+    let before = Angles {
+        hour: hands[0].angle,
+        minute: hands.get(1).map_or(0.0, |hand| hand.angle),
+    };
+    let target = ClockTime {
+        day_time: world.get_time_of_day(),
+        natural_dimension: world.dimension == Dimension::OVERWORLD,
+        facing,
+    }
+    .targets(ClockMode::from_scroll_value(setting).unwrap_or_default());
+    let after = before.advance(
+        target,
+        rpm,
+        [
+            hands[0].stalled,
+            hands.get(1).is_some_and(|hand| hand.stalled),
+        ],
+    );
+    let mut changed = false;
+    let records = hands
+        .iter_mut()
+        .zip([after.hour, after.minute])
+        .map(|(hand, angle)| {
+            let speed = if hand.stalled { 0.0 } else { rpm };
+            let previous = hand.angle;
+            let last = owned_hand(&old, POSES, hand.controller, hand.hand).unwrap();
+            changed |= previous != angle
+                || last.get_float("Speed") != Some(speed)
+                || last.get_float("PreviousAngle") != Some(previous);
+            hand.angle = angle;
+            hand.entries(previous, speed)
+        })
+        .collect::<Vec<_>>();
+    if changed
+        && let Some(next) = scene(&old, coords(controller), generation(&old).unwrap(), records)
+    {
+        commit(world, controller, state, Some(old), next, &[]);
+    }
+    true
+}
