+fn within_landing_scope(world: &World, controller: BlockPos, p: BlockPos) -> bool {
+    p != controller
+        && p.chunk_and_chunk_relative_position().0
+            == controller.chunk_and_chunk_relative_position().0
+        && world.is_in_build_limit(p)
+        && world.worldborder.lock().is_ok_and(|b| {
+            b.is_within_bounds(f64::from(p.0.x), f64::from(p.0.z), 0.0)
+                && b.is_within_bounds(f64::from(p.0.x) + 0.99999, f64::from(p.0.z) + 0.99999, 0.0)
+        })
+}
+
+fn land(
+    world: &Arc<World>,
+    controller: BlockPos,
+    state: BlockStateId,
+    old: &NbtCompound,
+    mut motion: Motion,
+    in_scope: impl Fn(BlockPos) -> bool,
+) -> bool {
+    let Some(current) = generation(old) else {
+        return false;
+    };
+    let air = Block::AIR.default_state.id;
+    let land_angle = if motion.windmill {
+        RESTORE_ANGLE
+    } else {
+        motion.angle
+    };
+    let Some(axis) = facing(state).map(|d| d.axis()) else {
+        return false;
+    };
+    let turn = Rotation::new(motion.anchor, axis, land_angle)
+        .expect("validated angle")
+        .snapped();
+    let plan = plan_landing(
+        &motion.blocks,
+        motion.anchor,
+        turn,
+        |id, turn| transformed(*id, turn),
+        |p, id| {
+            let p = pos(p);
+            in_scope(p)
+                && world.get_block_state_id_if_loaded(&p) == Some(air)
+                && id
+                    .to_state()
+                    .get_block_collision_shapes_at(&p)
+                    .all(|shape| {
+                        !BlockRegistry::has_blocking_entity_in_box(world, &shape.at_pos(p))
+                    })
+        },
+    );
+    if let Ok(plan) = plan
+        && let Some(cleared) = current
+            .checked_add(1)
+            .and_then(|next| scene(old, motion.controller, next, []))
+    {
+        let edits: Vec<_> = plan.into_iter().map(|(p, id)| (pos(p), air, id)).collect();
+        if commit(world, controller, state, Some(old.clone()), cleared, &edits) {
+            return true;
+        }
+    }
+    motion.stalled = true;
+    if let Some(stalled) = motion.write(old, current, motion.angle, 0.0) {
+        commit(world, controller, state, Some(old.clone()), stalled, &[]);
+    }
+    false
+}
