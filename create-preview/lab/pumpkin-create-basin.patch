+use std::{
+    any::Any,
+    array::from_fn,
+    sync::{
+        Arc, PoisonError, RwLock,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+use create_engine::basin as rules;
+use pumpkin_data::item_stack::ItemStack;
+use pumpkin_inventory::{Clearable, Inventory};
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::position::BlockPos;
+
+use super::BlockEntity;
+use crate::world::World;
+
+const INPUT_SIZE: usize = rules::ITEM_SLOTS;
+const OUTPUT_START: usize = INPUT_SIZE;
+const INVENTORY_SIZE: usize = INPUT_SIZE * 2;
+
+/// A recipe key whose equality keeps every item component significant.
+#[derive(Clone)]
+pub(crate) struct BasinItemKey(pub ItemStack);
+
+impl BasinItemKey {
+    #[must_use]
+    pub(crate) fn new(mut stack: ItemStack) -> Self {
+        stack.item_count = 1;
+        Self(stack)
+    }
+}
+
+impl PartialEq for BasinItemKey {
+    fn eq(&self, other: &Self) -> bool {
+        self.0.are_items_and_components_equal(&other.0)
+    }
+}
+impl Eq for BasinItemKey {}
+
+/// Converts a Pumpkin stack into the item representation expected by shared Create rules.
+#[must_use]
+pub(crate) fn basin_item(stack: ItemStack) -> rules::Item<BasinItemKey> {
+    rules::Item {
+        key: BasinItemKey::new(stack.clone()),
+        count: u32::from(stack.item_count),
+        maximum: u32::from(stack.get_max_stack_size()),
+    }
+}
+
+pub(crate) struct CreateBasinBlockEntity {
+    pub position: BlockPos,
+    pub items: RwLock<[ItemStack; INVENTORY_SIZE]>,
+    dirty: AtomicBool,
+    other_nbt: NbtCompound,
+    item_templates: [Option<NbtCompound>; 2],
+    opaque_items: Option<[Option<NbtTag>; 2]>,
+}
+
+impl BlockEntity for CreateBasinBlockEntity {
+    fn resource_location(&self) -> &'static str {
+        "create:basin"
+    }
+
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        let mut items = from_fn(|_| ItemStack::EMPTY.clone());
+        let readable = read_half(nbt.get("InputItems"), &mut items[..INPUT_SIZE]).is_some()
+            && read_half(nbt.get("OutputItems"), &mut items[OUTPUT_START..]).is_some();
+        let opaque_items = (!readable).then(|| {
+            [
+                nbt.get("InputItems").cloned(),
+                nbt.get("OutputItems").cloned(),
+            ]
+        });
+        let item_templates = if readable {
+            [
+                nbt.get_compound("InputItems").cloned(),
+                nbt.get_compound("OutputItems").cloned(),
+            ]
+        } else {
+            [None, None]
+        };
+        if !readable {
+            items.fill(ItemStack::EMPTY.clone());
+        }
+
+        let mut other_nbt = nbt.clone();
+        for key in ["InputItems", "OutputItems"] {
+            other_nbt.child_tags.remove(key);
+        }
+
+        Self {
+            position,
+            items: RwLock::new(items),
+            dirty: AtomicBool::new(false),
+            other_nbt,
+            item_templates,
+            opaque_items,
+        }
+    }
+
+    fn write_nbt(&self, nbt: &mut NbtCompound) {
+        nbt.child_tags.extend(self.other_nbt.child_tags.clone());
+        nbt.child_tags.remove("InputItems");
+        nbt.child_tags.remove("OutputItems");
+        if let Some(opaque) = &self.opaque_items {
+            for (key, value) in ["InputItems", "OutputItems"].into_iter().zip(opaque) {
+                if let Some(value) = value {
+                    nbt.put(key, value.clone());
+                }
+            }
+        } else {
+            let items = self.items.read().unwrap_or_else(PoisonError::into_inner);
+            write_half(
+                nbt,
+                "InputItems",
+                &items[..INPUT_SIZE],
+                self.item_templates[0].as_ref(),
+            );
+            write_half(
+                nbt,
+                "OutputItems",
+                &items[OUTPUT_START..],
+                self.item_templates[1].as_ref(),
+            );
+        }
+    }
+
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        let mut nbt = NbtCompound::new();
+        self.write_nbt(&mut nbt);
+        Some(nbt)
+    }
+
+    fn get_inventory(self: Arc<Self>) -> Option<Arc<dyn Inventory>> {
+        self.is_supported().then_some(self)
+    }
+
+    fn on_block_replaced(self: Arc<Self>, world: &Arc<World>, position: &BlockPos) {
+        if self.is_supported() {
+            let inventory: Arc<dyn Inventory> = self;
+            world.scatter_inventory(position, &inventory);
+        }
+    }
+
+    fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Relaxed)
+    }
+
+    fn clear_dirty(&self) {
+        self.dirty.store(false, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl CreateBasinBlockEntity {
+    pub const HALF_SIZE: usize = INPUT_SIZE;
+    pub const INVENTORY_SIZE: usize = INPUT_SIZE * 2;
+    pub const OUTPUT_START: usize = INPUT_SIZE;
+
+    #[must_use]
+    pub fn new(position: BlockPos) -> Self {
+        Self {
+            position,
+            items: RwLock::new(from_fn(|_| ItemStack::EMPTY.clone())),
+            dirty: AtomicBool::new(false),
+            other_nbt: NbtCompound::new(),
+            item_templates: [None, None],
+            opaque_items: None,
+        }
+    }
+
+    #[must_use]
+    pub fn is_supported(&self) -> bool {
+        self.opaque_items.is_none()
+    }
+
+    /// Inserts into the unique matching input slot, or its first empty slot.
+    /// The transfer is capped at the item's stack maximum and the basin's 64-item limit.
+    pub(crate) fn insert_hand_stack(&self, incoming: &mut ItemStack, simulate: bool) -> u8 {
+        if !self.is_supported() || incoming.is_empty() {
+            return 0;
+        }
+        let maximum = incoming.get_max_stack_size().min(64);
+        if maximum == 0 {
+            return 0;
+        }
+
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let slots = &mut items[..INPUT_SIZE];
+        let mut matching = slots.iter().enumerate().filter_map(|(slot, held)| {
+            (!held.is_empty() && held.are_items_and_components_equal(incoming)).then_some(slot)
+        });
+        let target = match (matching.next(), matching.next()) {
+            (Some(slot), None) => slot,
+            (None, _) => match slots.iter().position(ItemStack::is_empty) {
+                Some(slot) => slot,
+                None => return 0,
+            },
+            _ => return 0,
+        };
+        let held_count = slots[target].item_count;
+        let inserted = incoming.item_count.min(maximum.saturating_sub(held_count));
+        if inserted == 0 {
+            return 0;
+        }
+        if !simulate {
+            if slots[target].is_empty() {
+                slots[target] = incoming.copy_with_count(inserted);
+            } else {
+                slots[target].increment(inserted);
+            }
+            incoming.decrement(inserted);
+            if incoming.is_empty() {
+                incoming.clear();
+            }
+            self.mark_dirty();
+        }
+        inserted
+    }
+
+    /// Extracts exact item/component matches from output first, falling back to input only when
+    /// no matching output remains. Simulation leaves storage unchanged.
+    pub(crate) fn extract_exact(
+        &self,
+        requested: &ItemStack,
+        amount: u8,
+        simulate: bool,
+    ) -> ItemStack {
+        if !self.is_supported() || requested.is_empty() || amount == 0 {
+            return ItemStack::EMPTY.clone();
+        }
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let has_output = items[OUTPUT_START..]
+            .iter()
+            .any(|stack| !stack.is_empty() && stack.are_items_and_components_equal(requested));
+        let range = if has_output {
+            OUTPUT_START..INVENTORY_SIZE
+        } else {
+            0..INPUT_SIZE
+        };
+        let mut remaining = amount;
+        for held in &mut items[range] {
+            if held.is_empty() || !held.are_items_and_components_equal(requested) {
+                continue;
+            }
+            let extracted = remaining.min(held.item_count);
+            remaining -= extracted;
+            if !simulate {
+                held.decrement(extracted);
+                if held.is_empty() {
+                    *held = ItemStack::EMPTY.clone();
+                }
+            }
+            if remaining == 0 {
+                break;
+            }
+        }
+        let extracted = amount - remaining;
+        if extracted == 0 {
+            return ItemStack::EMPTY.clone();
+        }
+        if !simulate {
+            self.mark_dirty();
+        }
+        requested.copy_with_count(extracted)
+    }
+
+    pub(super) fn matches_item_recipe(
+        &self,
+        recipe: &rules::Recipe<BasinItemKey, ()>,
+        heat: rules::Heat,
+        context: &mut impl rules::Context<BasinItemKey, ()>,
+    ) -> bool {
+        self.run_item_recipe(recipe, heat, context, true).outcome == rules::Outcome::Simulated
+    }
+
+    /// Applies the shared Basin item rules to a private snapshot and publishes only success.
+    /// Fluid recipes are rejected here; press/mixer hosts own their fluid transaction.
+    pub(crate) fn apply_item_recipe(
+        &self,
+        recipe: &rules::Recipe<BasinItemKey, ()>,
+        heat: rules::Heat,
+        context: &mut impl rules::Context<BasinItemKey, ()>,
+    ) -> rules::Report {
+        self.run_item_recipe(recipe, heat, context, false)
+    }
+
+    fn run_item_recipe(
+        &self,
+        recipe: &rules::Recipe<BasinItemKey, ()>,
+        heat: rules::Heat,
+        context: &mut impl rules::Context<BasinItemKey, ()>,
+        simulate: bool,
+    ) -> rules::Report {
+        if !self.is_supported() {
+            return empty_report(rules::Outcome::NoMatch(
+                rules::Rejection::MissingItemCapability,
+            ));
+        }
+        if self.other_nbt.get("Filter").is_some_and(|filter| {
+            filter
+                .extract_compound()
+                .is_none_or(|filter| !filter.child_tags.is_empty())
+        }) {
+            return empty_report(rules::Outcome::Filtered);
+        }
+        if !recipe.fluid_amounts.is_empty() || !recipe.fluid_outputs.is_empty() {
+            return empty_report(rules::Outcome::Unsupported(
+                rules::Rejection::MissingFluidCapability,
+            ));
+        }
+
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let mut snapshot = rules::Basin::<BasinItemKey, ()>::default();
+        snapshot.input = from_fn(|slot| rule_item(&items[slot]));
+        snapshot.output = from_fn(|slot| rule_item(&items[OUTPUT_START + slot]));
+        snapshot.heat = heat;
+        let report = snapshot.apply(recipe, simulate, context);
+        if report.outcome != rules::Outcome::Applied {
+            return report;
+        }
+
+        let Some(input) = native_slots(&snapshot.input) else {
+            return empty_report(rules::Outcome::Unsupported(
+                rules::Rejection::DefinitionBounds,
+            ));
+        };
+        let Some(output) = native_slots(&snapshot.output) else {
+            return empty_report(rules::Outcome::Unsupported(
+                rules::Rejection::DefinitionBounds,
+            ));
+        };
+        if report.changed() {
+            items[..INPUT_SIZE].clone_from_slice(&input);
+            items[OUTPUT_START..].clone_from_slice(&output);
+            self.mark_dirty();
+        }
+        report
+    }
+
+    fn mark_dirty(&self) {
+        self.dirty.store(true, Ordering::Relaxed);
+    }
+}
+
+fn empty_report(outcome: rules::Outcome) -> rules::Report {
+    rules::Report {
+        outcome,
+        consumed_items: 0,
+        consumed_fluid: 0,
+        inserted_items: 0,
+        inserted_fluid: 0,
+        random_calls: 0,
+        notify_all_fluid_tanks: false,
+    }
+}
+
+fn rule_item(stack: &ItemStack) -> Option<rules::Item<BasinItemKey>> {
+    (!stack.is_empty()).then(|| basin_item(stack.clone()))
+}
+
+fn native_slots(
+    slots: &[Option<rules::Item<BasinItemKey>>; INPUT_SIZE],
+) -> Option<[ItemStack; INPUT_SIZE]> {
+    let mut native = from_fn(|_| ItemStack::EMPTY.clone());
+    for (slot, item) in slots.iter().enumerate() {
+        if let Some(item) = item {
+            native[slot] = item.key.0.copy_with_count(u8::try_from(item.count).ok()?);
+        }
+    }
+    Some(native)
+}
+
+fn write_half(
+    nbt: &mut NbtCompound,
+    key: &str,
+    slots: &[ItemStack],
+    template: Option<&NbtCompound>,
+) {
+    let mut inventory = template.cloned().unwrap_or_default();
+    inventory.put_int("Size", slots.len() as i32);
+    inventory.put_list(
+        "Items",
+        slots
+            .iter()
+            .enumerate()
+            .filter(|(_, stack)| !stack.is_empty())
+            .map(|(slot, stack)| {
+                let mut item = NbtCompound::new();
+                stack.write_item_stack(&mut item);
+                item.put_int("Slot", slot as i32);
+                NbtTag::Compound(item)
+            })
+            .collect(),
+    );
+    nbt.put_compound(key, inventory);
+}
+
+fn read_half(tag: Option<&NbtTag>, slots: &mut [ItemStack]) -> Option<()> {
+    let Some(tag) = tag else {
+        return Some(());
+    };
+    let inventory = tag.extract_compound()?;
+    if inventory.get_int("Size")? != slots.len() as i32 {
+        return None;
+    }
+    let entries = inventory.get_list("Items")?;
+    if entries.len() > slots.len() {
+        return None;
+    }
+    let mut seen = vec![false; slots.len()];
+    for entry in entries {
+        let entry = entry.extract_compound()?;
+        if entry
+            .child_tags
+            .keys()
+            .any(|key| !["Slot", "id", "count", "components"].contains(&key.as_ref()))
+        {
+            return None;
+        }
+        let count = entry.get_int("count")?;
+        if !(1..=255).contains(&count)
+            || entry
+                .get("components")
+                .is_some_and(|components| components.extract_compound().is_none())
+        {
+            return None;
+        }
+        let slot = entry
+            .get_int("Slot")
+            .or_else(|| entry.get_byte("Slot").map(i32::from))?;
+        let slot = usize::try_from(slot).ok()?;
+        let was_seen = seen.get_mut(slot)?;
+        if *was_seen {
+            return None;
+        }
+        *was_seen = true;
+        slots[slot] = ItemStack::read_item_stack(entry)?;
+    }
+    Some(())
+}
+
+impl Inventory for CreateBasinBlockEntity {
+    fn size(&self) -> usize {
+        Self::INVENTORY_SIZE
+    }
+
+    fn is_empty(&self) -> bool {
+        self.items
+            .read()
+            .unwrap_or_else(PoisonError::into_inner)
+            .iter()
+            .all(ItemStack::is_empty)
+    }
+
+    fn get_stack(&self, slot: usize) -> ItemStack {
+        self.items
+            .read()
+            .unwrap_or_else(PoisonError::into_inner)
+            .get(slot)
+            .cloned()
+            .unwrap_or_else(|| ItemStack::EMPTY.clone())
+    }
+
+    fn remove_stack(&self, slot: usize) -> ItemStack {
+        if !self.is_supported() {
+            return ItemStack::EMPTY.clone();
+        }
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let Some(stack) = items.get_mut(slot) else {
+            return ItemStack::EMPTY.clone();
+        };
+        if stack.is_empty() {
+            return ItemStack::EMPTY.clone();
+        }
+        let removed = std::mem::replace(stack, ItemStack::EMPTY.clone());
+        self.mark_dirty();
+        removed
+    }
+
+    fn remove_stack_specific(&self, slot: usize, amount: u8) -> ItemStack {
+        if !self.is_supported() || amount == 0 {
+            return ItemStack::EMPTY.clone();
+        }
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let Some(stack) = items.get_mut(slot) else {
+            return ItemStack::EMPTY.clone();
+        };
+        if stack.is_empty() {
+            return ItemStack::EMPTY.clone();
+        }
+        let removed = stack.split(amount);
+        if stack.is_empty() {
+            *stack = ItemStack::EMPTY.clone();
+        }
+        self.mark_dirty();
+        removed
+    }
+
+    fn set_stack(&self, slot: usize, stack: ItemStack) {
+        if !self.is_supported() {
+            return;
+        }
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        if let Some(target) = items.get_mut(slot) {
+            *target = stack;
+            self.mark_dirty();
+        }
+    }
+
+    fn get_max_count_per_stack(&self) -> u8 {
+        64
+    }
+
+    fn is_valid_slot_for(&self, slot: usize, stack: &ItemStack) -> bool {
+        self.is_supported()
+            && slot < INPUT_SIZE
+            && self.items.read().unwrap_or_else(PoisonError::into_inner)[..INPUT_SIZE]
+                .iter()
+                .enumerate()
+                .all(|(i, held)| {
+                    i == slot || held.is_empty() || !held.are_items_and_components_equal(stack)
+                })
+    }
+
+    fn can_transfer_to(
+        &self,
+        _hopper_inventory: &dyn Inventory,
+        slot: usize,
+        _stack: &ItemStack,
+    ) -> bool {
+        self.is_supported() && slot < Self::INVENTORY_SIZE
+    }
+
+    fn mark_dirty(&self) {
+        CreateBasinBlockEntity::mark_dirty(self);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl Clearable for CreateBasinBlockEntity {
+    fn clear(&self) {
+        if self.is_supported() {
+            self.items
+                .write()
+                .unwrap_or_else(PoisonError::into_inner)
+                .fill_with(|| ItemStack::EMPTY.clone());
+            self.mark_dirty();
+        }
+    }
+}
