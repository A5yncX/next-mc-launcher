+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pumpkin_data::item::Item;
+
+    fn half(stack: Option<ItemStack>, slot: i32) -> NbtCompound {
+        let mut inventory = NbtCompound::new();
+        inventory.put_int("Size", CreateBasinBlockEntity::HALF_SIZE as i32);
+        let items = stack
+            .map(|stack| {
+                let mut item = NbtCompound::new();
+                stack.write_item_stack(&mut item);
+                item.put_int("Slot", slot);
+                vec![NbtTag::Compound(item)]
+            })
+            .unwrap_or_default();
+        inventory.put_list("Items", items);
+        inventory
+    }
+
+    #[test]
+    fn canonical_halves_round_trip_components_and_keep_other_tags() {
+        let mut stack = ItemStack::new(3, &Item::DIAMOND);
+        stack.set_lore(vec![pumpkin_util::text::TextComponent::text("basin")]);
+        let mut input_half = half(Some(stack.clone()), 4);
+        input_half.put("unknown", NbtTag::String("keep".into()));
+        let mut nbt = NbtCompound::new();
+        nbt.put_compound("InputItems", input_half);
+        nbt.put("InputTanks", NbtTag::String("opaque fluid data".into()));
+        nbt.put("Filter", NbtTag::Int(19));
+
+        let basin = CreateBasinBlockEntity::from_nbt(&nbt, BlockPos::new(1, 2, 3));
+        assert!(basin.is_supported());
+        let mut saved = NbtCompound::new();
+        basin.write_nbt(&mut saved);
+
+        let input = saved.get_compound("InputItems").unwrap();
+        assert_eq!(input.get_int("Size"), Some(9));
+        assert_eq!(input.get_string("unknown"), Some("keep"));
+        let entry = input.get_list("Items").unwrap()[0]
+            .extract_compound()
+            .unwrap();
+        assert_eq!(entry.get_int("Slot"), Some(4));
+        let restored = ItemStack::read_item_stack(entry).unwrap();
+        assert!(restored.are_items_and_components_equal(&stack));
+        assert_eq!(saved.get("InputTanks"), nbt.get("InputTanks"));
+        assert_eq!(saved.get("Filter"), nbt.get("Filter"));
+        let output = saved.get_compound("OutputItems").unwrap();
+        assert_eq!(output.get_int("Size"), Some(9));
+        assert!(output.get_list("Items").unwrap().is_empty());
+    }
+
+    #[test]
+    fn unreadable_half_stays_opaque_and_disables_inventory() {
+        let mut unknown_item = NbtCompound::new();
+        unknown_item.put_int("Slot", 0);
+        unknown_item.put_string("id", "minecraft:stone".into());
+        unknown_item.put_int("count", 1);
+        unknown_item.put_string("future", "unknown item data".into());
+        let mut bad = NbtCompound::new();
+        bad.put_int("Size", 9);
+        bad.put_list("Items", vec![NbtTag::Compound(unknown_item)]);
+        let mut nbt = NbtCompound::new();
+        nbt.put_compound("InputItems", bad);
+        nbt.put("OutputItems", NbtTag::String("unreadable".into()));
+
+        let basin = Arc::new(CreateBasinBlockEntity::from_nbt(
+            &nbt,
+            BlockPos::new(0, 0, 0),
+        ));
+        assert!(!basin.is_supported());
+        assert!(basin.clone().get_inventory().is_none());
+        let mut saved = NbtCompound::new();
+        basin.write_nbt(&mut saved);
+        assert_eq!(saved.get("InputItems"), nbt.get("InputItems"));
+        assert_eq!(saved.get("OutputItems"), nbt.get("OutputItems"));
+    }
+
+    #[test]
+    fn hand_insert_and_exact_extraction_are_bounded_and_output_first() {
+        let basin = CreateBasinBlockEntity::new(BlockPos::new(0, 0, 0));
+        basin.items.write().unwrap()[0] = ItemStack::new(62, &Item::STONE);
+        let mut hand = ItemStack::new(6, &Item::STONE);
+        assert_eq!(basin.insert_hand_stack(&mut hand, true), 2);
+        assert_eq!(hand.item_count, 6);
+        assert_eq!(basin.insert_hand_stack(&mut hand, false), 2);
+        assert_eq!(hand.item_count, 4);
+        assert_eq!(basin.items.read().unwrap()[0].item_count, 64);
+
+        basin.items.write().unwrap()[9] = ItemStack::new(2, &Item::STONE);
+        basin.items.write().unwrap()[10] = ItemStack::new(1, &Item::STONE);
+        let filter = ItemStack::new(1, &Item::STONE);
+        let preview = basin.extract_exact(&filter, 1, true);
+        assert_eq!(preview.item_count, 1);
+        assert_eq!(basin.items.read().unwrap()[9].item_count, 2);
+        let output = basin.extract_exact(&filter, 4, false);
+        assert_eq!(output.item_count, 3);
+        assert!(
+            basin.items.read().unwrap()[9..11]
+                .iter()
+                .all(ItemStack::is_empty)
+        );
+        let input = basin.extract_exact(&filter, 4, false);
+        assert_eq!(input.item_count, 4);
+        assert_eq!(basin.items.read().unwrap()[0].item_count, 60);
+        assert_eq!(basin.extract_exact(&filter, 60, false).item_count, 60);
+        assert!(basin.items.read().unwrap()[0].is_empty());
+    }
+
+    struct StoneIngredients;
+    impl rules::Context<BasinItemKey, ()> for StoneIngredients {
+        fn item_matches(&mut self, _ingredient: usize, stack: &rules::Item<BasinItemKey>) -> bool {
+            stack.key.0.item == &Item::STONE
+        }
+
+        fn fluid_matches(&mut self, _ingredient: usize, _stack: &rules::Fluid<()>) -> bool {
+            false
+        }
+
+        fn random(&mut self) -> f32 {
+            0.5
+        }
+    }
+
+    fn two_stone_recipe() -> rules::Recipe<BasinItemKey, ()> {
+        rules::Recipe {
+            kind: rules::RecipeKind::Crafting,
+            item_ingredients: 2,
+            fluid_amounts: Vec::new(),
+            outputs: vec![rules::Roll {
+                stack: rules::Item {
+                    key: BasinItemKey::new(ItemStack::new(1, &Item::DIAMOND)),
+                    count: 1,
+                    maximum: 64,
+                },
+                chance: 1.0,
+            }],
+            fluid_outputs: Vec::new(),
+            heat: rules::HeatRequirement::None,
+            duration: 0,
+        }
+    }
+
+    #[test]
+    fn item_recipe_matches_duplicate_ingredients_and_commits_only_with_capacity() {
+        let basin = CreateBasinBlockEntity::new(BlockPos::new(0, 0, 0));
+        basin.items.write().unwrap()[0] = ItemStack::new(2, &Item::STONE);
+        let mut context = StoneIngredients;
+        let report = basin.apply_item_recipe(&two_stone_recipe(), rules::Heat::None, &mut context);
+        assert_eq!(report.outcome, rules::Outcome::Applied);
+        assert!(basin.items.read().unwrap()[0].is_empty());
+        assert_eq!(basin.items.read().unwrap()[9].item, &Item::DIAMOND);
+
+        let blocked = CreateBasinBlockEntity::new(BlockPos::new(0, 0, 0));
+        {
+            let mut items = blocked.items.write().unwrap();
+            items[0] = ItemStack::new(2, &Item::STONE);
+            for output in &mut items[9..] {
+                *output = ItemStack::new(64, &Item::STONE);
+            }
+        }
+        let before = blocked.items.read().unwrap().clone();
+        let mut context = StoneIngredients;
+        let report =
+            blocked.apply_item_recipe(&two_stone_recipe(), rules::Heat::None, &mut context);
+        assert_eq!(
+            report.outcome,
+            rules::Outcome::NoMatch(rules::Rejection::ItemOutputs)
+        );
+        let after = blocked.items.read().unwrap();
+        assert!(before.iter().zip(after.iter()).all(|(a, b)| a.are_equal(b)));
+    }
+}
