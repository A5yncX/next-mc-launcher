diff --git a/crates/pumpkin-core/src/block/entities/create_mixer.rs b/crates/pumpkin-core/src/block/entities/create_mixer.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_mixer.rs
@@ -0,0 +1,245 @@
+use std::sync::{Arc, OnceLock};
+
+use create_engine::{basin as rules, burner::Heat as BurnerHeat};
+use pumpkin_data::{item::Item, item_stack::ItemStack};
+use pumpkin_nbt::compound::NbtCompound;
+use pumpkin_util::math::position::BlockPos;
+use serde::Deserialize;
+
+use super::{
+    BlockEntity,
+    create_basin::{BasinItemKey, CreateBasinBlockEntity, basin_item},
+};
+use crate::{
+    block::blocks::{create_burner, create_pipe::property},
+    world::World,
+};
+
+pub(super) const ID: &str = "create:mechanical_mixer";
+
+#[derive(Deserialize)]
+struct Rows {
+    mixing: Vec<Row>,
+    compacting: Vec<Row>,
+}
+#[derive(Deserialize)]
+struct Row {
+    ingredients: Vec<Vec<String>>,
+    results: Vec<Output>,
+    #[serde(default)]
+    heat_requirement: String,
+    #[serde(default)]
+    processing_time: i32,
+}
+#[derive(Deserialize)]
+struct Output {
+    id: String,
+    #[serde(default = "one")]
+    count: u8,
+    #[serde(default = "certain")]
+    chance: f32,
+}
+fn one() -> u8 {
+    1
+}
+fn certain() -> f32 {
+    1.0
+}
+
+pub(super) struct Recipe {
+    inputs: Vec<Vec<u16>>,
+    core: rules::Recipe<BasinItemKey, ()>,
+}
+struct Match<'a>(&'a [Vec<u16>]);
+impl rules::Context<BasinItemKey, ()> for Match<'_> {
+    fn item_matches(&mut self, ingredient: usize, stack: &rules::Item<BasinItemKey>) -> bool {
+        self.0[ingredient].contains(&stack.key.0.get_item().id)
+    }
+    fn fluid_matches(&mut self, _: usize, _: &rules::Fluid<()>) -> bool {
+        false
+    }
+    fn random(&mut self) -> f32 {
+        rand::random()
+    }
+}
+
+fn convert(row: Row) -> Recipe {
+    let item = |key: &str| Item::from_registry_key(key).expect("pinned basin item");
+    let inputs = row
+        .ingredients
+        .iter()
+        .map(|keys| keys.iter().map(|key| item(key).id).collect())
+        .collect();
+    let core = rules::Recipe {
+        kind: rules::RecipeKind::Basin,
+        item_ingredients: row.ingredients.len(),
+        fluid_amounts: vec![],
+        outputs: row
+            .results
+            .into_iter()
+            .map(|output| rules::Roll {
+                stack: basin_item(ItemStack::new(output.count, item(&output.id))),
+                chance: output.chance,
+            })
+            .collect(),
+        fluid_outputs: vec![],
+        heat: match row.heat_requirement.as_str() {
+            "" | "none" => rules::HeatRequirement::None,
+            "heated" => rules::HeatRequirement::Heated,
+            "superheated" => rules::HeatRequirement::Superheated,
+            _ => panic!("unknown pinned basin heat requirement"),
+        },
+        duration: row.processing_time,
+    };
+    Recipe { inputs, core }
+}
+
+pub(super) fn recipes(press: bool) -> &'static [Recipe] {
+    static RECIPES: OnceLock<(Vec<Recipe>, Vec<Recipe>)> = OnceLock::new();
+    let (mix, compact) = RECIPES.get_or_init(|| {
+        let rows: Rows = serde_json::from_str(include_str!(
+            "../../../../../assets/nextmc-create-basin.json"
+        ))
+        .expect("pinned item-only Create basin recipes");
+        (
+            rows.mixing.into_iter().map(convert).collect(),
+            rows.compacting.into_iter().map(convert).collect(),
+        )
+    });
+    if press { compact } else { mix }
+}
+
+pub(super) fn basin(world: &World, operator: BlockPos) -> Option<Arc<dyn BlockEntity>> {
+    let pos = operator.down().down();
+    let state = world.get_block_state_id_if_loaded(&pos)?;
+    // shortcut: only the internal output mode is represented; do not take items from a side-spout setup.
+    if state.to_block().name != "create:basin" || property(state, "facing") != Some("down") {
+        return None;
+    }
+    world.get_block_entity(&pos)
+}
+
+fn heat(world: &World, basin: BlockPos) -> rules::Heat {
+    match world
+        .get_block_state_id_if_loaded(&basin.down())
+        .and_then(create_burner::heat)
+    {
+        None | Some(BurnerHeat::None) => rules::Heat::None,
+        Some(BurnerHeat::Smouldering) => rules::Heat::Smouldering,
+        Some(BurnerHeat::Fading) => rules::Heat::Fading,
+        Some(BurnerHeat::Kindled) => rules::Heat::Kindled,
+        Some(BurnerHeat::Seething) => rules::Heat::Seething,
+    }
+}
+
+impl Recipe {
+    pub(super) fn matches(&self, entity: &dyn BlockEntity, world: &World) -> bool {
+        entity
+            .as_any()
+            .downcast_ref::<CreateBasinBlockEntity>()
+            .is_some_and(|basin| {
+                basin.matches_item_recipe(
+                    &self.core,
+                    heat(world, basin.position),
+                    &mut Match(&self.inputs),
+                )
+            })
+    }
+    pub(super) fn apply(&self, entity: &Arc<dyn BlockEntity>, world: &World) -> bool {
+        let Some(basin) = entity.as_any().downcast_ref::<CreateBasinBlockEntity>() else {
+            return false;
+        };
+        let report = basin.apply_item_recipe(
+            &self.core,
+            heat(world, basin.position),
+            &mut Match(&self.inputs),
+        );
+        if report.changed() {
+            world.update_block_entity(entity);
+        }
+        report.outcome == rules::Outcome::Applied
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Mixer {
+    cycle: rules::Mixer,
+    recipe: Option<usize>,
+}
+impl Mixer {
+    pub(super) fn read(nbt: &NbtCompound) -> Self {
+        let recipe = nbt
+            .get_int("NextMCRecipe")
+            .and_then(|i| usize::try_from(i).ok())
+            .filter(|&i| i < recipes(false).len());
+        Self {
+            cycle: rules::Mixer {
+                running: nbt.get_bool("Running") == Some(true) && recipe.is_some(),
+                ticks: nbt.get_int("Ticks").unwrap_or_default().clamp(0, 40),
+                processing_ticks: nbt
+                    .get_int("NextMCProcessingTicks")
+                    .unwrap_or(-1)
+                    .clamp(-1, 1200),
+            },
+            recipe,
+        }
+    }
+
+    pub(super) fn write(&self, nbt: &mut NbtCompound) {
+        nbt.put_bool("Running", self.cycle.running);
+        nbt.put_int("Ticks", self.cycle.ticks);
+        nbt.put_bool("NeedsUpdate", false);
+        nbt.put_int("NextMCRecipe", self.recipe.map_or(-1, |i| i as i32));
+        nbt.put_int("NextMCProcessingTicks", self.cycle.processing_ticks);
+    }
+
+    pub(super) fn tick(&mut self, world: &World, pos: BlockPos, rpm: f32) -> bool {
+        let previous = self.cycle;
+        let basin = basin(world, pos);
+        let powered = rpm.abs() >= rules::DEFAULT_MIXER_MINIMUM_RPM;
+        let recipes = recipes(false);
+        match &basin {
+            None => self.cycle.basin_removed(),
+            Some(basin) if powered && !self.cycle.running => {
+                self.recipe = recipes
+                    .iter()
+                    .position(|recipe| recipe.matches(&**basin, world));
+                if self.recipe.is_some() {
+                    self.cycle.start();
+                    self.cycle.processing_ticks = -1;
+                }
+            }
+            _ => {}
+        }
+        let recipe = self.recipe.and_then(|i| recipes.get(i));
+        self.cycle.tick(
+            rpm,
+            rules::DEFAULT_MIXER_MINIMUM_RPM,
+            recipe.map_or(0, |r| r.core.duration),
+            || {
+                powered
+                    && recipe.zip(basin.as_ref()).is_some_and(|(r, basin)| {
+                        r.apply(basin, world) && r.matches(&**basin, world)
+                    })
+            },
+        );
+        self.cycle != previous
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pinned_basin_recipes_decode_with_heat_and_duplicate_ingredients() {
+        assert_eq!(recipes(false).len(), 3);
+        assert_eq!(recipes(false)[2].core.heat, rules::HeatRequirement::Heated);
+        let [ice] = recipes(true) else {
+            panic!("expected compacted ice")
+        };
+        assert!(ice.inputs.len() > 1);
+        assert!(ice.inputs.iter().all(|ids| ids == &[Item::SNOW_BLOCK.id]));
+        assert_eq!(ice.core.outputs[0].stack.key.0.get_item().id, Item::ICE.id);
+    }
+}
