+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Assist {
+    pub pos: Pos,
+    pub axis: Axis,
+}
+
+/// The lab supports dedicated shafts and small cogs; the caller supplies only loaded cells.
+pub fn assist(
+    small_cog_in_hand: bool,
+    target: Node,
+    cursor: [f64; 3],
+    mut cell: impl FnMut(Pos) -> (Option<Node>, bool),
+) -> Option<Assist> {
+    if !cursor.iter().all(|v| v.is_finite()) {
+        return None;
+    }
+    let axis = target.axis;
+    let small_cog = Kind::Cog { large: false };
+    let extend_shaft = matches!(target.kind, Kind::Shaft);
+    if !extend_shaft && !(small_cog_in_hand && target.kind == small_cog) {
+        return None;
+    }
+    // The six-voxel pole bounds, including Create's 0.001 tolerance, exclude the cog hub.
+    if !extend_shaft
+        && (0..3).all(|i| {
+            let v = cursor[i].rem_euclid(1.0);
+            axis.index() == i || (0.3115..=0.6885).contains(&v)
+        })
+    {
+        return None;
+    }
+    let mut directions = Direction::ALL;
+    let score = |d: Direction| {
+        let [x, y, z] = d.vector();
+        (cursor[0] - 0.5) * f64::from(x)
+            + (cursor[1] - 0.5) * f64::from(y)
+            + (cursor[2] - 0.5) * f64::from(z)
+    };
+    directions.sort_by(|a, b| {
+        score(*b)
+            .partial_cmp(&score(*a))
+            .unwrap_or(std::cmp::Ordering::Equal)
+    });
+    // shortcut: default placement range, extend when the lab supports Extendo Grip/config.
+    let range = if extend_shaft { 12 } else { 1 };
+    for d in directions {
+        if (d.axis() == axis) != extend_shaft {
+            continue;
+        }
+        let delta = d.vector();
+        for distance in 1..=range {
+            let pos = std::array::from_fn(|i| target.pos[i] + distance * delta[i]);
+            let (node, replaceable) = cell(pos);
+            if extend_shaft
+                && node.is_some_and(|n| {
+                    n.axis == axis && matches!(n.kind, Kind::Shaft | Kind::Cog { .. })
+                })
+            {
+                continue;
+            }
+            if replaceable {
+                return Some(Assist { pos, axis });
+            }
+            break;
+        }
+    }
+    None
 }
 
