+use super::{Game, Hit, HudBatch, Vertex, create_port, native_world_edit};
+use create_engine::{
+    kinetics::Pos,
+    placement::{self, Assist},
+};
+use glam::{DVec3, Mat4};
+use horizon_world::registry::BlockStateId;
+
+const SHAFT: &str = "create:shaft";
+const COG: &str = "create:cogwheel";
+
+pub(super) fn on(game: &Game<'_>, item: &str) -> bool {
+    matches!(item, SHAFT | COG | "create:creative_motor")
+        && game
+            .remote
+            .as_ref()
+            .is_some_and(|r| r.brand == "Pumpkin Create Lab")
+        && game.native_on("create")
+}
+
+pub(super) fn assist(game: &Game<'_>, hit: &Hit, item: &str) -> Option<Assist> {
+    if !on(game, item)
+        || !matches!(item, SHAFT | COG)
+        || !game.may_build()
+        || game.remote_shift_down()
+        || !matches!(game.block_name(hit.pos).as_ref(), SHAFT | COG)
+    {
+        return None;
+    }
+    let target = create_port::node(game, hit.pos)?;
+    let cursor = std::array::from_fn(|i| hit.point[i] - f64::from(hit.pos[i]));
+    let (bottom, height) = game.native_world_height();
+    placement::assist(item == COG, target, cursor, |p @ [x, y, z]| {
+        if !(bottom..bottom + height).contains(&y)
+            || !game
+                .world
+                .chunks
+                .contains_key(&(x.div_euclid(16), z.div_euclid(16)))
+        {
+            return (None, false);
+        }
+        (
+            create_port::node(game, p),
+            game.res
+                .behaviours()
+                .is_replaceable(game.world.block(x, y, z)),
+        )
+    })
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct Target {
+    pos: Pos,
+    from: Pos,
+    state: BlockStateId,
+}
+
+#[derive(Default)]
+pub(super) struct Preview {
+    target: Option<Target>,
+    previous: u8,
+    ticks: u8,
+}
+
+impl Preview {
+    fn advance(&mut self, target: Option<Target>) {
+        self.previous = self.ticks;
+        if let Some(t) = target {
+            self.target = Some(t);
+            self.ticks = (self.ticks + 1).min(10);
+        } else {
+            self.ticks = self.ticks.saturating_sub(2);
+            if self.previous == 0 {
+                self.target = None;
+            }
+        }
+    }
+
+    fn visible(&self, game: &Game<'_>) -> Option<(Target, f32)> {
+        let target = self.target?;
+        if game.ui.hide_gui
+            || !game.native_playing()
+            || game.screen_over_playing()
+            || !game.camera_type.first_person()
+            || !on(game, SHAFT)
+        {
+            return None;
+        }
+        let a = f32::from(self.previous);
+        let b = f32::from(self.ticks);
+        let opacity = ((a + (b - a) * game.clock.fraction() as f32) / 10.0).powi(2);
+        (opacity > 0.0).then_some((target, opacity))
+    }
+}
+
+fn target(game: &Game<'_>) -> Option<Target> {
+    if !on(game, SHAFT)
+        || !game.native_playing()
+        || game.screen_over_playing()
+        || game.entity_targeted()
+        || !game.camera_type.first_person()
+    {
+        return None;
+    }
+    let hit = game.pick()?;
+    game.inventory
+        .get(game.selected)
+        .and_then(Option::as_ref)
+        .into_iter()
+        .chain(game.offhand.as_ref())
+        .find_map(|stack| {
+            let Assist { pos, axis } = assist(game, &hit, &stack.item)?;
+            let registry = &game.pack.assets.registry;
+            let state = registry.default_state(&stack.item)?;
+            let state = native_world_edit::with_property(registry, state, "axis", axis.name())?;
+            Some(Target {
+                pos,
+                from: hit.pos,
+                state,
+            })
+        })
+}
+
+pub(super) fn tick(game: &mut Game<'_>) {
+    let next = target(game);
+    if next != game.create_lab_preview.target
+        && let Some(next) = next
+        && std::env::var_os("CREATE_LAB_PLACEMENT_TRACE").is_some()
+    {
+        log::info!(
+            "Create lab preview: {:?} -> {:?}, {:?}",
+            next.from,
+            next.pos,
+            next.state
+        );
+    }
+    game.create_lab_preview.advance(next);
+}
+
+pub(super) fn ghost(game: &Game<'_>, camera: DVec3, out: &mut Vec<Vertex>) {
+    let Some((target, opacity)) = game.create_lab_preview.visible(game) else {
+        return;
+    };
+    let origin = (DVec3::from_array(target.pos.map(f64::from)) - camera).as_vec3();
+    let start = out.len();
+    game.tinted_block_model_vertices(
+        target.state,
+        0,
+        Mat4::from_translation(origin),
+        |_| 0xF0F0,
+        false,
+        |_| None,
+        out,
+    );
+    let alpha = ((opacity * 144.0) as u32) << 24;
+    for vertex in &mut out[start..] {
+        vertex.color = (vertex.color & 0x00ff_ffff) | alpha;
+    }
+}
+
+pub(super) fn arrow(game: &Game<'_>, batch: &mut HudBatch, width: i32, height: i32) {
+    let Some((target, opacity)) = game.create_lab_preview.visible(game) else {
+        return;
+    };
+    let [x, y, z] = std::array::from_fn(|i| (target.pos[i] - target.from[i]) as f32);
+    let (sy, cy) = game.yaw.to_radians().sin_cos();
+    let (sp, cp) = game.pitch.to_radians().sin_cos();
+    let a = x * -cy - z * sy;
+    let b = -y * cp + (x * sy - z * cy) * sp;
+    if a.abs() + b.abs() < 1e-4 {
+        return;
+    }
+    let step = std::f32::consts::PI / 8.0;
+    let (s, c) = ((b.atan2(a) / step).round() * step).sin_cos();
+    let mx = width as f32 / 2.0;
+    let my = height as f32 / 2.0;
+    let point = |r: f32, w: f32| [mx + c * r - s * w, my + s * r + c * w];
+    let atlas = &game.gui.atlas;
+    let alpha = ((opacity * 255.0) as u32) << 24;
+    // A dark edge keeps the white arrow legible against both light and dark scenes.
+    for (tip, base, wing, color) in [(19.0, 10.0, 5.0, 0), (17.0, 12.0, 3.0, 0x00ff_ffff)] {
+        batch.fill_quad(
+            atlas,
+            [
+                point(tip, 0.0),
+                point(base, -wing),
+                point(base, wing),
+                point(base, wing),
+            ],
+            alpha | color,
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn appearance_takes_ten_ticks_and_fades_in_five() {
+        let mut p = Preview::default();
+        let t = Target {
+            pos: [1, 0, 0],
+            from: [0; 3],
+            state: BlockStateId(0),
+        };
+        for i in 1..=12 {
+            p.advance(Some(t));
+            assert_eq!(p.ticks, i.min(10));
+        }
+        for i in 1..=5 {
+            p.advance(None);
+            assert_eq!(p.ticks, 10 - 2 * i);
+        }
+        p.advance(None);
+        assert_eq!(p.target, None);
+    }
+}
