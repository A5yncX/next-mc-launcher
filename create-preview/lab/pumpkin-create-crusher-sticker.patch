diff --git a/crates/pumpkin-core/src/block/blocks/create_sticker.rs b/crates/pumpkin-core/src/block/blocks/create_sticker.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/blocks/create_sticker.rs
@@ -0,0 +1,136 @@
+use std::sync::Arc;
+
+use create_engine::{contraption::sticker::State, placement::Direction};
+use pumpkin_data::BlockStateId;
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_world::world::BlockFlags;
+
+use crate::{
+    block::{
+        BlockBehaviour, OnNeighborUpdateArgs, PlacedArgs,
+        blocks::{
+            create_pipe::{boolean, property, with_property},
+            redstone::block_receives_redstone_power,
+        },
+    },
+    world::World,
+};
+
+pub(crate) const ID: &str = "create:sticker";
+
+fn read_state(state: BlockStateId) -> Option<State> {
+    if state.to_block().name != ID {
+        return None;
+    }
+    let read_bool = |key| match property(state, key)? {
+        "true" => Some(true),
+        "false" => Some(false),
+        _ => None,
+    };
+    let facing = property(state, "facing")?;
+    Some(State {
+        facing: Direction::ALL
+            .into_iter()
+            .find(|dir| dir.name() == facing)?,
+        powered: read_bool("powered")?,
+        extended: read_bool("extended")?,
+    })
+}
+
+fn update(current: State, powered: bool, placement: bool) -> State {
+    if placement {
+        State {
+            powered,
+            extended: false,
+            ..current
+        }
+    } else {
+        current.with_signal(powered)
+    }
+}
+
+pub(crate) fn placed_state(
+    world: &World,
+    position: &BlockPos,
+    state: BlockStateId,
+) -> BlockStateId {
+    write_signal(world, position, state, true)
+}
+
+fn write_signal(
+    world: &World,
+    position: &BlockPos,
+    state: BlockStateId,
+    placement: bool,
+) -> BlockStateId {
+    let Some(current) = read_state(state) else {
+        return state;
+    };
+    let next = update(
+        current,
+        block_receives_redstone_power(world, position),
+        placement,
+    );
+    with_property(
+        with_property(state, "powered", boolean(next.powered)),
+        "extended",
+        boolean(next.extended),
+    )
+}
+
+fn update_signal(world: &Arc<World>, position: &BlockPos, state: BlockStateId, placement: bool) {
+    let updated = write_signal(world, position, state, placement);
+    if state != updated {
+        world.set_block_state_if(position, updated, BlockFlags::NOTIFY_ALL, |id| id == state);
+    }
+}
+
+#[pumpkin_block("create:sticker")]
+pub struct CreateStickerBlock;
+
+impl BlockBehaviour for CreateStickerBlock {
+    fn placed(&self, args: PlacedArgs<'_>) {
+        update_signal(args.world, args.position, args.state_id, true);
+    }
+
+    fn on_neighbor_update(&self, args: OnNeighborUpdateArgs<'_>) {
+        if let Some(state) = args.world.get_block_state_id_if_loaded(args.position) {
+            update_signal(args.world, args.position, state, false);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn placement_and_signal_edges_match_create_latching() {
+        let initial = State {
+            facing: Direction::West,
+            powered: false,
+            extended: true,
+        };
+        let mut state = update(initial, true, true);
+        assert_eq!(
+            state,
+            State {
+                powered: true,
+                extended: false,
+                ..initial
+            }
+        );
+        for (signal, extended) in [
+            (true, false),
+            (false, false),
+            (true, true),
+            (true, true),
+            (false, true),
+            (true, false),
+        ] {
+            state = state.with_signal(signal);
+            assert_eq!((state.powered, state.extended), (signal, extended));
+        }
+    }
+}
diff --git a/crates/pumpkin-core/src/block/entities/create_crusher.rs b/crates/pumpkin-core/src/block/entities/create_crusher.rs
