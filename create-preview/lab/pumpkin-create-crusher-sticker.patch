+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pumpkin_data::item::Item;
+
+    fn stone(count: u8) -> ItemStack {
+        ItemStack::new(
+            count,
+            Item::from_registry_key("minecraft:stone").expect("stone is registered"),
+        )
+    }
+
+    fn driven_controller() -> CreateCrushingWheelControllerBlockEntity {
+        let controller = CreateCrushingWheelControllerBlockEntity::new(BlockPos::ZERO);
+        controller.update_drive(
+            Some(WheelPair {
+                side: Direction::East,
+                axis: Axis::Z,
+            }),
+            -64.0,
+            96.0,
+        );
+        controller
+    }
+
+    #[test]
+    fn detects_a_perpendicular_pair_on_candidate_gap() {
+        let center = [0, 64, 0];
+        let pair = pair(center, |position| match position {
+            [1, 64, 0] | [-1, 64, 0] => Some(Axis::Z),
+            _ => None,
+        });
+        assert_eq!(
+            pair,
+            Some(WheelPair {
+                side: Direction::East,
+                axis: Axis::Z
+            })
+        );
+    }
+
+    #[test]
+    fn rejects_parallel_wheels_and_ambiguous_pairs() {
+        let center = [0, 64, 0];
+        assert_eq!(
+            pair(center, |position| match position {
+                [1, 64, 0] | [-1, 64, 0] => Some(Axis::X),
+                _ => None,
+            }),
+            None,
+        );
+        assert_eq!(
+            pair(center, |position| match position {
+                [1, 64, 0] | [-1, 64, 0] => Some(Axis::Z),
+                [0, 64, 1] | [0, 64, -1] => Some(Axis::X),
+                _ => None,
+            }),
+            None,
+        );
+    }
+
+    #[test]
+    fn pair_search_is_bounded_to_four_neighbor_queries() {
+        let mut queries = 0;
+        assert_eq!(
+            pair([0, 64, 0], |_| {
+                queries += 1;
+                None
+            }),
+            None
+        );
+        assert_eq!(queries, 4);
+    }
+
+    #[test]
+    fn drive_uses_engine_direction_and_rejects_non_finite_rpm() {
+        let controller = driven_controller();
+        assert_eq!(controller.state().facing, Direction::Down);
+        assert!(controller.state().valid);
+        assert_eq!(controller.state().speed, 64.0 / 50.0);
+        controller.update_drive(
+            Some(WheelPair {
+                side: Direction::East,
+                axis: Axis::Z,
+            }),
+            f32::NAN,
+            96.0,
+        );
+        assert!(!controller.state().valid);
+        assert_eq!(controller.state().speed, 0.0);
+        assert_eq!(controller.advance_cycle(), Action::Idle);
+    }
+
+    #[test]
+    fn persists_items_cycle_and_speed_and_rejects_malformed_inventory() {
+        let controller = driven_controller();
+        assert_eq!(controller.insert_stack(&stone(3), 100, true), 3);
+        assert!(controller.items.read().unwrap()[0].is_empty());
+        assert_eq!(controller.insert_stack(&stone(3), 100, false), 3);
+        assert_eq!(controller.insert_stack(&stone(1), 100, true), 0);
+        assert_eq!(controller.items.read().unwrap()[0].item_count, 3);
+        let mut nbt = NbtCompound::new();
+        controller.write_nbt(&mut nbt);
+        let restored = CreateCrushingWheelControllerBlockEntity::from_nbt(&nbt, BlockPos::ZERO);
+        assert!(restored.is_supported());
+        assert_eq!(restored.items.read().unwrap()[0].item_count, 3);
+        assert_eq!(restored.cycle.lock().unwrap().remaining, 100.0);
+        assert_eq!(restored.state().speed, 64.0 / 50.0);
+        assert!(!restored.state().valid); // pair orientation is restored from block state by the caller.
+
+        let mut malformed = NbtCompound::new();
+        let mut inventory = NbtCompound::new();
+        inventory.put_int("Size", (SLOTS - 1) as i32);
+        malformed.put_compound("Inventory", inventory);
+        let unsupported =
+            CreateCrushingWheelControllerBlockEntity::from_nbt(&malformed, BlockPos::ZERO);
+        assert!(!unsupported.is_supported());
+        assert_eq!(
+            unsupported
+                .items
+                .read()
+                .unwrap()
+                .iter()
+                .filter(|stack| !stack.is_empty())
+                .count(),
+            0,
+        );
+        let mut saved_again = NbtCompound::new();
+        unsupported.write_nbt(&mut saved_again);
+        assert_eq!(
+            saved_again
+                .get_compound("Inventory")
+                .and_then(|tag| tag.get_int("Size")),
+            Some((SLOTS - 1) as i32),
+        );
+    }
+
+    #[test]
+    fn removing_active_input_cancels_or_updates_the_cycle() {
+        let controller = driven_controller();
+        assert_eq!(controller.insert_stack(&stone(3), 100, false), 3);
+        assert_eq!(
+            Inventory::remove_stack_specific(&controller, 0, 2).item_count,
+            2
+        );
+        assert_eq!(controller.items.read().unwrap()[0].item_count, 1);
+        assert_eq!(controller.cycle.lock().unwrap().remaining, 100.0);
+
+        assert_eq!(Inventory::remove_stack(&controller, 0).item_count, 1);
+        assert_eq!(*controller.cycle.lock().unwrap(), Cycle::default());
+        assert_eq!(controller.insert_stack(&stone(1), 50, false), 1);
+    }
+
+    #[test]
+    fn clearing_resets_inventory_and_cycle_together() {
+        let controller = driven_controller();
+        assert_eq!(controller.insert_stack(&stone(3), 100, false), 3);
+        Clearable::clear(&controller);
+        assert!(
+            controller
+                .items
+                .read()
+                .unwrap()
+                .iter()
+                .all(ItemStack::is_empty)
+        );
+        assert_eq!(*controller.cycle.lock().unwrap(), Cycle::default());
+        assert_eq!(controller.insert_stack(&stone(1), 50, false), 1);
+    }
+
+    #[test]
+    fn blocked_outputs_preserve_input_and_retry_before_ejection() {
+        let controller = driven_controller();
+        assert_eq!(controller.insert_stack(&stone(2), 20, false), 2);
+        assert_eq!(controller.advance_cycle(), Action::Apply);
+        let sword = ItemStack::new(
+            u8::MAX,
+            Item::from_registry_key("minecraft:diamond_sword").expect("sword is registered"),
+        );
+        assert!(!controller.apply_outputs(&[sword]));
+        assert_eq!(controller.items.read().unwrap()[0].item_count, 2);
+        assert_eq!(controller.cycle.lock().unwrap().remaining, 1.0);
+        assert!(!controller.cycle.lock().unwrap().applied);
+
+        assert_eq!(controller.advance_cycle(), Action::Apply);
+        assert!(controller.apply_outputs(&[stone(4)]));
+        assert!(controller.items.read().unwrap()[0].is_empty());
+        assert_eq!(controller.items.read().unwrap()[1].item_count, 4);
+        assert!(!controller.finish_eject());
+        Inventory::remove_stack(&controller, 1);
+        assert!(controller.finish_eject());
+    }
+}
