+// Compact raw-ID validity checks so sparse protocol IDs do not create huge match expressions.
+fn compress_id_ranges(mut ids: Vec<u16>) -> Vec<(u16, u16)> {
+    ids.sort_unstable();
+    ids.dedup();
+    let Some(mut start) = ids.first().copied() else {
+        return Vec::new();
+    };
+    let mut end = start;
+    let mut ranges = Vec::new();
+
+    for id in ids.into_iter().skip(1) {
+        if end.checked_add(1) == Some(id) {
+            end = id;
+        } else {
+            ranges.push((start, end));
+            start = id;
+            end = id;
+        }
+    }
+    ranges.push((start, end));
+    ranges
 }
 
