+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct BlockStateArgumentType;
+
+impl<S: crate::source::CommandSource> ArgumentType<S> for BlockStateArgumentType {
+    type Item = BlockStateId;
+
+    fn parse(&self, reader: &mut StringReader) -> Result<Self::Item, CommandSyntaxError> {
+        let block = <BlockArgumentType as ArgumentType<S>>::parse(&BlockArgumentType, reader)?;
+        if reader.peek() != Some('[') {
+            return Ok(block.default_state.id);
+        }
+        let start = reader.cursor();
+        reader.read_until_space();
+        let token = &reader.string()[start..reader.cursor()];
+        let invalid = || {
+            INVALID_BLOCK_ERROR_TYPE.create(
+                reader,
+                TextComponent::text(format!("{}{token}", block.name)),
+            )
+        };
+        let fields = token
+            .strip_prefix('[')
+            .and_then(|s| s.strip_suffix(']'))
+            .ok_or_else(invalid)?;
+        if fields.is_empty() {
+            return Ok(block.default_state.id);
+        }
+        let mut properties: Vec<Property> = Vec::new();
+        for field in fields.split(',') {
+            let (key, value) = field.split_once('=').ok_or_else(invalid)?;
+            if properties.iter().any(|p| p.key_str() == key) {
+                return Err(invalid());
+            }
+            properties.push(Property::from_str_pair(key, value).ok_or_else(invalid)?);
+        }
+        let result = block.from_properties(&properties);
+        if !properties.iter().all(|p| result.to_props().contains(p)) {
+            return Err(invalid());
+        }
+        Ok(result.to_state_id(block))
+    }
+
+    fn client_side_parser(&self) -> JavaClientArgumentType {
+        JavaClientArgumentType::BlockState
+    }
+}
