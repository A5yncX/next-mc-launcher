diff --git a/crates/pumpkin-core/src/block/entities/create_kinetic.rs b/crates/pumpkin-core/src/block/entities/create_kinetic.rs
new file mode 100644
index 0000000..27642d1
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_kinetic.rs
@@ -0,0 +1,169 @@
+use std::{
+    any::Any,
+    sync::{
+        Arc,
+        atomic::{AtomicU32, Ordering},
+    },
+};
+
+use create_engine::kinetics::{Axis, Kind, Node, Pos, solve};
+use pumpkin_data::{Block, BlockStateId};
+use pumpkin_nbt::compound::NbtCompound;
+use pumpkin_util::math::position::BlockPos;
+
+use super::BlockEntity;
+use crate::world::World;
+
+pub(super) const MOTOR: &str = "create:creative_motor";
+pub(super) const SHAFT: &str = "create:shaft";
+pub(super) const COG: &str = "create:cogwheel";
+
+pub(super) struct CreateKinetic {
+    id: &'static str,
+    position: BlockPos,
+    rpm: AtomicU32,
+}
+
+impl CreateKinetic {
+    pub(super) fn new(id: &'static str, position: BlockPos) -> Self {
+        Self {
+            id,
+            position,
+            rpm: AtomicU32::new(0),
+        }
+    }
+}
+
+fn node(state: BlockStateId, pos: Pos) -> Option<Node> {
+    let block = Block::from_state_id(state);
+    let property = match block.name {
+        MOTOR => "facing",
+        SHAFT | COG => "axis",
+        _ => return None,
+    };
+    let value = block
+        .properties(state)?
+        .to_props()
+        .into_iter()
+        .find(|entry| entry.key_str() == property)?
+        .value_str();
+    let axis = match value {
+        "x" | "east" | "west" => Axis::X,
+        "y" | "up" | "down" => Axis::Y,
+        "z" | "south" | "north" => Axis::Z,
+        _ => return None,
+    };
+    let kind = match block.name {
+        MOTOR => {
+            let mut facing = [0; 3];
+            facing[axis.index()] = if matches!(value, "west" | "down" | "north") {
+                -1
+            } else {
+                1
+            };
+            Kind::Motor {
+                facing,
+                rpm: 32.0,
+                capacity: 1024.0,
+            }
+        }
+        SHAFT => Kind::Shaft,
+        _ => Kind::Cog { large: false },
+    };
+    Some(Node { pos, axis, kind })
+}
+
+impl BlockEntity for CreateKinetic {
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        let id = match nbt.get_string("id") {
+            Some(MOTOR) => MOTOR,
+            Some(SHAFT) => SHAFT,
+            _ => COG,
+        };
+        // This is a derived value. The next tick recalculates it from loaded blocks.
+        let entity = Self::new(id, position);
+        let rpm = nbt
+            .get_float("Speed")
+            .filter(|rpm| rpm.is_finite())
+            .unwrap_or(0.0);
+        entity.rpm.store(rpm.to_bits(), Ordering::Relaxed);
+        entity
+    }
+
+    fn write_nbt(&self, tag: &mut NbtCompound) {
+        tag.put_float("Speed", f32::from_bits(self.rpm.load(Ordering::Relaxed)));
+    }
+
+    fn resource_location(&self) -> &'static str {
+        self.id
+    }
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        let mut tag = NbtCompound::new();
+        self.write_nbt(&mut tag);
+        Some(tag)
+    }
+
+    fn tick(&self, world: &Arc<World>) {
+        let read = |[x, y, z]: Pos| {
+            let pos = BlockPos::new(x, y, z);
+            node(world.get_block_state_id_if_loaded(&pos)?, [x, y, z])
+        };
+        let pos = [self.position.0.x, self.position.0.y, self.position.0.z];
+        let Some(start) = read(pos) else { return };
+        // shortcut: independent loaded-neighborhood solves for the three-block lab; cache connected components before scaling up.
+        let mut exhausted = false;
+        let mut budget = 512usize;
+        let network = solve(start, |pos| {
+            let Some(left) = budget.checked_sub(1) else {
+                exhausted = true;
+                return None;
+            };
+            budget = left;
+            read(pos)
+        });
+        let rpm = if exhausted { 0.0 } else { network.speed(pos) };
+        if self.rpm.swap(rpm.to_bits(), Ordering::Relaxed) != rpm.to_bits()
+            && let Some(entity) = world.get_block_entity(&self.position)
+            && entity
+                .as_any()
+                .downcast_ref::<Self>()
+                .is_some_and(|live| std::ptr::eq(live, self))
+        {
+            world.update_block_entity(&entity);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn server_blocks_feed_the_create_solver() {
+        let states = [36349, 37744, 36344].map(|id| BlockStateId::new(id).unwrap());
+        let nodes = states
+            .into_iter()
+            .enumerate()
+            .map(|(x, state)| node(state, [x as i32, 80, 0]).unwrap())
+            .collect::<Vec<_>>();
+        let cog = nodes[2];
+        let rpm = |shaft| {
+            solve(cog, |pos| {
+                nodes
+                    .iter()
+                    .copied()
+                    .find(|n| n.pos == pos && (shaft || n.pos != [1, 80, 0]))
+            })
+            .speed(cog.pos)
+        };
+        assert_eq!(rpm(true), 32.0);
+        assert_eq!(rpm(false), 0.0);
+    }
+}
