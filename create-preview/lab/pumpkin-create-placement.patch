+
+    fn create_placement_state(
+        &self,
+        placed_block: &'static Block,
+        state_id: BlockStateId,
+        player: &Player,
+        world: &World,
+        position: BlockPos,
+        clicked: BlockDirection,
+        assist: Option<Assist>,
+    ) -> BlockStateId {
+        let ports = CreateDirection::ALL.map(|direction| {
+            let delta = direction.vector();
+            let neighbor = BlockPos::new(
+                position.0.x + delta[0],
+                position.0.y + delta[1],
+                position.0.z + delta[2],
+            );
+            world
+                .get_block_state_id_if_loaded(&neighbor)
+                .and_then(|state_id| {
+                    crate::block::entities::create_kinetic_node(
+                        state_id,
+                        [neighbor.0.x, neighbor.0.y, neighbor.0.z],
+                    )
+                })
+                .is_some_and(|node| node.shaft_port(delta.map(|d| -d)))
+        });
+        let look = pumpkin_util::math::vector3::Vector3::rotation_vector(
+            f64::from(player.get_entity().pitch.load()),
+            f64::from(player.get_entity().yaw.load()),
+        );
+        let look = Self::create_direction(BlockDirection::get_nearest(look.x, look.y, look.z));
+        let clicked = Self::create_direction(clicked);
+        let sneaking = player.get_entity().is_sneaking();
+
+        match placed_block.name {
+            "create:shaft" => {
+                let axis = assist.map_or_else(
+                    || placement::shaft(look, clicked, sneaking, ports),
+                    |assist| assist.axis,
+                );
+                Self::set_create_axis(placed_block, state_id, axis)
+            }
+            "create:cogwheel" => {
+                let delta = clicked.vector();
+                let against = BlockPos::new(
+                    position.0.x + delta[0],
+                    position.0.y + delta[1],
+                    position.0.z + delta[2],
+                );
+                let against_small = world
+                    .get_block_state_id_if_loaded(&against)
+                    .and_then(|state_id| {
+                        crate::block::entities::create_kinetic_node(
+                            state_id,
+                            [against.0.x, against.0.y, against.0.z],
+                        )
+                    })
+                    .and_then(|node| {
+                        matches!(
+                            node.kind,
+                            create_engine::kinetics::Kind::Cog { large: false }
+                        )
+                        .then_some(node.axis)
+                    });
+                let axis = assist.map_or_else(
+                    || placement::cog(clicked, sneaking, ports, against_small),
+                    |assist| assist.axis,
+                );
+                Self::set_create_axis(placed_block, state_id, axis)
+            }
+            "create:creative_motor" => {
+                let facing = placement::motor(look, sneaking, ports);
+                Self::set_create_facing(placed_block, state_id, facing)
+            }
+            _ => placed_block.default_state.id,
+        }
+    }
+
+    fn create_direction(direction: BlockDirection) -> CreateDirection {
+        match direction {
+            BlockDirection::Down => CreateDirection::Down,
+            BlockDirection::Up => CreateDirection::Up,
+            BlockDirection::North => CreateDirection::North,
+            BlockDirection::South => CreateDirection::South,
+            BlockDirection::West => CreateDirection::West,
+            BlockDirection::East => CreateDirection::East,
+        }
+    }
+
+    fn set_create_axis(
+        block: &'static Block,
+        state_id: BlockStateId,
+        axis: KineticAxis,
+    ) -> BlockStateId {
+        let Some(mut properties) = block.properties(state_id).map(|props| props.to_props()) else {
+            return state_id;
+        };
+        let Some(Property::Axis(current_axis)) = properties
+            .iter_mut()
+            .find(|property| matches!(property, Property::Axis(_)))
+        else {
+            return state_id;
+        };
+        *current_axis = match axis {
+            KineticAxis::X => BlockAxis::X,
+            KineticAxis::Y => BlockAxis::Y,
+            KineticAxis::Z => BlockAxis::Z,
+        };
+        block.from_properties(&properties).to_state_id(block)
+    }
+
+    fn set_create_facing(
+        block: &'static Block,
+        state_id: BlockStateId,
+        facing: CreateDirection,
+    ) -> BlockStateId {
+        let Some(mut properties) = block.properties(state_id).map(|props| props.to_props()) else {
+            return state_id;
+        };
+        let Some(Property::Facing(current_facing)) = properties
+            .iter_mut()
+            .find(|property| matches!(property, Property::Facing(_)))
+        else {
+            return state_id;
+        };
+        *current_facing = match facing {
+            CreateDirection::Down => BlockFacing::Down,
+            CreateDirection::Up => BlockFacing::Up,
+            CreateDirection::North => BlockFacing::North,
+            CreateDirection::South => BlockFacing::South,
+            CreateDirection::West => BlockFacing::West,
+            CreateDirection::East => BlockFacing::East,
+        };
+        block.from_properties(&properties).to_state_id(block)
+    }
