+        if !matches!(placed_block.name, "create:shaft" | "create:cogwheel")
+            || player.get_entity().is_sneaking()
+            || !matches!(
+                player.gamemode.load(),
+                GameMode::Survival | GameMode::Creative
+            )
+        {
+            return None;
+        }
+
+        let position = use_item_on.position;
+        if !world.is_in_build_limit(position) {
+            return None;
+        }
+        let cursor = [
+            f64::from(use_item_on.cursor_pos.x),
+            f64::from(use_item_on.cursor_pos.y),
+            f64::from(use_item_on.cursor_pos.z),
+        ];
+        if !cursor
+            .iter()
+            .all(|value| value.is_finite() && (0.0..=1.0).contains(value))
+        {
+            return None;
+        }
+
+        let target_state = world.get_block_state_id_if_loaded(&position)?;
+        let target = create_kinetic_node(target_state, [position.0.x, position.0.y, position.0.z])?;
+        let border = world.worldborder.lock().ok()?;
