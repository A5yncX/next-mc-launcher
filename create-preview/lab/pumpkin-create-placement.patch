+                || !border.is_within_bounds(x, z, 0.0)
+                || !border.is_within_bounds(x + 1.0 - 1.0e-5, z + 1.0 - 1.0e-5, 0.0)
+            {
+                return (None, false);
+            }
+            let Some(state_id) = world.get_block_state_id_if_loaded(&candidate) else {
+                return (None, false);
+            };
+            let block = Block::from_state_id(state_id);
+            let replaceable = if block == placed_block {
+                server.block_registry.can_update_at(
