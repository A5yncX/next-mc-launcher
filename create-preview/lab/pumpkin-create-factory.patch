+#[test]
+fn native_chute_nbt_round_trips_and_preserves_unknown_fields() {
+    let position = BlockPos::new(1, 2, 3);
+    let mut nbt = NbtCompound::new();
+    nbt.put_string("id", CreateChuteBlockEntity::ID.to_owned());
+    let mut item = NbtCompound::new();
+    ItemStack::new(7, &Item::IRON_INGOT).write_item_stack(&mut item);
+    nbt.put_compound("Item", item);
+    nbt.put_float("ItemPosition", 0.25);
+    nbt.put_float("Pull", 0.5);
+    nbt.put_float("Push", 0.75);
+    nbt.put_float("BottomAirFlowDistance", 2.0);
+    nbt.put_string("FutureChuteData", "preserve-me".to_owned());
+
+    let chute = CreateChuteBlockEntity::from_nbt(&nbt, position);
+    let mut written = NbtCompound::new();
+    chute.write_nbt(&mut written);
+
+    assert_eq!(
+        written.get_compound("Item").unwrap().get_string("id"),
+        Some("minecraft:iron_ingot")
+    );
+    assert_eq!(
+        written.get_compound("Item").unwrap().get_int("count"),
+        Some(7)
+    );
+    assert_eq!(written.get_float("ItemPosition"), Some(0.25));
+    assert_eq!(written.get_float("Pull"), Some(0.5));
+    assert_eq!(written.get_float("Push"), Some(0.75));
+    assert_eq!(written.get_float("BottomAirFlowDistance"), Some(2.0));
+    assert_eq!(written.get_string("FutureChuteData"), Some("preserve-me"));
+    assert_eq!(chute.get_position(), position);
+    assert_eq!(chute.get_stack(0).item_count, 7);
+}
