+#[test]
+fn unsupported_item_nbt_is_preserved_and_not_exposed_as_inventory() {
+    let mut nbt = NbtCompound::new();
+    nbt.put_string("id", CreateChuteBlockEntity::ID.to_owned());
+    nbt.put_string("Item", "future_item_payload".to_owned());
