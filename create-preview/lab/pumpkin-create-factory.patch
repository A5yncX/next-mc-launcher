diff --git a/crates/pumpkin-core/src/block/blocks/create_chute.rs b/crates/pumpkin-core/src/block/blocks/create_chute.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/blocks/create_chute.rs
@@ -0,0 +1,78 @@
+use std::sync::Arc;
+
+use pumpkin_data::{Block, block_properties::Property};
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_world::world::BlockFlags;
+
+use crate::{
+    block::{
+        BlockBehaviour, OnNeighborUpdateArgs, PlacedArgs, blocks::redstone,
+        entities::create_chute::CreateChuteBlockEntity,
+    },
+    world::World,
+};
+
+#[pumpkin_block("create:chute")]
+pub struct CreateChuteBlock;
+
+impl BlockBehaviour for CreateChuteBlock {
+    fn placed(&self, args: PlacedArgs<'_>) {
+        add_chute(args.world, args.position, false);
+    }
+}
+
+#[pumpkin_block("create:smart_chute")]
+pub struct CreateSmartChuteBlock;
+
+impl BlockBehaviour for CreateSmartChuteBlock {
+    fn placed(&self, args: PlacedArgs<'_>) {
+        update_powered(args.world, args.block, args.position);
+        add_chute(args.world, args.position, true);
+    }
+
+    fn on_neighbor_update(&self, args: OnNeighborUpdateArgs<'_>) {
+        update_powered(args.world, args.block, args.position);
+    }
+}
+
+fn update_powered(world: &Arc<World>, block: &Block, position: &BlockPos) {
+    let powered = redstone::block_receives_redstone_power(world, position);
+    let (_, state) = world.get_block_and_state_id(position);
+    let Some(mut properties) = block
+        .properties(state)
+        .map(|properties| properties.to_props())
+    else {
+        return;
+    };
+    let value = if powered { "true" } else { "false" };
+    let Some(property) = Property::from_str_pair("powered", value) else {
+        return;
+    };
+    let Some(current) = properties
+        .iter_mut()
+        .find(|property| property.key_str() == "powered")
+    else {
+        return;
+    };
+    if current.value_str() == value {
+        return;
+    }
+    *current = property;
+    world.set_block_state(
+        position,
+        block.from_properties(&properties).to_state_id(block),
+        BlockFlags::NOTIFY_ALL,
+    );
+}
+
+fn add_chute(world: &Arc<World>, position: &BlockPos, smart: bool) {
+    if world.get_block_entity(position).is_none() {
+        let entity = if smart {
+            CreateChuteBlockEntity::new_smart(*position)
+        } else {
+            CreateChuteBlockEntity::new(*position)
+        };
+        world.add_block_entity(Arc::new(entity));
+    }
+}
diff --git a/crates/pumpkin-core/src/block/blocks/create_millstone.rs b/crates/pumpkin-core/src/block/blocks/create_millstone.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/blocks/create_millstone.rs
@@ -0,0 +1,129 @@
+use std::sync::Arc;
+
+use pumpkin_data::data_component_impl::EquipmentSlot;
+use pumpkin_data::{BlockDirection, entity::EntityType, item_stack::ItemStack};
+use pumpkin_inventory::screen_handler::InventoryPlayer;
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::{Hand, math::vector3::Vector3};
+
+use crate::{
+    block::{
+        BlockBehaviour, NormalUseArgs, PlacedArgs, UseWithItemArgs,
+        entities::create_millstone::CreateMillstoneBlockEntity, registry::BlockActionResult,
+    },
+    entity::{Entity, EntityBase, item::ItemEntity, player::Player},
+    world::World,
+};
+
+#[pumpkin_block("create:millstone")]
+pub struct CreateMillstoneBlock;
+
+impl BlockBehaviour for CreateMillstoneBlock {
+    fn normal_use(&self, args: NormalUseArgs<'_>) -> BlockActionResult {
+        if args.hit.face != &BlockDirection::Up || shift_has_item(args.player) {
+            return BlockActionResult::Pass;
+        }
+        if interact(args.world, args.player, args.position) {
+            BlockActionResult::SuccessServer
+        } else {
+            BlockActionResult::Pass
+        }
+    }
+
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        if args.hit.face != &BlockDirection::Up || shift_has_item(args.player) {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        let Some(entity) = args.world.get_block_entity(args.position) else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        let Some(millstone) = entity
+            .as_any()
+            .downcast_ref::<CreateMillstoneBlockEntity>()
+            .filter(|millstone| millstone.is_supported())
+        else {
+            return BlockActionResult::PassToDefaultBlockAction;
+        };
+        let hand = if *args.equipment_slot == EquipmentSlot::OFF_HAND {
+            Hand::Left
+        } else {
+            Hand::Right
+        };
+        let incoming = args.item_stack.clone();
+        let inserted = millstone.insert_stack(&incoming);
+        if inserted == 0 {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        let mut remaining = incoming;
+        remaining.item_count -= inserted;
+        if remaining.is_empty() {
+            remaining = ItemStack::EMPTY.clone();
+        }
+        let inventory = args.player.get_inventory();
+        inventory.set_stack_in_hand(hand, remaining);
+        args.player.sync_inventory_to_client();
+        *args.item_stack = inventory.get_stack_in_hand(hand);
+        args.world.update_block_entity(&entity);
+        BlockActionResult::SuccessServer
+    }
+
+    fn placed(&self, args: PlacedArgs<'_>) {
+        if args.world.get_block_entity(args.position).is_none() {
+            args.world
+                .add_block_entity(Arc::new(CreateMillstoneBlockEntity::new(*args.position)));
+        }
+    }
+}
+
+fn shift_has_item(player: &Player) -> bool {
+    player.get_entity().is_sneaking()
+        && [Hand::Right, Hand::Left]
+            .into_iter()
+            .any(|hand| !player.get_inventory().get_stack_in_hand(hand).is_empty())
+}
+
+fn interact(
+    world: &Arc<World>,
+    player: &Arc<Player>,
+    position: &pumpkin_util::math::position::BlockPos,
+) -> bool {
+    let Some(entity) = world.get_block_entity(position) else {
+        return false;
+    };
+    let Some(millstone) = entity
+        .as_any()
+        .downcast_ref::<CreateMillstoneBlockEntity>()
+        .filter(|millstone| millstone.is_supported())
+    else {
+        return false;
+    };
+    let stacks = millstone.collect_items();
+    if stacks.is_empty() {
+        return false;
+    }
+    let inventory = player.get_inventory();
+    for mut stack in stacks {
+        inventory.insert_stack_anywhere(&mut stack);
+        if !stack.is_empty() {
+            drop_overflow(world, player, stack);
+        }
+    }
+    player.sync_inventory_to_client();
+    world.update_block_entity(&entity);
+    true
+}
+
+fn drop_overflow(world: &Arc<World>, player: &Player, stack: ItemStack) {
+    let player_pos = player.get_entity().pos.load();
+    let entity = Entity::new(
+        world.clone(),
+        Vector3::new(player_pos.x, player_pos.y + 1.0, player_pos.z),
+        &EntityType::ITEM,
+    );
+    world.spawn_entity(Arc::new(ItemEntity::new_with_velocity(
+        entity,
+        stack,
+        Vector3::new(0.0, 0.2, 0.0),
+        10,
+    )));
+}
diff --git a/crates/pumpkin-core/src/block/entities/create_chute.rs b/crates/pumpkin-core/src/block/entities/create_chute.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_chute.rs
@@ -0,0 +1,616 @@
+use std::{
+    any::Any,
+    sync::{
+        Arc, PoisonError, RwLock,
+        atomic::{AtomicBool, AtomicU32, Ordering},
+    },
+};
+
+use pumpkin_data::{Block, BlockStateId, item_stack::ItemStack};
+use pumpkin_inventory::{Clearable, Inventory};
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::position::BlockPos;
+
+use super::{BlockEntity, hopper::HopperBlockEntity};
+use crate::world::World;
+
+pub const ID: &str = "create:chute";
+pub const SMART_ID: &str = "create:smart_chute";
+const NORMAL_EXTRACTION: u8 = 16;
+const MAX_STACK: u8 = 64;
+const NATIVE_FIELDS: [&str; 9] = [
+    "id",
+    "x",
+    "y",
+    "z",
+    "Item",
+    "ItemPosition",
+    "Pull",
+    "Push",
+    "BottomAirFlowDistance",
+];
+const SMART_FIELDS: [&str; 3] = ["Filter", "FilterAmount", "UpTo"];
+
+struct Extraction {
+    one_item: ItemStack,
+    snapshot: ItemStack,
+    remainder: ItemStack,
+}
+
+pub struct CreateChuteBlockEntity {
+    pub position: BlockPos,
+    item: RwLock<ItemStack>,
+    item_position: AtomicU32,
+    pull: AtomicU32,
+    push: AtomicU32,
+    bottom_air_flow_distance: AtomicU32,
+    filter: ItemStack,
+    opaque_item: Option<NbtTag>,
+    opaque_filter: Option<NbtTag>,
+    opaque_fields: NbtCompound,
+    filter_amount: i32,
+    up_to: bool,
+    powered: AtomicBool,
+    smart: bool,
+    dirty: AtomicBool,
+}
+
+impl BlockEntity for CreateChuteBlockEntity {
+    fn resource_location(&self) -> &'static str {
+        if self.smart { SMART_ID } else { ID }
+    }
+
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        let smart = nbt.get_string("id") == Some(SMART_ID);
+        let (item, opaque_item) = read_stack(nbt, "Item");
+        let (filter, opaque_filter) = if smart {
+            read_stack(nbt, "Filter")
+        } else {
+            (ItemStack::EMPTY.clone(), None)
+        };
+        let position_in_chute = nbt
+            .get_float("ItemPosition")
+            .filter(|v| v.is_finite())
+            .unwrap_or(0.0)
+            .clamp(0.0, 1.0);
+        let mut filter_amount = nbt.get_int("FilterAmount").unwrap_or(0);
+        let mut up_to = nbt.get_bool("UpTo").unwrap_or(false);
+        if filter_amount == 0 {
+            filter_amount = i32::from(MAX_STACK);
+            up_to = true;
+        }
+
+        let mut opaque_fields = NbtCompound::new();
+        for (key, value) in &nbt.child_tags {
+            let key = key.as_ref();
+            if !NATIVE_FIELDS.contains(&key) && !(smart && SMART_FIELDS.contains(&key)) {
+                opaque_fields.put(key, value.clone());
+            }
+        }
+
+        Self {
+            position,
+            item: RwLock::new(item),
+            item_position: AtomicU32::new(position_in_chute.to_bits()),
+            pull: AtomicU32::new(nbt.get_float("Pull").unwrap_or(0.0).to_bits()),
+            push: AtomicU32::new(nbt.get_float("Push").unwrap_or(0.0).to_bits()),
+            bottom_air_flow_distance: AtomicU32::new(
+                nbt.get_float("BottomAirFlowDistance")
+                    .unwrap_or(0.0)
+                    .to_bits(),
+            ),
+            filter,
+            opaque_item,
+            opaque_filter,
+            opaque_fields,
+            filter_amount,
+            up_to,
+            powered: AtomicBool::new(smart),
+            smart,
+            dirty: AtomicBool::new(false),
+        }
+    }
+
+    fn write_nbt(&self, nbt: &mut NbtCompound) {
+        for (key, value) in &self.opaque_fields.child_tags {
+            nbt.put(key, value.clone());
+        }
+        if let Some(item) = &self.opaque_item {
+            nbt.put("Item", item.clone());
+        } else {
+            let mut item = NbtCompound::new();
+            self.item
+                .read()
+                .unwrap_or_else(PoisonError::into_inner)
+                .write_item_stack(&mut item);
+            nbt.put_compound("Item", item);
+        }
+        nbt.put_float(
+            "ItemPosition",
+            f32::from_bits(self.item_position.load(Ordering::Relaxed)),
+        );
+        nbt.put_float("Pull", f32::from_bits(self.pull.load(Ordering::Relaxed)));
+        nbt.put_float("Push", f32::from_bits(self.push.load(Ordering::Relaxed)));
+        nbt.put_float(
+            "BottomAirFlowDistance",
+            f32::from_bits(self.bottom_air_flow_distance.load(Ordering::Relaxed)),
+        );
+        if self.smart {
+            if let Some(filter) = &self.opaque_filter {
+                nbt.put("Filter", filter.clone());
+            } else {
+                let mut filter = NbtCompound::new();
+                self.filter.write_item_stack(&mut filter);
+                nbt.put_compound("Filter", filter);
+            }
+            nbt.put_int("FilterAmount", self.filter_amount);
+            nbt.put_bool("UpTo", self.up_to);
+        }
+    }
+
+    fn tick(&self, world: &Arc<World>) {
+        if self.opaque_item.is_some() {
+            return;
+        }
+        let (block, state) = world.get_block_and_state_id(&self.position);
+        let smart = block.name == SMART_ID;
+        if (block.name != ID && !smart) || smart != self.smart {
+            return;
+        }
+        let powered = smart && bool_property(block, state, "powered").unwrap_or(true);
+        self.powered.store(powered, Ordering::Relaxed);
+
+        let Some(output_pos) = offset(self.position, [0, -1, 0]) else {
+            return;
+        };
+        let Some(input_pos) = offset(self.position, [0, 1, 0]) else {
+            return;
+        };
+
+        let mut changed = false;
+        let mut spills = Vec::new();
+        let carried = self.get_stack(0);
+        if !powered && !carried.is_empty() {
+            use create_engine::chute::{Step, motion, step};
+            let target = world
+                .get_block_entity(&output_pos)
+                .filter(|entity| !entity.has_loot_table())
+                .and_then(|entity| Some((entity.clone(), entity.get_inventory()?)));
+            let previous = f32::from_bits(self.item_position.load(Ordering::Relaxed));
+            match step(previous, motion(0.0, 0.0), || {
+                target.as_ref().is_some_and(|(_, inventory)| {
+                    (0..inventory.size()).any(|slot| {
+                        inventory.is_valid_slot_for(slot, &carried) && {
+                            let existing = inventory.get_stack(slot);
+                            existing.is_empty()
+                                || (existing.are_items_and_components_equal(&carried)
+                                    && existing.item_count < existing.get_max_stack_size())
+                        }
+                    })
+                })
+            }) {
+                Step::Position(next) => {
+                    self.item_position.store(next.to_bits(), Ordering::Relaxed);
+                    changed = previous != next;
+                }
+                Step::Output => {
+                    if let Some((entity, target)) = target {
+                        let (moved, overflow) = self.push_to(target.as_ref());
+                        if moved {
+                            world.update_block_entity(&entity);
+                        }
+                        let position = if self.get_stack(0).is_empty() {
+                            0.0_f32
+                        } else {
+                            0.5_f32
+                        };
+                        self.item_position
+                            .store(position.to_bits(), Ordering::Relaxed);
+                        changed = moved || previous != position;
+                        spills.extend(overflow);
+                    }
+                }
+            }
+        }
+        if !powered
+            && self.get_stack(0).is_empty()
+            && let Some(entity) = world
+                .get_block_entity(&input_pos)
+                .filter(|entity| !entity.has_loot_table())
+            && let Some(source) = entity.clone().get_inventory()
+        {
+            let (moved, overflow) = self.pull_from(source.as_ref(), powered);
+            if moved {
+                world.update_block_entity(&entity);
+            }
+            changed |= moved;
+            spills.extend(overflow);
+        }
+
+        if !spills.is_empty() {
+            let pos = self.position.to_centered_f64();
+            for stack in spills {
+                world.scatter_stack(pos.x, pos.y, pos.z, stack);
+            }
+        }
+        if changed {
+            self.mark_dirty();
+            if let Some(entity) = world.get_block_entity(&self.position)
+                && entity
+                    .as_any()
+                    .downcast_ref::<Self>()
+                    .is_some_and(|live| std::ptr::eq(self, live))
+            {
+                world.update_block_entity(&entity);
+            }
+        }
+    }
+
+    fn get_inventory(self: Arc<Self>) -> Option<Arc<dyn Inventory>> {
+        self.opaque_item.is_none().then_some(self)
+    }
+
+    fn on_block_replaced(self: Arc<Self>, world: &Arc<World>, position: &BlockPos) {
+        if self.opaque_item.is_none() {
+            let inventory: Arc<dyn Inventory> = self;
+            world.scatter_inventory(position, &inventory);
+        }
+    }
+
+    fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Relaxed)
+    }
+
+    fn clear_dirty(&self) {
+        self.dirty.store(false, Ordering::Relaxed);
+    }
+
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        let mut nbt = NbtCompound::new();
+        self.write_nbt(&mut nbt);
+        Some(nbt)
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl CreateChuteBlockEntity {
+    #[cfg(test)]
+    pub const ID: &'static str = ID;
+    #[cfg(test)]
+    pub const SMART_ID: &'static str = SMART_ID;
+
+    #[must_use]
+    pub fn new(position: BlockPos) -> Self {
+        Self::with_mode(position, false)
+    }
+
+    #[must_use]
+    pub fn new_smart(position: BlockPos) -> Self {
+        Self::with_mode(position, true)
+    }
+
+    fn with_mode(position: BlockPos, smart: bool) -> Self {
+        Self {
+            position,
+            item: RwLock::new(ItemStack::EMPTY.clone()),
+            item_position: AtomicU32::new(0.0_f32.to_bits()),
+            pull: AtomicU32::new(0.0_f32.to_bits()),
+            push: AtomicU32::new(0.0_f32.to_bits()),
+            bottom_air_flow_distance: AtomicU32::new(0.0_f32.to_bits()),
+            filter: ItemStack::EMPTY.clone(),
+            opaque_item: None,
+            opaque_filter: None,
+            opaque_fields: NbtCompound::new(),
+            filter_amount: i32::from(MAX_STACK),
+            up_to: true,
+            powered: AtomicBool::new(smart),
+            smart,
+            dirty: AtomicBool::new(false),
+        }
+    }
+
+    pub fn pull_from(&self, source: &dyn Inventory, powered: bool) -> (bool, Vec<ItemStack>) {
+        self.powered.store(powered, Ordering::Relaxed);
+        if self.opaque_item.is_some()
+            || (self.smart && powered)
+            || source
+                .as_any()
+                .downcast_ref::<Self>()
+                .is_some_and(|other| std::ptr::eq(other, self))
+            || !self.get_stack(0).is_empty()
+        {
+            return (false, Vec::new());
+        }
+
+        for slot in 0..source.size() {
+            let candidate = source.get_stack(slot);
+            if candidate.is_empty()
+                || !source.can_transfer_to(self, slot, &candidate)
+                || !self.filter_matches(&candidate)
+            {
+                continue;
+            }
+            let Some(amount) = self.extraction_amount(candidate.item_count) else {
+                continue;
+            };
+            let extracted = source.remove_stack_specific(slot, amount);
+            if extracted.is_empty() {
+                continue;
+            }
+            let expected_remainder = remainder_after(&candidate, &extracted);
+            let mut held = self.item.write().unwrap_or_else(PoisonError::into_inner);
+            if held.is_empty() && self.filter_matches(&extracted) {
+                *held = extracted;
+                self.item_position
+                    .store(create_engine::chute::ENTRY.to_bits(), Ordering::Relaxed);
+                self.mark_dirty();
+                return (true, Vec::new());
+            }
+            drop(held);
+            let spill =
+                restore_inventory_slot(source, slot, &candidate, &expected_remainder, extracted);
+            return (false, spill.into_iter().collect());
+        }
+        (false, Vec::new())
+    }
+
+    pub fn push_to(&self, target: &dyn Inventory) -> (bool, Vec<ItemStack>) {
+        if self.opaque_item.is_some() || (self.smart && self.powered.load(Ordering::Relaxed)) {
+            return (false, Vec::new());
+        }
+        let mut moved = false;
+        let mut spills = Vec::new();
+        while let Some(extraction) = self.take_one() {
+            if HopperBlockEntity::add_one_item(self, target, &extraction.one_item) {
+                moved = true;
+                continue;
+            }
+            if let Some(spill) = self.put_back(extraction) {
+                spills.push(spill);
+            }
+            break;
+        }
+        (moved, spills)
+    }
+
+    fn extraction_amount(&self, available: u8) -> Option<u8> {
+        let amount = if self.smart {
+            self.filter_amount.clamp(1, i32::from(MAX_STACK)) as u8
+        } else {
+            NORMAL_EXTRACTION
+        };
+        if self.smart && !self.up_to {
+            (available >= amount).then_some(amount)
+        } else {
+            Some(available.min(amount))
+        }
+    }
+
+    fn filter_matches(&self, stack: &ItemStack) -> bool {
+        if !self.smart {
+            return true;
+        }
+        if self.opaque_filter.is_some() {
+            return false;
+        }
+        self.filter.is_empty() || self.filter.are_items_and_components_equal(stack)
+    }
+
+    fn take_one(&self) -> Option<Extraction> {
+        let mut item = self.item.write().unwrap_or_else(PoisonError::into_inner);
+        if item.is_empty() {
+            return None;
+        }
+        let snapshot = item.clone();
+        let one_item = item.split(1);
+        let remainder = item.clone();
+        self.mark_dirty();
+        Some(Extraction {
+            one_item,
+            snapshot,
+            remainder,
+        })
+    }
+
+    fn put_back(&self, extraction: Extraction) -> Option<ItemStack> {
+        let mut item = self.item.write().unwrap_or_else(PoisonError::into_inner);
+        self.mark_dirty();
+        if item.are_equal(&extraction.remainder) {
+            *item = extraction.snapshot;
+            return None;
+        }
+        if item.is_empty() {
+            *item = extraction.one_item;
+            return None;
+        }
+        if item.are_items_and_components_equal(&extraction.one_item)
+            && item.item_count < item.get_max_stack_size()
+        {
+            item.item_count += 1;
+            return None;
+        }
+        Some(extraction.one_item)
+    }
+
+    fn mark_dirty(&self) {
+        self.dirty.store(true, Ordering::Relaxed);
+    }
+}
+
+impl Inventory for CreateChuteBlockEntity {
+    fn size(&self) -> usize {
+        1
+    }
+
+    fn is_empty(&self) -> bool {
+        self.get_stack(0).is_empty()
+    }
+
+    fn get_stack(&self, slot: usize) -> ItemStack {
+        if slot != 0 {
+            return ItemStack::EMPTY.clone();
+        }
+        self.item
+            .read()
+            .unwrap_or_else(PoisonError::into_inner)
+            .clone()
+    }
+
+    fn remove_stack(&self, slot: usize) -> ItemStack {
+        if slot != 0 {
+            return ItemStack::EMPTY.clone();
+        }
+        let mut item = self.item.write().unwrap_or_else(PoisonError::into_inner);
+        let removed = std::mem::replace(&mut *item, ItemStack::EMPTY.clone());
+        if !removed.is_empty() {
+            self.item_position
+                .store(0.0_f32.to_bits(), Ordering::Relaxed);
+            self.mark_dirty();
+        }
+        removed
+    }
+
+    fn remove_stack_specific(&self, slot: usize, amount: u8) -> ItemStack {
+        if slot != 0 || amount == 0 {
+            return ItemStack::EMPTY.clone();
+        }
+        let mut item = self.item.write().unwrap_or_else(PoisonError::into_inner);
+        if item.is_empty() {
+            return ItemStack::EMPTY.clone();
+        }
+        let removed = item.split(amount);
+        if item.is_empty() {
+            self.item_position
+                .store(0.0_f32.to_bits(), Ordering::Relaxed);
+        }
+        self.mark_dirty();
+        removed
+    }
+
+    fn set_stack(&self, slot: usize, stack: ItemStack) {
+        if !self.is_valid_slot_for(slot, &stack) {
+            return;
+        }
+        *self.item.write().unwrap_or_else(PoisonError::into_inner) = stack;
+        self.mark_dirty();
+    }
+
+    fn get_max_count_per_stack(&self) -> u8 {
+        MAX_STACK
+    }
+
+    fn is_valid_slot_for(&self, slot: usize, stack: &ItemStack) -> bool {
+        if slot != 0
+            || self.opaque_item.is_some()
+            || (self.smart && self.powered.load(Ordering::Relaxed))
+            || (!stack.is_empty() && stack.item_count > stack.get_max_stack_size())
+            || !self.filter_matches(stack)
+        {
+            return false;
+        }
+        let current = self.get_stack(0);
+        current.is_empty()
+            || (current.are_items_and_components_equal(stack)
+                && current.item_count < current.get_max_stack_size())
+    }
+
+    fn can_transfer_to(&self, _target: &dyn Inventory, slot: usize, stack: &ItemStack) -> bool {
+        slot == 0 && self.opaque_item.is_none() && self.filter_matches(stack)
+    }
+
+    fn mark_dirty(&self) {
+        self.dirty.store(true, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl Clearable for CreateChuteBlockEntity {
+    fn clear(&self) {
+        self.item
+            .write()
+            .unwrap_or_else(PoisonError::into_inner)
+            .clear();
+        self.item_position
+            .store(0.0_f32.to_bits(), Ordering::Relaxed);
+        self.mark_dirty();
+    }
+}
+
+fn read_stack(nbt: &NbtCompound, key: &str) -> (ItemStack, Option<NbtTag>) {
+    match nbt.child_tags.get(key) {
+        None => (ItemStack::EMPTY.clone(), None),
+        Some(NbtTag::Compound(compound)) if compound.is_empty() => (ItemStack::EMPTY.clone(), None),
+        Some(NbtTag::Compound(compound)) => match ItemStack::read_item_stack(compound) {
+            Some(stack) => (stack, None),
+            None => (
+                ItemStack::EMPTY.clone(),
+                Some(NbtTag::Compound(compound.clone())),
+            ),
+        },
+        Some(tag) => (ItemStack::EMPTY.clone(), Some(tag.clone())),
+    }
+}
+
+fn remainder_after(original: &ItemStack, extracted: &ItemStack) -> ItemStack {
+    let mut remainder = original.clone();
+    remainder.decrement(extracted.item_count);
+    if remainder.is_empty() {
+        ItemStack::EMPTY.clone()
+    } else {
+        remainder
+    }
+}
+
+fn restore_inventory_slot(
+    inventory: &dyn Inventory,
+    slot: usize,
+    original: &ItemStack,
+    expected_remainder: &ItemStack,
+    extracted: ItemStack,
+) -> Option<ItemStack> {
+    let mut current = inventory.get_stack(slot);
+    if current.are_equal(expected_remainder) {
+        inventory.set_stack(slot, original.clone());
+        return (!inventory.get_stack(slot).are_equal(original)).then_some(extracted);
+    }
+    if current.is_empty() {
+        inventory.set_stack(slot, extracted.clone());
+        return (!inventory.get_stack(slot).are_equal(&extracted)).then_some(extracted);
+    }
+    if current.are_items_and_components_equal(&extracted)
+        && u16::from(current.item_count) + u16::from(extracted.item_count)
+            <= u16::from(current.get_max_stack_size())
+    {
+        current.item_count += extracted.item_count;
+        inventory.set_stack(slot, current.clone());
+        return (!inventory.get_stack(slot).are_equal(&current)).then_some(extracted);
+    }
+    Some(extracted)
+}
+
+fn bool_property(block: &Block, state: BlockStateId, key: &str) -> Option<bool> {
+    block
+        .properties(state)?
+        .to_props()
+        .into_iter()
+        .find(|property| property.key_str() == key)
+        .map(|property| property.value_str() == "true")
+}
+
+fn offset(position: BlockPos, direction: [i32; 3]) -> Option<BlockPos> {
+    Some(BlockPos::new(
+        position.0.x.checked_add(direction[0])?,
+        position.0.y.checked_add(direction[1])?,
+        position.0.z.checked_add(direction[2])?,
+    ))
+}
diff --git a/crates/pumpkin-core/src/block/entities/create_fan_airflow.rs b/crates/pumpkin-core/src/block/entities/create_fan_airflow.rs
