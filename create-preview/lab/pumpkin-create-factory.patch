+use super::*;
+
+fn loaded(count: u8) -> CreateMillstoneBlockEntity {
+    let mill = CreateMillstoneBlockEntity::new(BlockPos::new(0, 0, 0));
+    assert_eq!(
+        mill.insert_stack(&ItemStack::new(count, &Item::WHEAT)),
+        count
+    );
+    mill
+}
+
+#[test]
+fn all_pinned_recipe_outputs_resolve_and_wool_tag_is_supported() {
+    assert_eq!(recipes().len(), 47);
+    assert!(recipe_for(&ItemStack::new(1, &Item::WHITE_WOOL)).is_some());
+    for recipe in recipes() {
+        assert!(recipe.duration > 0);
+        assert!(
+            recipe
+                .ingredients
+                .iter()
+                .all(|key| key == "#minecraft:wool" || Item::from_registry_key(key).is_some()),
+            "{:?}",
+            recipe.ingredients
+        );
+        assert!(
+            recipe
+                .results
+                .iter()
+                .all(|output| Item::from_registry_key(&output.id).is_some()
+                    && output.count > 0
+                    && (0.0..=1.0).contains(&output.chance)),
+            "{:?}",
+            recipe.ingredients
+        );
+    }
+}
+
+#[test]
+fn seeded_outcomes_use_each_pinned_chance_and_consume_one_item() {
+    let mill = loaded(2);
+    let mut items = mill.items.write().unwrap();
+    let mut draws = [0.1, 0.9, 0.1].into_iter();
+    assert!(process_items(&mut items, || draws.next().unwrap()));
+    assert_eq!(items[0].item_count, 1);
+    assert_eq!(items[1].get_item(), &Item::CREATE_WHEAT_FLOUR);
+    assert_eq!(items[1].item_count, 2);
+    assert_eq!(items[2].get_item(), &Item::WHEAT_SEEDS);
+    assert_eq!(items[2].item_count, 1);
+    assert!(draws.next().is_none());
+}
+
+#[test]
+fn full_output_leaves_input_and_does_not_roll_again() {
+    let mill = loaded(2);
+    let mut items = mill.items.write().unwrap();
+    for slot in &mut items[OUTPUT_START..] {
+        *slot = ItemStack::new(64, &Item::STONE);
+    }
+    assert!(!process_items(&mut items, || panic!(
+        "blocked output must not roll"
+    )));
+    assert_eq!(items[0].item_count, 2);
+}
+
+#[test]
+fn pending_inventory_and_timer_round_trip_and_output_is_collected_first() {
+    let mill = loaded(2);
+    assert!(super::process(&mill));
+    assert_eq!(mill.insert_stack(&ItemStack::new(1, &Item::STONE)), 0);
+    let mut nbt = NbtCompound::new();
+    mill.write_nbt(&mut nbt);
+    assert_eq!(
+        nbt.get_compound("InputInventory").unwrap().get_int("Size"),
+        Some(1)
+    );
+    assert_eq!(
+        nbt.get_compound("OutputInventory").unwrap().get_int("Size"),
+        Some(9)
+    );
+    nbt.put_int("Timer", 37);
+    let restored = CreateMillstoneBlockEntity::from_nbt(&nbt, BlockPos::new(1, 2, 3));
+    let mut saved = NbtCompound::new();
+    restored.write_nbt(&mut saved);
+    assert_eq!(saved.get_int("Timer"), Some(37));
+    assert_eq!(
+        restored.collect_items()[0].get_item(),
+        &Item::CREATE_WHEAT_FLOUR
+    );
+    assert_eq!(restored.collect_items()[0].get_item(), &Item::WHEAT);
+}
+
+#[test]
+fn opaque_inventory_is_preserved_and_not_processed() {
+    let mut nbt = NbtCompound::new();
+    nbt.put_int("InputInventory", 17);
+    let mill = CreateMillstoneBlockEntity::from_nbt(&nbt, BlockPos::new(1, 2, 3));
+    assert!(!mill.is_supported());
+    assert!(!super::process(&mill));
+    let mut saved = NbtCompound::new();
+    mill.write_nbt(&mut saved);
+    assert_eq!(saved.get_int("InputInventory"), Some(17));
+}
