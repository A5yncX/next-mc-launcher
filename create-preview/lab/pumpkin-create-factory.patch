--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_fan_airflow.rs
@@ -0,0 +1,218 @@
+use create_engine::{
+    fan::{self, Config},
+    fan_entities,
+    placement::Direction,
+};
+use pumpkin_data::{Block, BlockStateId};
+use pumpkin_util::math::position::BlockPos;
+
+pub(crate) const ID: &str = "create:encased_fan";
+pub(super) const TAG: &str = "CreateHorizonAirCurrent";
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Airflow {
+    position: BlockPos,
+    facing: Direction,
+    flow: [i32; 3],
+    rpm: f32,
+    pushing: bool,
+    nominal_distance: f32,
+    reach: f32,
+}
+
+impl Airflow {
+    fn wire(self) -> [i32; 8] {
+        let direction = Direction::ALL
+            .iter()
+            .position(|dir| *dir == self.facing)
+            .unwrap_or(0);
+        [
+            2,
+            direction as i32,
+            self.rpm.to_bits() as i32,
+            self.reach.to_bits() as i32,
+            1,
+            if self.pushing {
+                self.reach.ceil() as i32
+            } else {
+                0
+            },
+            0,
+            0,
+        ]
+    }
+
+    #[cfg(test)]
+    pub(crate) fn nominal_distance(self) -> f32 {
+        self.nominal_distance
+    }
+
+    #[cfg(test)]
+    pub(crate) fn reach(self) -> f32 {
+        self.reach
+    }
+
+    #[cfg(test)]
+    pub(crate) fn pushing(self) -> bool {
+        self.pushing
+    }
+
+    #[cfg(test)]
+    pub(crate) fn flow(self) -> [i32; 3] {
+        self.flow
+    }
+
+    pub(crate) fn bounds(self) -> [[f64; 3]; 2] {
+        let mut min = [
+            f64::from(self.position.0.x),
+            f64::from(self.position.0.y),
+            f64::from(self.position.0.z),
+        ];
+        let mut max = min.map(|coordinate| coordinate + 1.0);
+        for (axis, direction) in self.facing.vector().into_iter().enumerate() {
+            if direction > 0 {
+                min[axis] += 1.0;
+                max[axis] += f64::from(self.reach);
+            } else if direction < 0 {
+                min[axis] -= f64::from(self.reach);
+                max[axis] -= 1.0;
+            }
+        }
+        [min, max]
+    }
+
+    pub(crate) fn affects(self, entity_bounds: [[f64; 3]; 2]) -> bool {
+        fan_entities::intersects(self.bounds(), entity_bounds)
+    }
+
+    pub(crate) fn velocity(
+        self,
+        entity_bounds: [[f64; 3]; 2],
+        position: [f64; 3],
+        velocity: [f64; 3],
+        sneaking: bool,
+    ) -> Option<[f64; 3]> {
+        self.affects(entity_bounds).then(|| {
+            let origin = [
+                f64::from(self.position.0.x) + 0.5,
+                f64::from(self.position.0.y) + 0.5,
+                f64::from(self.position.0.z) + 0.5,
+            ];
+            fan_entities::movement(
+                velocity,
+                position,
+                origin,
+                self.flow,
+                self.rpm,
+                self.nominal_distance,
+                sneaking,
+            )
+        })
+    }
+}
+
+pub(super) fn tick(
+    world: &crate::world::World,
+    position: BlockPos,
+    state: BlockStateId,
+    rpm: f32,
+) -> Option<[i32; 8]> {
+    use pumpkin_data::entity::EntityType;
+    use pumpkin_util::math::{boundingbox::BoundingBox, vector3::Vector3};
+    let flow = current(position, state, rpm, |pos| {
+        world.get_block_state_id_if_loaded(&pos)
+    })?;
+    let [min, max] = flow.bounds();
+    for entity in world.get_entities_at_box(&BoundingBox::new_array(min, max)) {
+        let base = entity.get_entity();
+        // The pinned Horizon client uses the same synced current for its own player.
+        if base.entity_type == &EntityType::PLAYER || !base.is_alive() || entity.is_spectator() {
+            continue;
+        }
+        let bounds = base.bounding_box.load();
+        let xyz = |vector: Vector3<f64>| [vector.x, vector.y, vector.z];
+        if let Some([x, y, z]) = flow.velocity(
+            [xyz(bounds.min), xyz(bounds.max)],
+            xyz(base.pos.load()),
+            xyz(base.velocity.load()),
+            base.is_sneaking(),
+        ) {
+            base.set_velocity(Vector3::new(x, y, z));
+        }
+    }
+    Some(flow.wire())
+}
+
+pub(crate) fn current(
+    position: BlockPos,
+    state: BlockStateId,
+    rpm: f32,
+    mut state_at: impl FnMut(BlockPos) -> Option<BlockStateId>,
+) -> Option<Airflow> {
+    if !rpm.is_finite() || rpm == 0.0 || Block::from_state_id(state).name != ID {
+        return None;
+    }
+    let block = Block::from_state_id(state);
+    let facing = block
+        .properties(state)?
+        .to_props()
+        .into_iter()
+        .find(|property| property.key_str() == "facing")
+        .and_then(|property| {
+            Direction::ALL
+                .into_iter()
+                .find(|dir| dir.name() == property.value_str())
+        })?;
+    let nominal_distance = Config::DEFAULT.max_distance(rpm);
+    let pushing = fan::pushing(rpm, facing);
+    let flow = facing
+        .vector()
+        .map(|component| component * if pushing { 1 } else { -1 });
+    let mut reach = nominal_distance;
+
+    for offset in 1..=nominal_distance.ceil() as i32 {
+        let vector = facing.vector();
+        let cell = BlockPos::new(
+            position.0.x.checked_add(vector[0].checked_mul(offset)?)?,
+            position.0.y.checked_add(vector[1].checked_mul(offset)?)?,
+            position.0.z.checked_add(vector[2].checked_mul(offset)?)?,
+        );
+        let Some(state) = state_at(cell) else {
+            // Do not force a chunk load just to extend the current.
+            reach = reach.min((offset - 1) as f32);
+            break;
+        };
+        let shapes = state
+            .to_state()
+            .get_block_collision_shapes_at(&cell)
+            .map(|shape| {
+                [
+                    shape.min.x,
+                    shape.min.y,
+                    shape.min.z,
+                    shape.max.x,
+                    shape.max.y,
+                    shape.max.z,
+                ]
+            })
+            .collect::<Vec<_>>();
+        let depth = fan::shape_depth(&shapes, facing);
+        if depth.is_finite() {
+            let obstruction = (offset - 1) as f32 + depth as f32;
+            reach = reach.min(obstruction);
+            if obstruction <= offset as f32 {
+                break;
+            }
+        }
+    }
+
+    (reach > 0.0).then_some(Airflow {
+        position,
+        facing,
+        flow,
+        rpm,
+        pushing,
+        nominal_distance,
+        reach,
+    })
+}
diff --git a/crates/pumpkin-core/src/block/entities/create_millstone.rs b/crates/pumpkin-core/src/block/entities/create_millstone.rs
new file mode 100644
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/create_millstone.rs
@@ -0,0 +1,502 @@
+use std::{
+    any::Any,
+    array::from_fn,
+    sync::{
+        Arc, Mutex, OnceLock, PoisonError, RwLock,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+use create_engine::milling::{Action, MillCycle, roll_count};
+use pumpkin_data::{item::Item, item_stack::ItemStack, tag::Taggable};
+use pumpkin_inventory::{Clearable, Inventory};
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::position::BlockPos;
+
+use super::{BlockEntity, create_kinetic::CreateKinetic};
+use crate::world::World;
+use rand::RngExt;
+use serde::Deserialize;
+
+pub(crate) const ID: &str = "create:millstone";
+const INPUT_SLOT: usize = 0;
+const OUTPUT_START: usize = 1;
+const PROCESSING_TIMER_KEY: &str = "Timer";
+
+pub struct CreateMillstoneBlockEntity {
+    pub position: BlockPos,
+    pub items: RwLock<[ItemStack; Self::INVENTORY_SIZE]>,
+    cycle: Mutex<MillCycle>,
+    kinetic: CreateKinetic,
+    dirty: AtomicBool,
+    opaque_items: Option<NbtCompound>,
+}
+
+impl BlockEntity for CreateMillstoneBlockEntity {
+    fn resource_location(&self) -> &'static str {
+        ID
+    }
+
+    fn get_position(&self) -> BlockPos {
+        self.position
+    }
+
+    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self {
+        let mut items = from_fn(|_| ItemStack::EMPTY.clone());
+        let opaque_items = (!read_items(nbt, &mut items)).then(|| {
+            let mut opaque = NbtCompound::new();
+            for name in ["Items", "InputInventory", "OutputInventory"] {
+                if let Some(tag) = nbt.get(name) {
+                    opaque.put(name, tag.clone());
+                }
+            }
+            opaque
+        });
+        let timer = nbt
+            .get_int(PROCESSING_TIMER_KEY)
+            .or_else(|| nbt.get_int("ProcessingTicks"))
+            .filter(|timer| (-512..=1_000_000).contains(timer))
+            .unwrap_or(0);
+        Self {
+            position,
+            items: RwLock::new(items),
+            cycle: Mutex::new(MillCycle { timer }),
+            kinetic: CreateKinetic::new(ID, position),
+            dirty: AtomicBool::new(false),
+            opaque_items,
+        }
+    }
+
+    fn write_nbt(&self, nbt: &mut NbtCompound) {
+        let cycle = self.cycle.lock().unwrap_or_else(PoisonError::into_inner);
+        let items = self.items.read().unwrap_or_else(PoisonError::into_inner);
+        nbt.child_tags.remove("Items");
+        if let Some(opaque_items) = &self.opaque_items {
+            nbt.child_tags.extend(opaque_items.child_tags.clone());
+        } else {
+            write_items(nbt, "InputInventory", &items[..OUTPUT_START]);
+            write_items(nbt, "OutputInventory", &items[OUTPUT_START..]);
+        }
+        nbt.put_int(PROCESSING_TIMER_KEY, cycle.timer);
+        self.kinetic.write_nbt(nbt);
+    }
+
+    fn tick(&self, world: &Arc<World>) {
+        if !self.is_supported() {
+            return;
+        }
+        let old_rpm = self.kinetic.rpm();
+        self.kinetic.tick(world);
+        let rpm = self.kinetic.rpm();
+        let mut cycle = self.cycle.lock().unwrap_or_else(PoisonError::into_inner);
+        let previous_timer = cycle.timer;
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let recipe = recipe_for(&items[INPUT_SLOT]);
+        let action = cycle.tick(
+            rpm,
+            items[OUTPUT_START..]
+                .iter()
+                .map(|stack| u32::from(stack.item_count)),
+            !items[INPUT_SLOT].is_empty(),
+            recipe.as_ref().map(|recipe| recipe.duration),
+        );
+        let processed = if action == Action::Process {
+            let mut random = rand::rng();
+            let done = process_items(&mut items, || random.random::<f32>());
+            if !done && recipe.is_some() {
+                cycle.timer = 1;
+            }
+            done
+        } else {
+            false
+        };
+        let changed = previous_timer != cycle.timer || processed || rpm != old_rpm;
+        drop(items);
+        drop(cycle);
+
+        if changed {
+            self.mark_dirty();
+            if let Some(entity) = world.get_block_entity(&self.position)
+                && entity
+                    .as_any()
+                    .downcast_ref::<Self>()
+                    .is_some_and(|live| std::ptr::eq(self, live))
+            {
+                world.update_block_entity(&entity);
+            }
+        }
+    }
+
+    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
+        let mut nbt = NbtCompound::new();
+        self.write_nbt(&mut nbt);
+        Some(nbt)
+    }
+
+    fn get_inventory(self: Arc<Self>) -> Option<Arc<dyn Inventory>> {
+        self.is_supported().then_some(self)
+    }
+
+    fn on_block_replaced(self: Arc<Self>, world: &Arc<World>, position: &BlockPos) {
+        if self.is_supported() {
+            let inventory: Arc<dyn Inventory> = self;
+            world.scatter_inventory(position, &inventory);
+        }
+    }
+
+    fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Relaxed)
+    }
+
+    fn clear_dirty(&self) {
+        self.dirty.store(false, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl CreateMillstoneBlockEntity {
+    pub const INVENTORY_SIZE: usize = 1 + create_engine::milling::OUTPUT_SLOTS;
+
+    #[must_use]
+    pub fn new(position: BlockPos) -> Self {
+        Self {
+            position,
+            items: RwLock::new(from_fn(|_| ItemStack::EMPTY.clone())),
+            cycle: Mutex::new(MillCycle::default()),
+            kinetic: CreateKinetic::new(ID, position),
+            dirty: AtomicBool::new(false),
+            opaque_items: None,
+        }
+    }
+
+    #[must_use]
+    pub fn is_supported(&self) -> bool {
+        self.opaque_items.is_none()
+    }
+
+    pub(crate) fn insert_stack(&self, incoming: &ItemStack) -> u8 {
+        if incoming.is_empty() || !self.is_supported() {
+            return 0;
+        }
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let input = &mut items[INPUT_SLOT];
+        let room = if input.is_empty() {
+            incoming.get_max_stack_size()
+        } else if input.are_items_and_components_equal(incoming) {
+            input.get_max_stack_size().saturating_sub(input.item_count)
+        } else {
+            return 0;
+        };
+        let inserted = incoming.item_count.min(room);
+        if inserted == 0 {
+            return 0;
+        }
+        if input.is_empty() {
+            *input = incoming.clone();
+            input.item_count = inserted;
+        } else {
+            input.item_count += inserted;
+        }
+        self.mark_dirty();
+        inserted
+    }
+
+    pub(crate) fn collect_items(&self) -> Vec<ItemStack> {
+        if !self.is_supported() {
+            return Vec::new();
+        }
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let mut collected = items[OUTPUT_START..]
+            .iter_mut()
+            .filter_map(|slot| {
+                (!slot.is_empty()).then(|| std::mem::replace(slot, ItemStack::EMPTY.clone()))
+            })
+            .collect::<Vec<_>>();
+        if collected.is_empty() && !items[INPUT_SLOT].is_empty() {
+            collected.push(std::mem::replace(
+                &mut items[INPUT_SLOT],
+                ItemStack::EMPTY.clone(),
+            ));
+        }
+        if !collected.is_empty() {
+            self.mark_dirty();
+        }
+        collected
+    }
+
+    fn mark_dirty(&self) {
+        self.dirty.store(true, Ordering::Relaxed);
+    }
+}
+
+#[cfg(test)]
+fn process(millstone: &CreateMillstoneBlockEntity) -> bool {
+    if !millstone.is_supported() {
+        return false;
+    }
+    let mut items = millstone
+        .items
+        .write()
+        .unwrap_or_else(PoisonError::into_inner);
+    let processed = process_items(&mut items, || 0.9);
+    if processed {
+        millstone.mark_dirty();
+    }
+    processed
+}
+
+fn process_items(
+    items: &mut [ItemStack; CreateMillstoneBlockEntity::INVENTORY_SIZE],
+    mut draw: impl FnMut() -> f32,
+) -> bool {
+    let Some(recipe) = recipe_for(&items[INPUT_SLOT]) else {
+        return false;
+    };
+    let outputs = &mut items[OUTPUT_START..];
+    // Reserve room for the maximum roll so a blocked output never rerolls odds or loses input.
+    let mut trial = outputs.to_vec();
+    if !add_outputs(&mut trial, recipe, |output| output.count) {
+        return false;
+    }
+    trial.clone_from_slice(outputs);
+    if !add_outputs(&mut trial, recipe, |output| {
+        roll_count(output.count.into(), output.chance, &mut draw) as u8
+    }) {
+        return false;
+    }
+    outputs.clone_from_slice(&trial);
+    let _ = items[INPUT_SLOT].split(1);
+    true
+}
+
+fn add_outputs(
+    slots: &mut [ItemStack],
+    recipe: &MillingRecipe,
+    mut count: impl FnMut(&Output) -> u8,
+) -> bool {
+    for output in &recipe.results {
+        let Some(item) = Item::from_registry_key(&output.id) else {
+            return false;
+        };
+        let mut stack = ItemStack::new(count(output), item);
+        for slot in slots.iter_mut() {
+            if stack.is_empty() {
+                break;
+            }
+            if slot.is_empty() {
+                *slot = stack.split(stack.item_count.min(stack.get_max_stack_size()));
+            } else if slot.are_items_and_components_equal(&stack) {
+                let added = stack
+                    .item_count
+                    .min(slot.get_max_stack_size().saturating_sub(slot.item_count));
+                slot.item_count += added;
+                stack.item_count -= added;
+            }
+        }
+        if !stack.is_empty() {
+            return false;
+        }
+    }
+    true
+}
+
+#[derive(Deserialize)]
+struct MillingRecipe {
+    ingredients: [String; 1],
+    #[serde(rename = "processing_time")]
+    duration: i32,
+    results: Vec<Output>,
+}
+
+#[derive(Deserialize)]
+struct Output {
+    id: String,
+    #[serde(default = "one")]
+    count: u8,
+    #[serde(default = "guaranteed")]
+    chance: f32,
+}
+
+const fn one() -> u8 {
+    1
+}
+const fn guaranteed() -> f32 {
+    1.0
+}
+
+fn recipes() -> &'static [MillingRecipe] {
+    static RECIPES: OnceLock<Vec<MillingRecipe>> = OnceLock::new();
+    RECIPES.get_or_init(|| {
+        serde_json::from_str(include_str!(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/../../assets/nextmc-create-milling.json"
+        )))
+        .unwrap_or_else(|error| {
+            tracing::error!(%error, "Could not read embedded Create milling recipes");
+            Vec::new()
+        })
+    })
+}
+
+fn recipe_for(input: &ItemStack) -> Option<&'static MillingRecipe> {
+    if input.is_empty() {
+        return None;
+    }
+    let item = input.get_item();
+    recipes()
+        .iter()
+        .find(|recipe| match recipe.ingredients[0].as_str() {
+            "#minecraft:wool" => item.has_tag(&pumpkin_data::tag::Item::MINECRAFT_WOOL),
+            id => Item::from_registry_key(id) == Some(item),
+        })
+}
+
+fn write_items(nbt: &mut NbtCompound, key: &str, items: &[ItemStack]) {
+    let mut inventory = NbtCompound::new();
+    inventory.put_int("Size", items.len() as i32);
+    let list = items
+        .iter()
+        .enumerate()
+        .filter(|(_, stack)| !stack.is_empty())
+        .map(|(slot, stack)| {
+            let mut tag = NbtCompound::new();
+            stack.write_item_stack(&mut tag);
+            tag.put_int("Slot", slot as i32);
+            NbtTag::Compound(tag)
+        })
+        .collect();
+    inventory.put("Items", NbtTag::List(list));
+    nbt.put_compound(key, inventory);
+}
+
+fn read_items(nbt: &NbtCompound, items: &mut [ItemStack]) -> bool {
+    fn read_slots(nbt: &NbtCompound, items: &mut [ItemStack]) -> Option<()> {
+        if let Some(tag) = nbt.get("Items") {
+            let NbtTag::List(list) = tag else { return None };
+            if list.len() > items.len() {
+                return None;
+            }
+            for entry in list {
+                let entry = entry.extract_compound()?;
+                let slot = entry
+                    .get_int("Slot")
+                    .or_else(|| entry.get_byte("Slot").map(i32::from))?;
+                let item = items.get_mut(usize::try_from(slot).ok()?)?;
+                if !item.is_empty() {
+                    return None;
+                }
+                *item = ItemStack::read_item_stack(entry)?;
+            }
+        }
+        Some(())
+    }
+    if nbt.get("Items").is_some() {
+        return read_slots(nbt, items).is_some();
+    }
+    let (input, output) = items.split_at_mut(OUTPUT_START);
+    [("InputInventory", input), ("OutputInventory", output)]
+        .into_iter()
+        .all(|(key, slots)| {
+            nbt.get(key).is_none()
+                || nbt.get_compound(key).is_some_and(|data| {
+                    data.get_int("Size") == Some(slots.len() as i32)
+                        && read_slots(data, slots).is_some()
+                })
+        })
+}
+
+#[cfg(test)]
+#[path = "create_millstone_tests.rs"]
+mod tests;
+
+impl Inventory for CreateMillstoneBlockEntity {
+    fn size(&self) -> usize {
+        Self::INVENTORY_SIZE
+    }
+
+    fn is_empty(&self) -> bool {
+        self.items
+            .read()
+            .unwrap_or_else(PoisonError::into_inner)
+            .iter()
+            .all(ItemStack::is_empty)
+    }
+
+    fn get_stack(&self, slot: usize) -> ItemStack {
+        self.items
+            .read()
+            .unwrap_or_else(PoisonError::into_inner)
+            .get(slot)
+            .cloned()
+            .unwrap_or_else(|| ItemStack::EMPTY.clone())
+    }
+
+    fn remove_stack(&self, slot: usize) -> ItemStack {
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let Some(stack) = items.get_mut(slot) else {
+            return ItemStack::EMPTY.clone();
+        };
+        let removed = std::mem::replace(stack, ItemStack::EMPTY.clone());
+        self.mark_dirty();
+        removed
+    }
+
+    fn remove_stack_specific(&self, slot: usize, amount: u8) -> ItemStack {
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        let Some(stack) = items.get_mut(slot) else {
+            return ItemStack::EMPTY.clone();
+        };
+        if stack.is_empty() || amount == 0 {
+            return ItemStack::EMPTY.clone();
+        }
+        let removed = stack.split(amount);
+        self.mark_dirty();
+        removed
+    }
+
+    fn set_stack(&self, slot: usize, stack: ItemStack) {
+        let mut items = self.items.write().unwrap_or_else(PoisonError::into_inner);
+        if let Some(target) = items.get_mut(slot) {
+            *target = stack;
+            self.mark_dirty();
+        }
+    }
+
+    fn get_max_count_per_stack(&self) -> u8 {
+        create_engine::milling::SLOT_LIMIT as u8
+    }
+
+    fn is_valid_slot_for(&self, slot: usize, _stack: &ItemStack) -> bool {
+        self.is_supported() && slot == INPUT_SLOT
+    }
+
+    fn can_transfer_to(
+        &self,
+        _hopper_inventory: &dyn Inventory,
+        slot: usize,
+        _stack: &ItemStack,
+    ) -> bool {
+        self.is_supported() && slot >= OUTPUT_START && slot < Self::INVENTORY_SIZE
+    }
+
+    fn mark_dirty(&self) {
+        CreateMillstoneBlockEntity::mark_dirty(self);
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+impl Clearable for CreateMillstoneBlockEntity {
+    fn clear(&self) {
+        self.items
+            .write()
+            .unwrap_or_else(PoisonError::into_inner)
+            .fill_with(|| ItemStack::EMPTY.clone());
+        self.mark_dirty();
+    }
+}
