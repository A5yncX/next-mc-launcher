+#[test]
+fn normal_chute_pulls_sixteen_and_retries_partial_output_without_loss() {
+    assert_eq!(
+        CreateChuteBlockEntity::new_smart(BlockPos::new(0, 0, 0)).resource_location(),
+        CreateChuteBlockEntity::SMART_ID
+    );
+    let source = inventory_with(&[(0, ItemStack::new(40, &Item::STONE))]);
+    let target = SimpleInventory::new(1);
+    target.set_stack(0, ItemStack::new(60, &Item::STONE));
+    let chute = CreateChuteBlockEntity::new(BlockPos::new(0, 0, 0));
+
+    let (pulled, spill) = chute.pull_from(&source, false);
+    assert!(pulled);
+    assert!(spill.is_empty());
+    assert_eq!(source.get_stack(0).item_count, 24);
+    assert_eq!(chute.get_stack(0).item_count, 16);
+
+    let (pushed, spill) = chute.push_to(&target);
+    assert!(pushed);
+    assert!(spill.is_empty());
+    assert_eq!(target.get_stack(0).item_count, 64);
+    assert_eq!(chute.get_stack(0).item_count, 12);
+    assert_eq!(total(&[&source, &chute, &target]), 100);
+}
+
+#[test]
+fn smart_chute_uses_filter_count_and_stops_while_powered() {
+    let mut filter = NbtCompound::new();
+    ItemStack::new(1, &Item::DIAMOND).write_item_stack(&mut filter);
+    let mut nbt = NbtCompound::new();
+    nbt.put_string("id", CreateChuteBlockEntity::SMART_ID.to_owned());
+    nbt.put_compound("Filter", filter);
+    nbt.put_int("FilterAmount", 3);
+    nbt.put_bool("UpTo", false);
+    let chute = CreateChuteBlockEntity::from_nbt(&nbt, BlockPos::new(0, 0, 0));
+    let source = inventory_with(&[
+        (0, ItemStack::new(8, &Item::STONE)),
+        (1, ItemStack::new(5, &Item::DIAMOND)),
+    ]);
+
+    assert!(!chute.pull_from(&source, true).0);
+    assert_eq!(total(&[&source, &chute]), 13);
+    assert!(chute.pull_from(&source, false).0);
+    assert_eq!(source.get_stack(0).item_count, 8);
+    assert_eq!(source.get_stack(1).item_count, 2);
+    assert_eq!(chute.get_stack(0).item_count, 3);
+    assert_eq!(total(&[&source, &chute]), 13);
+
+    let target = SimpleInventory::new(1);
+    assert!(!chute.pull_from(&source, true).0);
+    assert!(!chute.push_to(&target).0);
+    assert_eq!(chute.get_stack(0).item_count, 3);
+    assert!(!chute.pull_from(&source, false).0);
+    assert!(chute.push_to(&target).0);
+    assert_eq!(target.get_stack(0).item_count, 3);
+    assert_eq!(total(&[&source, &chute, &target]), 13);
+}
