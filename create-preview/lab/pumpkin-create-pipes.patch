--- /dev/null
+++ b/crates/pumpkin-core/src/block/blocks/create_pipe.rs
@@ -0,0 +1,213 @@
+use std::collections::{HashSet, VecDeque};
+
+use create_engine::{
+    fluid_transport,
+    kinetics::Axis,
+    placement::{self, Direction},
+};
+use pumpkin_data::{BlockStateId, block_properties::Property};
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::math::position::BlockPos;
+
+use super::create_pump;
+use crate::{
+    block::{
+        BlockBehaviour, GetStateForNeighborUpdateArgs, entities::create_fluid_tank,
+        registry::BlockRegistry,
+    },
+    world::World,
+};
+
+pub(crate) const PIPE: &str = "create:fluid_pipe";
+pub(crate) const VALVE: &str = "create:fluid_valve";
+
+pub(crate) fn property(state: BlockStateId, key: &str) -> Option<&'static str> {
+    state
+        .to_block()
+        .properties(state)?
+        .to_props()
+        .iter()
+        .find(|p| p.key_str() == key)
+        .map(|p| p.value_str())
+}
+
+pub(crate) fn with_property(state: BlockStateId, key: &str, value: &str) -> BlockStateId {
+    let block = state.to_block();
+    let (Some(mut props), Some(new)) = (
+        block.properties(state).map(|p| p.to_props()),
+        Property::from_str_pair(key, value),
+    ) else {
+        return state;
+    };
+    if let Some(existing) = props.iter_mut().find(|p| p.key_str() == key) {
+        *existing = new;
+    }
+    block.from_properties(&props).to_state_id(block)
+}
+
+pub(crate) fn connects(state: BlockStateId, face: Direction) -> bool {
+    match state.to_block().name {
+        PIPE | create_fluid_tank::ID => true,
+        VALVE => valve_axis(state, false) == Some(face.axis()),
+        create_pump::ID => create_pump::front(state).is_some_and(|d| d.axis() == face.axis()),
+        _ => false,
+    }
+}
+
+pub(crate) fn valve_axis(state: BlockStateId, shaft: bool) -> Option<Axis> {
+    Some(placement::gauge_axis(
+        create_pump::front(state)?,
+        (property(state, "axis_along_first")? == "true") == shaft,
+    ))
+}
+
+pub(crate) fn valve_placement(
+    world: &World,
+    pos: BlockPos,
+    state: BlockStateId,
+    facing: Direction,
+    horizontal: Direction,
+    ports: [bool; 6],
+) -> BlockStateId {
+    let pipe = |side: Direction| {
+        world
+            .get_block_state_id_if_loaded(&create_pump::relative(pos, side))
+            .is_some_and(|state| connects(state, side.opposite()))
+    };
+    let shaft = |side: Direction| ports[side as usize];
+    let first = match facing.axis() {
+        axis @ (Axis::X | Axis::Z) => {
+            let side = if axis == Axis::X {
+                Direction::South
+            } else {
+                Direction::East
+            };
+            (axis == Axis::X)
+                == (shaft(Direction::Up)
+                    || shaft(Direction::Down)
+                    || pipe(side)
+                    || pipe(side.opposite()))
+        }
+        Axis::Y => {
+            let prefer = |side: Direction| shaft(side) || pipe(side.clockwise(Axis::Y));
+            let x = prefer(Direction::East) || prefer(Direction::West);
+            let z = prefer(Direction::North) || prefer(Direction::South);
+            if x != z {
+                x
+            } else {
+                horizontal.axis() == Axis::X
+            }
+        }
+    };
+    with_property(
+        with_property(state, "facing", facing.name()),
+        "axis_along_first",
+        boolean(first),
+    )
+}
+
+pub(crate) fn boolean(value: bool) -> &'static str {
+    if value { "true" } else { "false" }
+}
+
+pub(crate) fn shape(
+    world: &World,
+    pos: BlockPos,
+    mut state: BlockStateId,
+    preferred: Direction,
+    changed: Option<(Direction, BlockStateId)>,
+) -> BlockStateId {
+    let joined = Direction::ALL.map(|side| {
+        let adjacent = changed
+            .filter(|(dir, _)| *dir == side)
+            .map(|(_, id)| id)
+            .or_else(|| world.get_block_state_id_if_loaded(&create_pump::relative(pos, side)));
+        adjacent.map_or_else(
+            || property(state, side.name()) == Some("true"),
+            |id| connects(id, side.opposite()),
+        )
+    });
+    if changed.is_some()
+        && !joined.contains(&true)
+        && Direction::ALL
+            .iter()
+            .filter(|side| property(state, side.name()) == Some("true"))
+            .count()
+            == 2
+    {
+        return state;
+    }
+    for (side, open) in Direction::ALL
+        .into_iter()
+        .zip(fluid_transport::placed_ports(joined, preferred))
+    {
+        state = with_property(state, side.name(), boolean(open));
+    }
+    state
+}
+
+fn open(state: BlockStateId, face: Direction) -> bool {
+    match state.to_block().name {
+        PIPE => property(state, face.name()) == Some("true"),
+        VALVE => property(state, "enabled") == Some("true") && connects(state, face),
+        _ => false,
+    }
+}
+
+pub(crate) fn endpoints(
+    world: &World,
+    pump: BlockPos,
+    start: Direction,
+) -> Option<(Vec<BlockPos>, HashSet<BlockPos>)> {
+    let mut visited = HashSet::new();
+    let mut ends = Vec::new();
+    let mut queue = VecDeque::from([(create_pump::relative(pump, start), start.opposite(), 1)]);
+    while let Some((pos, inlet, distance)) = queue.pop_front() {
+        if pos == pump || visited.contains(&pos) {
+            continue;
+        }
+        let Some(state) = world.get_block_state_id_if_loaded(&pos) else {
+            continue;
+        };
+        if state.to_block().name == create_fluid_tank::ID {
+            visited.insert(pos);
+            ends.push(pos);
+        } else if open(state, inlet) {
+            visited.insert(pos);
+            if distance < fluid_transport::DEFAULT_PUMP_RANGE {
+                for side in Direction::ALL {
+                    if side != inlet && open(state, side) {
+                        queue.push_back((
+                            create_pump::relative(pos, side),
+                            side.opposite(),
+                            distance + 1,
+                        ));
+                    }
+                }
+            }
+        }
+        // shortcut: bound per-pump tick work; use a cached network when supporting large graphs.
+        if visited.len() > 128 {
+            return None;
+        }
+    }
+    Some((ends, visited))
+}
+
+#[pumpkin_block("create:fluid_pipe")]
+pub struct FluidPipe;
+impl BlockBehaviour for FluidPipe {
+    fn get_state_for_neighbor_update(
+        &self,
+        args: GetStateForNeighborUpdateArgs<'_>,
+    ) -> BlockStateId {
+        let side = BlockRegistry::create_direction(args.direction);
+        shape(
+            args.world,
+            *args.position,
+            args.state_id,
+            side,
+            Some((side, args.neighbor_state_id)),
+        )
+    }
+}
