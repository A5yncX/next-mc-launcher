+use std::sync::Arc;
+
+use create_engine::{kinetics::Axis, placement::Direction, waterwheel};
+use pumpkin_data::{
+    Block, BlockDirection, BlockState, BlockStateId, HorizontalFacingExt,
+    block_properties::Property, item::Item, item_stack::ItemStack, tag,
+};
+use pumpkin_macros::pumpkin_block;
+use pumpkin_util::math::{position::BlockPos, vector3::Vector3};
+use pumpkin_world::world::BlockFlags;
+
+use crate::{
+    block::{
+        BlockBehaviour, OnStateReplacedArgs, UseWithItemArgs, entities, registry::BlockActionResult,
+    },
+    world::World,
+};
+
+pub(crate) const SMALL: &str = "create:water_wheel";
+pub(crate) const LARGE: &str = "create:large_water_wheel";
+const STRUCTURE: &str = "create:water_wheel_structure";
+const STRUCTURE_FLAGS: BlockFlags =
+    BlockFlags::NOTIFY_LISTENERS.union(BlockFlags::NOTIFY_NEIGHBORS);
+
+#[pumpkin_block("create:large_water_wheel")]
+pub struct CreateLargeWaterWheel;
+
+impl BlockBehaviour for CreateLargeWaterWheel {
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        CreateWaterWheel.use_with_item(args)
+    }
+
+    fn on_state_replaced(&self, args: OnStateReplacedArgs<'_>) {
+        let [x, y, z] = coords(*args.position);
+        let Some(node) = entities::create_kinetic_node(args.old_state_id, [x, y, z]) else {
+            return;
+        };
+        for (pos, expected) in structure(*args.position, node.axis) {
+            args.world.set_block_state_if(
+                &pos,
+                Block::AIR.default_state.id,
+                STRUCTURE_FLAGS,
+                |id| id == expected,
+            );
+        }
+    }
+}
+
+fn coords(p: BlockPos) -> [i32; 3] {
+    [p.0.x, p.0.y, p.0.z]
+}
+
+fn offset(p: BlockPos, [x, y, z]: [i32; 3]) -> BlockPos {
+    BlockPos::new(p.0.x + x, p.0.y + y, p.0.z + z)
+}
+
+fn structure(center: BlockPos, axis: Axis) -> impl Iterator<Item = (BlockPos, BlockStateId)> {
+    let block = Block::from_name(STRUCTURE).expect("pinned wheel structure block");
+    let place = move |pos, facing: Direction| {
+        let property =
+            Property::from_str_pair("facing", facing.name()).expect("pinned wheel facing");
+        (pos, block.from_properties(&[property]).to_state_id(block))
+    };
+    Direction::ALL
+        .into_iter()
+        .filter(move |direction| direction.axis() != axis)
+        .flat_map(move |direction| {
+            let neighbor = offset(center, direction.vector());
+            let clockwise = direction.clockwise(axis);
+            [
+                place(neighbor, direction.opposite()),
+                place(offset(neighbor, clockwise.vector()), clockwise.opposite()),
+            ]
+        })
+}
+
+pub(crate) fn valid_large_placement(world: &World, center: BlockPos, axis: Axis) -> bool {
+    waterwheel::structure(axis)
+        .into_iter()
+        .map(|delta| offset(center, delta))
+        .all(|pos| {
+            world.is_in_build_limit(pos)
+                && world
+                    .get_block_state_id_if_loaded(&pos)
+                    .is_some_and(|id| BlockState::from_id(id).replaceable())
+        })
+}
+
+pub(crate) fn update_large(
+    world: &Arc<World>,
+    pos: BlockPos,
+    state: BlockStateId,
+    axis: Axis,
+    ready: bool,
+) -> bool {
+    let Some(parts) = structure(pos, axis)
+        .map(|(p, state)| {
+            world
+                .get_block_state_id_if_loaded(&p)
+                .map(|old| (p, state, old))
+        })
+        .collect::<Option<Vec<_>>>()
+    else {
+        return false;
+    };
+    let mut placed = Vec::new();
+    for (p, expected, old) in parts {
+        if old == expected {
+            continue;
+        }
+        if !ready
+            && BlockState::from_id(old).replaceable()
+            && world
+                .set_block_state_if(&p, expected, STRUCTURE_FLAGS, |found| found == old)
+                .is_some()
+        {
+            placed.push((p, expected, old));
+            continue;
+        }
+        for (p, expected, old) in placed {
+            world.set_block_state_if(&p, old, STRUCTURE_FLAGS, |found| found == expected);
+        }
+        if world
+            .set_block_state_if(
+                &pos,
+                Block::AIR.default_state.id,
+                STRUCTURE_FLAGS,
+                |found| found == state,
+            )
+            .is_some()
+            && ready
+        {
+            world.drop_stack(
+                &pos,
+                ItemStack::new(
+                    1,
+                    Item::from_registry_key(LARGE).expect("pinned wheel item"),
+                ),
+            );
+        }
+        return false;
+    }
+    let mut delta = [0; 3];
+    delta[axis.index()] = -1;
+    let extension = world
+        .get_block_state_id_if_loaded(&offset(pos, delta))
+        .is_some_and(|id| Block::from_state_id(id).name == LARGE);
+    let block = Block::from_state_id(state);
+    if let Some(mut props) = block.properties(state).map(|p| p.to_props())
+        && let Some(prop) = props.iter_mut().find(|p| p.key_str() == "extension")
+        && (prop.value_str() == "true") != extension
+    {
+        *prop = Property::from_str_pair("extension", if extension { "true" } else { "false" })
+            .expect("pinned wheel extension");
+        let next = block.from_properties(&props).to_state_id(block);
+        world.set_block_state_if(&pos, next, STRUCTURE_FLAGS, |found| found == state);
+    }
+    if world
+        .get_block_state_id_if_loaded(&pos)
+        .is_some_and(|id| Block::from_state_id(id).name == LARGE)
+    {
+        return true;
+    }
+    for (p, expected, old) in placed {
+        world.set_block_state_if(&p, old, STRUCTURE_FLAGS, |found| found == expected);
+    }
+    false
+}
+
+#[pumpkin_block("create:water_wheel")]
+pub struct CreateWaterWheel;
+
+impl BlockBehaviour for CreateWaterWheel {
+    fn use_with_item(&self, args: UseWithItemArgs<'_>) -> BlockActionResult {
+        let item = args.item_stack.item;
+        if !is_wheel_material(item) {
+            return BlockActionResult::PassToDefaultBlockAction;
+        }
+        if entities::set_create_wheel_material(args.world, args.position, item) {
+            BlockActionResult::Consume
+        } else {
+            BlockActionResult::PassToDefaultBlockAction
+        }
+    }
+}
+
+pub(crate) fn is_wheel_material(item: &Item) -> bool {
+    matches!(
+        item.registry_key.strip_suffix("_planks"),
+        Some(
+            "oak"
+                | "spruce"
+                | "birch"
+                | "jungle"
+                | "acacia"
+                | "dark_oak"
+                | "mangrove"
+                | "cherry"
+                | "bamboo"
+                | "crimson"
+                | "warped"
+                | "pale_oak"
+        )
+    )
+}
+
+pub(crate) fn valid_small_placement(world: &World, pos: BlockPos, axis: Axis) -> bool {
+    Direction::ALL.into_iter().all(|direction| {
+        let [x, y, z] = direction.vector();
+        let p = BlockPos::new(pos.0.x + x, pos.0.y + y, pos.0.z + z);
+        world.get_block_state_id_if_loaded(&p).is_some_and(|state| {
+            Block::from_state_id(state).name != SMALL
+                || (direction.axis() == axis
+                    && entities::create_kinetic_node(state, [p.0.x, p.0.y, p.0.z])
+                        .is_some_and(|node| node.axis == axis))
+        })
+    })
+}
+
+pub(crate) fn score(world: &World, pos: BlockPos, axis: Axis, large: bool) -> Option<i32> {
+    let mut loaded = true;
+    let score = waterwheel::flow_score(axis, large, |delta| {
+        let pos = offset(pos, delta);
+        flow(world, pos).unwrap_or_else(|| {
+            loaded = false;
+            [0.0; 3]
+        })
+    });
+    loaded.then_some(score)
+}
+
+fn flow(world: &World, pos: BlockPos) -> Option<[f64; 3]> {
+    let state = world.get_block_state_id_if_loaded(&pos)?;
+    let block = Block::from_state_id(state);
+    if block == &Block::BUBBLE_COLUMN {
+        let drag = block
+            .properties(state)?
+            .to_props()
+            .iter()
+            .any(|p| p.key_str() == "drag" && p.value_str() == "true");
+        return Some([0.0, if drag { -1.0 } else { 1.0 }, 0.0]);
+    }
+    let (fluid, state) = World::fluid_state_from_block_state(state);
+    if state.height == 0.0 {
+        return Some([0.0; 3]);
+    }
+    let mut flow = Vector3::<f64>::default();
+    for dir in BlockDirection::horizontal() {
+        let offset = dir.to_offset();
+        let p = pos.offset(offset);
+        let id = world.get_block_state_id_if_loaded(&p)?;
+        let (other, neighbor) = World::fluid_state_from_block_state(id);
+        let mut difference = 0.0;
+        if neighbor.height > 0.0 {
+            if other.matches_type(fluid) {
+                difference = state.height - neighbor.height;
+            }
+        } else if !id
+            .to_block_id()
+            .has_tag(tag::Block::MINECRAFT_BLOCKS_FLUID_FLOW)
+        {
+            let (below_fluid, below) =
+                World::fluid_state_from_block_state(world.get_block_state_id_if_loaded(&p.down())?);
+            if below_fluid.matches_type(fluid) && below.height > 0.0 {
+                difference = state.height - (below.height - 0.888_888_9);
+            }
+        }
+        flow.x += f64::from(offset.x as f32 * difference);
+        flow.z += f64::from(offset.z as f32 * difference);
+    }
+    if state.falling {
+        let face = |p, direction| {
+            let id = world.get_block_state_id_if_loaded(&p)?;
+            let (other, _) = World::fluid_state_from_block_state(id);
+            let block = Block::from_state_id(id);
+            Some(
+                !other.matches_type(fluid)
+                    && block != &Block::ICE
+                    && block != &Block::FROSTED_ICE
+                    && id.is_side_solid(direction),
+            )
+        };
+        for dir in BlockDirection::horizontal() {
+            let p = pos.offset(dir.to_offset());
+            let direction = dir.to_block_direction();
+            if face(p, direction)? || face(p.up(), direction)? {
+                flow = normalized(flow);
+                flow.y = -6.0;
+                break;
+            }
+        }
+    }
+    let flow = normalized(flow);
+    Some([flow.x, flow.y, flow.z])
+}
+
+fn normalized(value: Vector3<f64>) -> Vector3<f64> {
+    if value.length_squared() == 0.0 {
+        value
+    } else {
+        value.normalize()
+    }
+}
