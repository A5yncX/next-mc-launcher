diff --git a/crates/horizon-client/src/horizon_look.rs b/crates/horizon-client/src/horizon_look.rs
index b78dda6..8734c31 100644
--- a/crates/horizon-client/src/horizon_look.rs
+++ b/crates/horizon-client/src/horizon_look.rs
@@ -7,6 +7,39 @@ use horizon_client::menu_style::{
     Fonts, MenuStyle, OverlayColours, SettingsColours, Sizes, Surfaces,
 };
 use horizon_theme as theme;
+use std::io::Read;
+use std::sync::OnceLock;
+
+pub(crate) const WINDOW_TITLE: &str = match option_env!("NEXT_MC_WINDOW_TITLE") {
+    Some(title) => title,
+    None => "Horizon",
+};
+
+fn local_icon() -> Option<Vec<u8>> {
+    const ICON_26_3: &str = "assets/objects/af/af96f55a90eaf11b327f1b5f8834a051027dc506";
+    let read = |path: std::path::PathBuf| {
+        let file = std::fs::File::open(path).ok()?;
+        let mut png = Vec::new();
+        file.take(64 * 1024).read_to_end(&mut png).ok()?;
+        horizon_client::window::decode_icon(&png)?;
+        Some(png)
+    };
+    option_env!("NEXT_MC_WINDOW_ICON_FILE")
+        .and_then(|path| read(path.into()))
+        .or_else(|| {
+            option_env!("NEXT_MC_WINDOW_TITLE")?;
+            [
+                ("LOCALAPPDATA", "NextMC/minecraft"),
+                ("APPDATA", ".minecraft"),
+                ("APPDATA", "horizon-launcher/minecraft"),
+            ]
+            .into_iter()
+            .find_map(|(key, dir)| {
+                let root = std::env::var_os(key).filter(|p| !p.is_empty())?;
+                read(std::path::PathBuf::from(root).join(dir).join(ICON_26_3))
+            })
+        })
+}
 
